+                settings.cvm_azure_jwks.as_ref(),
+                settings.cvm_azure_simulate,
+            )
+            .map_err(|reason| ConfigError::Invalid { reason })?;
+            settings.cvm_verifier = Some(verifier);
+        }
+        None if settings.cvm_require_certificate => {
+            return Err(ConfigError::Invalid {
+                reason: "cvm_require_certificate needs cvm_manifest".to_string(),
+            }
