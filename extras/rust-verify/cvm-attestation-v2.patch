new file mode 100644
index 0000000..9406093
--- /dev/null
+++ b/harmonia-cactee-verify/tests/verify.rs
@@ -0,0 +1,223 @@
+// nixtee (Othmane Tabiane): tests for the CACTEE certificate verifier.
+use data_encoding::{BASE64, BASE64URL_NOPAD, HEXLOWER};
+use harmonia_cactee_verify::{
+    Azure, Manifest, check_output, jwt, sha256_hex, verify_certificate, verify_for_nar,
+};
+use rsa::pkcs8::{EncodePublicKey, LineEnding};
+use rsa::traits::PublicKeyParts;
+use rsa::{Pkcs1v15Sign, RsaPrivateKey};
+use serde_json::{Value, json};
+use sha2_10::{Digest, Sha256};
+
+fn manifest() -> Manifest {
+    Manifest::from_json(include_str!("data/cactee-manifest.json")).unwrap()
+}
+
+/// Nokia's real sample certificate (Azure SGX quote, Python RSA-PSS signature).
+fn sample() -> Value {
+    serde_json::from_str(include_str!("data/sample-certificate.json")).unwrap()
+}
+
+#[test]
+fn real_sample_certificate_passes_steps_01_to_03() {
+    let r = verify_certificate(&sample(), &manifest(), Azure::Simulated);
+    assert!(r.ok(), "{}", r.failures());
+    assert_eq!(
+        r.summary(),
+        "01_duet_admin_quote=ok 02_controller_signature=ok 03_duet_service_info=ok"
+    );
+}
+
+#[test]
+fn changing_any_signed_field_breaks_the_signature() {
+    let mut c = sample();
+    c["duet_service_result"]["service_result"]["timestamp"] = json!(1774289173.8759155);
+    let r = verify_certificate(&c, &manifest(), Azure::Simulated);
+    assert!(!r.ok());
+    assert_eq!(r.steps[1].name, "02_controller_signature");
+    assert!(!r.steps[1].ok);
+}
+
+#[test]
+fn other_enclave_is_refused() {
+    let mut m = manifest();
+    m.mrenclave = "11".repeat(32);
+    let r = verify_certificate(&sample(), &m, Azure::Simulated);
+    assert!(!r.steps[0].ok);
+    assert!(r.failures().contains("mrenclave"));
+}
+
+#[test]
+fn other_service_code_is_refused() {
+    let mut m = manifest();
+    m.service_info.service_code_hash = "00".repeat(32);
+    let r = verify_certificate(&sample(), &m, Azure::Simulated);
+    assert!(!r.steps[2].ok);
+    assert!(r.failures().contains("service_code_hash"));
+}
+
+#[test]
+fn swapped_public_key_is_refused_by_the_quote() {
+    // Attacker re-signs with its own key: step 02 passes, step 01 must not.
+    let mut c = sample();
+    let mut rng = rand::thread_rng();
+    let key = RsaPrivateKey::new(&mut rng, 2048).unwrap();
+    let pem = key
+        .to_public_key()
+        .to_public_key_pem(LineEnding::LF)
+        .unwrap();
+    let msg = harmonia_cactee_verify::canonical::python_dumps_sorted(&c["duet_service_result"]);
+    let sig = key
+        .sign_with_rng(
+            &mut rng,
+            rsa::Pss::new_with_salt::<Sha256>(256 - 34),
+            &Sha256::digest(msg.as_bytes()),
+        )
+        .unwrap();
+    c["duet_admin_quote"]["public_key"] = json!(pem);
+    c["duet_admin_signature"] = json!(BASE64.encode(&sig));
+    let r = verify_certificate(&c, &manifest(), Azure::Simulated);
+    assert!(r.steps[1].ok, "attacker's own signature is valid");
+    assert!(!r.steps[0].ok, "but the quote does not bind that key");
+    assert!(r.failures().contains("report_data"));
+}
+
+fn with_nar_output(nar_name: &str, nar: &[u8]) -> Value {
+    let mut c = sample();
+    c["duet_service_result"]["service_result"]["hashes"]["outputs"] =
+        json!({ nar_name: sha256_hex(nar) });
+    c
+}
+
+#[test]
+fn output_hash_binds_the_nar() {
+    let name = "pb9q1wnzlzzvlcy5g2p10v66czpmz72f-gnu-config-2024-01-01.nar";
+    let c = with_nar_output(name, b"the nar");
+    assert!(check_output(&c, name, &Sha256::digest(b"the nar")).ok);
+    assert!(!check_output(&c, name, &Sha256::digest(b"another nar")).ok);
+    let other = "abijl898gbkzqwxyc73z1pmnpl3kjx5z-other.nar";
+    assert!(!check_output(&c, other, &Sha256::digest(b"the nar")).ok);
+    // signature no longer matches since outputs changed, so the full check fails
+    assert!(
+        !verify_for_nar(
+            &c,
+            &manifest(),
+            Azure::Simulated,
+            name,
+            &Sha256::digest(b"the nar")
+        )
+        .ok()
+    );
+}
+
+// ---- Azure attestation token, against a local stand-in for Azure's keys
+
+const EP: &str = "https://sharedneu.neu.attest.azure.net";
+
+struct FakeAzure {
+    key: RsaPrivateKey,
+}
+
+impl FakeAzure {
+    fn new() -> Self {
+        FakeAzure {
+            key: RsaPrivateKey::new(&mut rand::thread_rng(), 2048).unwrap(),
+        }
+    }
+    fn jwks(&self) -> Value {
+        let k = self.key.to_public_key();
+        json!({"keys": [{"kty": "RSA", "kid": "k1",
+            "n": BASE64URL_NOPAD.encode(&k.n().to_bytes_be()),
+            "e": BASE64URL_NOPAD.encode(&k.e().to_bytes_be())}]})
+    }
+    fn token(&self, claims: &Value) -> String {
+        let h = BASE64URL_NOPAD.encode(br#"{"alg":"RS256","kid":"k1"}"#);
+        let p = BASE64URL_NOPAD.encode(claims.to_string().as_bytes());
+        let input = format!("{h}.{p}");
+        let sig = self
+            .key
+            .sign(
+                Pkcs1v15Sign::new::<Sha256>(),
+                &Sha256::digest(input.as_bytes()),
+            )
+            .unwrap();
+        format!("{input}.{}", BASE64URL_NOPAD.encode(&sig))
+    }
+}
+
+fn good_claims(c: &Value) -> Value {
+    let quote = BASE64
+        .decode(c["duet_admin_quote"]["quote"].as_str().unwrap().as_bytes())
+        .unwrap();
+    json!({
+        "iss": EP,
+        "sgx-mrenclave": HEXLOWER.encode(&quote[112..144]),
+        "x-ms-sgx-report-data": format!("{}{}", HEXLOWER.encode(&quote[368..400]), "00".repeat(32)),
+        "x-ms-sgx-collateral": {"quotehash": sha256_hex(&quote)},
+    })
+}
+
+#[test]
+fn azure_token_valid_and_tampered() {
+    let az = FakeAzure::new();
+    let jwks = az.jwks();
+    let mut c = sample();
+    let claims = good_claims(&c);
+
+    c["duet_admin_quote"]["jwt"] = json!(az.token(&claims));
+    let r = verify_certificate(&c, &manifest(), Azure::Jwks(&jwks));
+    assert!(r.ok(), "{}", r.failures());
+
+    let mut bad = claims.clone();
+    bad["sgx-mrenclave"] = json!("33".repeat(32));
+    c["duet_admin_quote"]["jwt"] = json!(az.token(&bad));
+    assert!(
+        verify_certificate(&c, &manifest(), Azure::Jwks(&jwks))
+            .failures()
+            .contains("token mrenclave")
+    );
+
+    let mut bad = claims.clone();
+    bad["x-ms-sgx-collateral"]["quotehash"] = json!("44".repeat(32));
+    c["duet_admin_quote"]["jwt"] = json!(az.token(&bad));
+    assert!(
+        verify_certificate(&c, &manifest(), Azure::Jwks(&jwks))
+            .failures()
+            .contains("quote hash")
+    );
+
+    let mut bad = claims.clone();
+    bad["iss"] = json!("https://evil.attest.azure.net");
+    c["duet_admin_quote"]["jwt"] = json!(az.token(&bad));
+    assert!(
+        verify_certificate(&c, &manifest(), Azure::Jwks(&jwks))
+            .failures()
+            .contains("issuer")
+    );
+
+    // signed by someone else
+    let other = FakeAzure::new();
+    c["duet_admin_quote"]["jwt"] = json!(other.token(&claims));
+    assert!(
+        verify_certificate(&c, &manifest(), Azure::Jwks(&jwks))
+            .failures()
+            .contains("signature does not match")
+    );
+
+    // real mode without a token
+    c["duet_admin_quote"].as_object_mut().unwrap().remove("jwt");
+    assert!(
+        verify_certificate(&c, &manifest(), Azure::Jwks(&jwks))
+            .failures()
+            .contains("missing")
+    );
+}
+
+#[test]
+fn attestation_url_must_be_azure() {
+    assert!(jwt::azure_endpoint("https://sharedneu.neu.attest.azure.net").is_ok());
+    assert!(jwt::azure_endpoint("https://evil.example.com").is_err());
+    assert!(jwt::azure_endpoint("http://x.attest.azure.net").is_err());
+    assert!(jwt::azure_endpoint("https://x.attest.azure.net/certs").is_err());
+    assert!(jwt::azure_endpoint("https://user@x.attest.azure.net").is_err());
+}
