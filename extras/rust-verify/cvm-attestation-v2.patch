new file mode 100644
index 0000000..428bcb2
--- /dev/null
+++ b/harmonia-cache/src/cvm.rs
@@ -0,0 +1,142 @@
+// nixtee (Othmane Tabiane): new file, not part of upstream Harmonia.
+//! Serve only certified paths: verify the CACTEE certificate of a store path
+//! before its narinfo goes out.
+//!
+//! The certificate is `<cvm_attestation_dir>/<hashPart>.json`, written by the
+//! import API. It is checked with `harmonia-cactee-verify`:
+//!
+//! - steps 01–03 on the certificate itself (SGX quote, Azure token,
+//!   controller signature, service info against the manifest);
+//! - step 05 against the narHash in the cache database: that is the sha256
+//!   of the NAR this server will stream, so the certificate is bound to the
+//!   exact bytes served.
+//!
+//! The Cvm* narinfo lines are then built from verified data only.
+//! Results are cached per hash part until the certificate file changes.
+
+use harmonia_cactee_verify::{Azure, Manifest, verify_for_nar};
+use harmonia_store_path_info::CvmAttestation;
+use serde_json::Value;
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+use std::time::SystemTime;
+
+/// Certificate file (mtime, size) and the verification result for it.
+type Cached = (SystemTime, u64, Result<CvmAttestation, String>);
+
+pub(crate) struct CvmVerifier {
+    manifest: Manifest,
+    /// Azure Attestation keys (`<service url>/certs`), or None when CACTEE is simulated.
+    jwks: Option<Value>,
+    /// (certificate mtime, size) -> result, per hash part.
+    cache: Mutex<HashMap<String, Cached>>,
+}
+
+impl CvmVerifier {
+    pub(crate) fn load(
+        manifest: &Path,
+        jwks: Option<&PathBuf>,
+        simulate: bool,
+    ) -> Result<CvmVerifier, String> {
+        let raw = std::fs::read_to_string(manifest)
+            .map_err(|e| format!("cannot read cvm_manifest {}: {e}", manifest.display()))?;
+        let manifest = Manifest::from_json(&raw)
+            .map_err(|e| format!("invalid cvm_manifest {}: {e}", manifest.display()))?;
+        let jwks = match (jwks, simulate) {
+            (Some(path), _) => {
+                let raw = std::fs::read_to_string(path)
+                    .map_err(|e| format!("cannot read cvm_azure_jwks {}: {e}", path.display()))?;
+                Some(
+                    serde_json::from_str(&raw)
+                        .map_err(|e| format!("invalid cvm_azure_jwks {}: {e}", path.display()))?,
+                )
+            }
+            (None, true) => None,
+            (None, false) => {
+                return Err(
+                    "cvm_manifest is set: set cvm_azure_jwks (Azure Attestation keys) \
+                            or cvm_azure_simulate = true"
+                        .into(),
+                );
+            }
+        };
+        if jwks.is_none() {
+            tracing::warn!("cvm: Azure attestation tokens are NOT checked (cvm_azure_simulate)");
+        }
+        Ok(CvmVerifier {
+            manifest,
+            jwks,
+            cache: Mutex::new(HashMap::new()),
+        })
+    }
+
+    /// Verified Cvm* fields for `hash`, or why it is not certified.
+    /// `nar_name` is `<hash>-<name>.nar`, `nar_sha256` the narHash digest.
+    pub(crate) fn verified(
+        &self,
+        dir: &Path,
+        hash: &str,
+        nar_name: &str,
+        nar_sha256: &[u8],
+    ) -> Result<CvmAttestation, String> {
+        let file = dir.join(format!("{hash}.json"));
+        let meta = std::fs::metadata(&file).map_err(|_| "no certificate".to_string())?;
+        let mtime = meta.modified().unwrap_or(SystemTime::UNIX_EPOCH);
+        if let Some((t, len, res)) = self.cache.lock().expect("cvm cache").get(hash)
+            && *t == mtime
+            && *len == meta.len()
+        {
+            return res.clone();
+        }
+        let res = self.check(&file, nar_name, nar_sha256);
+        self.cache
+            .lock()
+            .expect("cvm cache")
+            .insert(hash.to_owned(), (mtime, meta.len(), res.clone()));
+        res
+    }
+
+    fn check(
+        &self,
+        file: &Path,
+        nar_name: &str,
+        nar_sha256: &[u8],
+    ) -> Result<CvmAttestation, String> {
+        let raw =
+            std::fs::read_to_string(file).map_err(|e| format!("cannot read certificate: {e}"))?;
+        let cert: Value =
+            serde_json::from_str(&raw).map_err(|e| format!("certificate is not JSON: {e}"))?;
+        let azure = match &self.jwks {
+            Some(jwks) => Azure::Jwks(jwks),
+            None => Azure::Simulated,
+        };
+        let report = verify_for_nar(&cert, &self.manifest, azure, nar_name, nar_sha256);
+        if !report.ok() {
+            return Err(report.failures());
+        }
+        tracing::debug!("cvm: {nar_name}: {}", report.summary());
+        let text = |k: &str| cert.get(k).and_then(Value::as_str).map(str::to_owned);
+        let mut inputs: Vec<String> = cert
+            .get("inputs")
+            .and_then(Value::as_array)
+            .map(|a| {
+                a.iter()
+                    .filter_map(|v| v.as_str().map(str::to_owned))
+                    .collect()
+            })
+            .unwrap_or_default();
+        inputs.sort();
+        Ok(CvmAttestation {
+            attestation_type: text("type").unwrap_or_else(|| "cactee-asset-certificate".into()),
+            backend: text("backend").unwrap_or_else(|| "cactee".into()),
+            quote: cert["duet_admin_quote"]["quote"]
+                .as_str()
+                .unwrap_or_default()
+                .to_owned(),
+            // From the verified NAR hash, never from the file.
+            output_hash: format!("sha256-{}", data_encoding::BASE64.encode(nar_sha256)),
+            input_hashes: inputs,
+        })
+    }
+}
