+# nixtee (Othmane Tabiane): new crate, not part of upstream Harmonia.
+[package]
+name                 = "harmonia-cactee-verify"
+version.workspace    = true
+authors.workspace    = true
+edition.workspace    = true
+license.workspace    = true
+homepage.workspace   = true
+repository.workspace = true
+description          = "Verify CACTEE asset certificates (SGX quote, Azure token, controller signature, service info, output hash)"
+
+[dependencies]
+data-encoding = { workspace = true }
+serde         = { workspace = true }
+# float_roundtrip: parse floats exactly, so they re-serialise like Python.
+serde_json    = { workspace = true, features = [ "float_roundtrip" ] }
+thiserror     = { workspace = true }
+# RustCrypto: RSA-PSS (controller signature) and PKCS#1 v1.5 (Azure token).
+rsa           = { version = "0.9", default-features = false, features = [ "std", "sha2", "pem" ] }
+sha2_10       = { package = "sha2", version = "0.10", features = [ "oid" ] }
+
+[dev-dependencies]
+rsa           = { version = "0.9", features = [ "std", "sha2" ] }
+rand          = "0.8"
+
+[lints]
+workspace = true
diff --git a/harmonia-cactee-verify/src/canonical.rs b/harmonia-cactee-verify/src/canonical.rs
new file mode 100644
index 0000000..95ae959
--- /dev/null
+++ b/harmonia-cactee-verify/src/canonical.rs
@@ -0,0 +1,172 @@
+//! Re-serialise JSON exactly like Python's `json.dumps(obj, sort_keys=True)`.
+//!
+//! CACTEE signs `json.dumps(duet_service_result, sort_keys=True)`. To check
+//! that signature we must rebuild the very same bytes from the parsed JSON:
+//!
+//! - separators `", "` and `": "`;
+//! - object keys sorted by code point;
+//! - `ensure_ascii`: every non-ASCII character escaped as `\uXXXX`
+//!   (surrogate pairs above U+FFFF);
+//! - floats written as Python's `repr(float)`: shortest round-trip digits,
+//!   fixed notation for 1e-4 <= |x| < 1e16, otherwise `1.5e-05` style
+//!   (sign always written, at least two exponent digits).
+
+use serde_json::{Number, Value};
+use std::fmt::Write as _;
+
+pub fn python_dumps_sorted(value: &Value) -> String {
+    let mut out = String::new();
+    write_value(&mut out, value);
+    out
+}
+
+fn write_value(out: &mut String, value: &Value) {
+    match value {
+        Value::Null => out.push_str("null"),
+        Value::Bool(b) => out.push_str(if *b { "true" } else { "false" }),
+        Value::Number(n) => write_number(out, n),
+        Value::String(s) => write_string(out, s),
+        Value::Array(items) => {
+            out.push('[');
+            for (i, item) in items.iter().enumerate() {
+                if i > 0 {
+                    out.push_str(", ");
+                }
+                write_value(out, item);
+            }
+            out.push(']');
+        }
+        Value::Object(map) => {
+            let mut keys: Vec<&String> = map.keys().collect();
+            keys.sort();
+            out.push('{');
+            for (i, key) in keys.iter().enumerate() {
+                if i > 0 {
+                    out.push_str(", ");
+                }
+                write_string(out, key);
+                out.push_str(": ");
+                write_value(out, &map[key.as_str()]);
+            }
+            out.push('}');
+        }
+    }
+}
+
+fn write_string(out: &mut String, s: &str) {
+    out.push('"');
+    for c in s.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            '\u{08}' => out.push_str("\\b"),
+            '\u{0c}' => out.push_str("\\f"),
+            c if (c as u32) < 0x20 || (c as u32) > 0x7e => {
+                let mut buf = [0u16; 2];
+                for unit in c.encode_utf16(&mut buf) {
+                    let _ = write!(out, "\\u{unit:04x}");
+                }
+            }
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+}
+
+fn write_number(out: &mut String, n: &Number) {
+    if let Some(i) = n.as_i64() {
+        let _ = write!(out, "{i}");
+    } else if let Some(u) = n.as_u64() {
+        let _ = write!(out, "{u}");
+    } else if let Some(f) = n.as_f64() {
+        out.push_str(&python_float_repr(f));
+    }
+}
+
+/// `repr(float)` in CPython (float_repr_style = 'short').
+pub fn python_float_repr(f: f64) -> String {
+    if f.is_nan() {
+        return "NaN".into();
+    }
+    if f.is_infinite() {
+        return if f > 0.0 { "Infinity" } else { "-Infinity" }.into();
+    }
+    if f == 0.0 {
+        return if f.is_sign_negative() { "-0.0" } else { "0.0" }.into();
+    }
+    // Rust's `{:e}` gives the shortest round-trip digits, like Python.
+    let sci = format!("{f:e}"); // e.g. "-1.0348831963211275e-5"
+    let (mantissa, exp) = sci.split_once('e').expect("{:e} always has an exponent");
+    let exp: i32 = exp.parse().expect("integer exponent");
+    let (sign, mantissa) = match mantissa.strip_prefix('-') {
+        Some(m) => ("-", m),
+        None => ("", mantissa),
+    };
+    let digits: String = mantissa.chars().filter(|c| *c != '.').collect();
+    let mut out = String::from(sign);
+    if (-4..16).contains(&exp) {
+        // fixed notation; decimal point after (exp + 1) digits
+        let point = exp + 1;
+        if point <= 0 {
+            out.push_str("0.");
+            out.extend(std::iter::repeat_n('0', (-point) as usize));
+            out.push_str(&digits);
+        } else if point as usize >= digits.len() {
+            out.push_str(&digits);
+            out.extend(std::iter::repeat_n('0', point as usize - digits.len()));
+            out.push_str(".0");
+        } else {
+            out.push_str(&digits[..point as usize]);
+            out.push('.');
+            out.push_str(&digits[point as usize..]);
+        }
+    } else {
+        out.push_str(&digits[..1]);
+        if digits.len() > 1 {
+            out.push('.');
+            out.push_str(&digits[1..]);
+        }
+        let _ = write!(out, "e{}{:02}", if exp < 0 { '-' } else { '+' }, exp.abs());
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn floats_like_python() {
+        // expected strings produced by CPython 3 repr()
+        let cases = [
+            (1.0348831963211275e-05, "1.0348831963211275e-05"),
+            (0.06753007866698402, "0.06753007866698402"),
+            (1774289172.8759155, "1774289172.8759155"),
+            (52.3667, "52.3667"),
+            (4.9, "4.9"),
+            (0.0001, "0.0001"),
+            (1e16, "1e+16"),
+            (1.5e16, "1.5e+16"),
+            (123456789012345.0, "123456789012345.0"),
+            (5.0, "5.0"),
+            (-2.5e-7, "-2.5e-07"),
+            (1e100, "1e+100"),
+        ];
+        for (f, want) in cases {
+            assert_eq!(python_float_repr(f), want, "{f:e}");
+        }
+    }
+
+    #[test]
+    fn sorted_keys_separators_and_ascii() {
+        let v: Value =
+            serde_json::from_str(r#"{"b": [1, 2.5, "é😀"], "a": {"y": null, "x": true}}"#).unwrap();
+        assert_eq!(
+            python_dumps_sorted(&v),
+            "{\"a\": {\"x\": true, \"y\": null}, \"b\": [1, 2.5, \"\\u00e9\\ud83d\\ude00\"]}"
+        );
+    }
+}
diff --git a/harmonia-cactee-verify/src/jwt.rs b/harmonia-cactee-verify/src/jwt.rs
new file mode 100644
index 0000000..45d05db
--- /dev/null
+++ b/harmonia-cactee-verify/src/jwt.rs
@@ -0,0 +1,150 @@
+// nixtee (Othmane Tabiane): new crate, not part of upstream Harmonia.
+//! The Azure Attestation token embedded in a CACTEE certificate.
+//!
+//! Azure Attestation checks the SGX quote and returns a JSON Web Token
+//! (`header.payload.signature`, base64url, RS256) signed with keys it
+//! publishes at `<service url>/certs`. Anyone can therefore check it later
+//! without Azure credentials:
+//!
+//! 1. the signature, with the key named by `kid` in that key set;
+//! 2. `iss` = the attestation service;
+//! 3. `sgx-mrenclave` = the manifest and the quote;
+//! 4. `x-ms-sgx-report-data` starts with sha256(PEM) = the quote's report data;
+//! 5. `x-ms-sgx-collateral.quotehash` = sha256(quote).
+//!
+//! `exp`/`nbf` are NOT checked: the token is minted at build time and the
+//! certificate is checked later (publish, install), when it has usually
+//! expired. Same choice as the C++ verifier; to be settled with CACTEE.
+
+use crate::{MRENCLAVE_AT, REPORT_DATA_AT, sha256_hex};
+use data_encoding::{BASE64URL_NOPAD, HEXLOWER};
+use rsa::{BigUint, Pkcs1v15Sign, RsaPublicKey};
+use serde_json::Value;
+use sha2_10::{Digest, Sha256};
+
+fn b64url(s: &str) -> Option<Vec<u8>> {
+    BASE64URL_NOPAD
+        .decode(s.trim_end_matches('=').as_bytes())
+        .ok()
+}
+
+/// The attestation URL comes from the (untrusted) certificate: accept only
+/// `https://<host>[:port]` on an Azure Attestation host.
+pub fn azure_endpoint(url: &str) -> Result<String, String> {
+    let rest = url
+        .strip_prefix("https://")
+        .ok_or_else(|| format!("attestation service url {url:?} is not https"))?;
+    let hostport = rest.strip_suffix('/').unwrap_or(rest);
+    if hostport.is_empty() || hostport.contains(['/', '@', '?', '#']) {
+        return Err(format!(
+            "attestation service url {url:?} is not https://<host>"
+        ));
+    }
+    let host = hostport.split(':').next().unwrap_or_default();
+    if host != "attest.azure.net" && !host.ends_with(".attest.azure.net") {
+        return Err(format!(
+            "attestation service url {url:?} is not an Azure Attestation host"
+        ));
+    }
+    Ok(format!("https://{hostport}"))
+}
+
+fn rsa_key(jwk: &Value) -> Option<RsaPublicKey> {
+    if jwk
+        .get("kty")
+        .and_then(Value::as_str)
+        .is_some_and(|k| k != "RSA")
+    {
+        return None;
+    }
+    let n = b64url(jwk.get("n")?.as_str()?)?;
+    let e = b64url(jwk.get("e")?.as_str()?)?;
+    RsaPublicKey::new(BigUint::from_bytes_be(&n), BigUint::from_bytes_be(&e)).ok()
+}
+
+/// Returns the problems found (empty = the token vouches for this quote).
+pub fn verify_azure_token(
+    token: &str,
+    endpoint: &str,
+    jwks: &Value,
+    quote: &[u8],
+    pem: &[u8],
+    expected_mrenclave: &str,
+) -> Vec<String> {
+    let parts: Vec<&str> = token.split('.').collect();
+    if parts.len() != 3 {
+        return vec!["attestation token is not a JWT".into()];
+    }
+    let decoded = (
+        b64url(parts[0]).and_then(|b| serde_json::from_slice::<Value>(&b).ok()),
+        b64url(parts[1]).and_then(|b| serde_json::from_slice::<Value>(&b).ok()),
+        b64url(parts[2]),
+    );
+    let (Some(header), Some(payload), Some(signature)) = decoded else {
+        return vec!["attestation token could not be decoded".into()];
+    };
+    if header.get("alg").and_then(Value::as_str) != Some("RS256") {
+        return vec!["attestation token algorithm is not RS256".into()];
+    }
+    let keys = jwks
+        .get("keys")
+        .and_then(Value::as_array)
+        .cloned()
+        .unwrap_or_default();
+    let jwk = match header.get("kid").and_then(Value::as_str) {
+        Some(kid) => keys
+            .iter()
+            .find(|k| k.get("kid").and_then(Value::as_str) == Some(kid)),
+        None if keys.len() == 1 => keys.first(),
+        None => return vec!["attestation token has no key id".into()],
+    };
+    let Some(jwk) = jwk else {
+        return vec!["attestation token key id is not in the service keys".into()];
+    };
+    let Some(key) = rsa_key(jwk) else {
+        return vec!["attestation signing key could not be read".into()];
+    };
+    let signing_input = format!("{}.{}", parts[0], parts[1]);
+    let digest = Sha256::digest(signing_input.as_bytes());
+    if key
+        .verify(Pkcs1v15Sign::new::<Sha256>(), &digest, &signature)
+        .is_err()
+    {
+        return vec!["attestation token signature does not match".into()];
+    }
+
+    let mut problems = Vec::new();
+    let claim = |k: &str| {
+        payload
+            .get(k)
+            .and_then(Value::as_str)
+            .unwrap_or_default()
+            .to_owned()
+    };
+    if claim("iss").trim_end_matches('/') != endpoint.trim_end_matches('/') {
+        problems.push("token issuer is not the attestation service".into());
+    }
+    let mr = claim("sgx-mrenclave");
+    if mr != expected_mrenclave {
+        problems.push("token mrenclave does not match the manifest".into());
+    }
+    if mr != HEXLOWER.encode(&quote[MRENCLAVE_AT..MRENCLAVE_AT + 32]) {
+        problems.push("token mrenclave does not match the quote".into());
+    }
+    let report_data = claim("x-ms-sgx-report-data");
+    let report_key = report_data.get(..64).unwrap_or_default();
+    if report_key != sha256_hex(pem) {
+        problems.push("token report data does not match the public key".into());
+    }
+    if report_key != HEXLOWER.encode(&quote[REPORT_DATA_AT..REPORT_DATA_AT + 32]) {
+        problems.push("token report data does not match the quote".into());
+    }
+    let quotehash = payload
+        .get("x-ms-sgx-collateral")
+        .and_then(|c| c.get("quotehash"))
+        .and_then(Value::as_str);
+    if quotehash != Some(sha256_hex(quote).as_str()) {
+        problems.push("token quote hash does not match the quote".into());
+    }
+    problems
+}
diff --git a/harmonia-cactee-verify/src/lib.rs b/harmonia-cactee-verify/src/lib.rs
new file mode 100644
index 0000000..5fb121c
--- /dev/null
+++ b/harmonia-cactee-verify/src/lib.rs
@@ -0,0 +1,317 @@
+// nixtee (Othmane Tabiane): new crate, not part of upstream Harmonia.
+//! Verify CACTEE asset certificates.
+//!
+//! Rust port of the checks in the Nix fork's
+//! `src/certification-verification/certificate-verifier.cc` (Muhammad
+//! Aetisam) and of `Docker/cache/cactee_verify.py`. The step names match.
+//!
+//! A certificate (CACTEE `AssetCertificate`) looks like:
+//!
+//! ```text
+//! duet_admin_quote                   { quote: base64 SGX quote, public_key: PEM, jwt?: Azure token }
+//! duet_admin_attestation_service_url "https://<name>.attest.azure.net"
+//! duet_service_result                { service_info: {..}, service_result: { hashes: { outputs: {..} } } }
+//! duet_admin_signature               base64 RSA-PSS-SHA256 over python json.dumps(duet_service_result, sort_keys=True)
+//! ```
+//!
+//! | step                       | checks                                                            | needs     |
+//! |----------------------------|-------------------------------------------------------------------|-----------|
+//! | `01_duet_admin_quote`      | quote MRENCLAVE = manifest, quote report_data = sha256(PEM), JWT  | cert      |
+//! | `02_controller_signature`  | RSA-PSS signature over the service result with that PEM           | cert      |
+//! | `03_duet_service_info`     | service code / tools / dependencies hashes = manifest             | cert      |
+//! | `05_output_hashes`         | the NAR's sha256 = the certificate's `<hash>-<name>.nar` output    | NAR hash  |
+//!
+//! The crate does no I/O: the caller reads the certificate, the manifest and
+//! (for real Azure tokens) the attestation service's JSON Web Key Set.
+
+pub mod canonical;
+pub mod jwt;
+
+use data_encoding::{BASE64, HEXLOWER};
+use rsa::pkcs8::DecodePublicKey;
+use rsa::{Pss, RsaPublicKey};
+use serde::Deserialize;
+use serde_json::Value;
+use sha2_10::{Digest, Sha256};
+
+/// SGX DCAP quote: 48-byte header + 384-byte report body.
+pub const QUOTE_MIN_LEN: usize = 400;
+/// MRENCLAVE: report body offset 64.
+pub const MRENCLAVE_AT: usize = 112;
+/// REPORT_DATA: report body offset 320; first 32 bytes = sha256(PEM).
+pub const REPORT_DATA_AT: usize = 368;
+
+/// What the verifier expects, from `cactee-manifest.json`.
+#[derive(Debug, Clone, Deserialize)]
+pub struct Manifest {
+    #[serde(rename = "EXPECTED_DUET_ADMIN_MRENCLAVE")]
+    pub mrenclave: String,
+    #[serde(rename = "EXPECTED_DUET_SERVICE_INFO")]
+    pub service_info: ExpectedServiceInfo,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+pub struct ExpectedServiceInfo {
+    pub service_code_hash: String,
+    pub service_tools_hashes: Value,
+    /// Accepted dependency hashes, e.g. {"cpu": "...", "gpu": "..."}.
+    pub service_dependencies_hash: serde_json::Map<String, Value>,
+}
+
+impl Manifest {
+    pub fn from_json(raw: &str) -> Result<Self, serde_json::Error> {
+        serde_json::from_str(raw)
+    }
+}
+
+/// How the Azure attestation token is checked.
+#[derive(Debug, Clone, Copy)]
+pub enum Azure<'a> {
+    /// Simulated CACTEE: no token to check. Never use in production.
+    Simulated,
+    /// Check `duet_admin_quote.jwt` against this JSON Web Key Set
+    /// (from `<attestation service url>/certs`).
+    Jwks(&'a Value),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Step {
+    pub name: &'static str,
+    pub ok: bool,
+    pub detail: Vec<String>,
+}
+
+impl Step {
+    fn new(name: &'static str) -> Self {
+        Step {
+            name,
+            ok: false,
+            detail: Vec::new(),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Report {
+    pub steps: Vec<Step>,
+}
+
+impl Report {
+    pub fn ok(&self) -> bool {
+        !self.steps.is_empty() && self.steps.iter().all(|s| s.ok)
+    }
+
+    /// "01_duet_admin_quote=ok 02_controller_signature=FAIL …"
+    pub fn summary(&self) -> String {
+        self.steps
+            .iter()
+            .map(|s| format!("{}={}", s.name, if s.ok { "ok" } else { "FAIL" }))
+            .collect::<Vec<_>>()
+            .join(" ")
+    }
+
+    /// The reasons of the failed steps, for logs and error messages.
+    pub fn failures(&self) -> String {
+        self.steps
+            .iter()
+            .filter(|s| !s.ok)
+            .map(|s| format!("{}: {}", s.name, s.detail.join(", ")))
+            .collect::<Vec<_>>()
+            .join("; ")
+    }
+}
+
+pub fn sha256_hex(data: &[u8]) -> String {
+    HEXLOWER.encode(&Sha256::digest(data))
+}
+
+fn b64(s: &str) -> Option<Vec<u8>> {
+    // Certificates may wrap base64; ignore whitespace.
+    let clean: String = s.chars().filter(|c| !c.is_whitespace()).collect();
+    BASE64.decode(clean.as_bytes()).ok()
+}
+
+fn str_at<'a>(v: &'a Value, path: &[&str]) -> Option<&'a str> {
+    path.iter().try_fold(v, |v, k| v.get(k))?.as_str()
+}
+
+/// Steps 01–03: everything that needs only the certificate.
+pub fn verify_certificate(cert: &Value, manifest: &Manifest, azure: Azure<'_>) -> Report {
+    let mut report = Report::default();
+    let pem = str_at(cert, &["duet_admin_quote", "public_key"]);
+
+    // 01 -- quote
+    let mut s1 = Step::new("01_duet_admin_quote");
+    let quote = str_at(cert, &["duet_admin_quote", "quote"]).map(b64);
+    let url = str_at(cert, &["duet_admin_attestation_service_url"]).filter(|u| !u.is_empty());
+    match (pem, quote, url) {
+        (None, _, _) | (_, None, _) => s1.detail.push("quote or public key is missing".into()),
+        (_, Some(None), _) => s1.detail.push("quote is not base64".into()),
+        (_, _, None) => s1.detail.push("attestation service url is missing".into()),
+        (Some(pem), Some(Some(quote)), Some(url)) => {
+            if quote.len() < QUOTE_MIN_LEN {
+                s1.detail.push(format!(
+                    "quote is {} bytes, expected >= {QUOTE_MIN_LEN}",
+                    quote.len()
+                ));
+            } else {
+                let quote_mr = HEXLOWER.encode(&quote[MRENCLAVE_AT..MRENCLAVE_AT + 32]);
+                let quote_key = HEXLOWER.encode(&quote[REPORT_DATA_AT..REPORT_DATA_AT + 32]);
+                let key_ok = quote_key == sha256_hex(pem.as_bytes());
+                let mr_ok = quote_mr == manifest.mrenclave;
+                if !key_ok {
+                    s1.detail
+                        .push("public key hash does not match quote report_data".into());
+                }
+                if !mr_ok {
+                    s1.detail
+                        .push("mrenclave does not match the manifest".into());
+                }
+                let jwt_ok = match azure {
+                    Azure::Simulated => {
+                        s1.detail
+                            .push("azure simulated: attestation token not checked".into());
+                        true
+                    }
+                    Azure::Jwks(jwks) => match jwt::azure_endpoint(url) {
+                        Err(e) => {
+                            s1.detail.push(e);
+                            false
+                        }
+                        Ok(endpoint) => match str_at(cert, &["duet_admin_quote", "jwt"]) {
+                            None => {
+                                s1.detail.push(
+                                    "attestation token (duet_admin_quote.jwt) is missing".into(),
+                                );
+                                false
+                            }
+                            Some(token) => {
+                                let problems = jwt::verify_azure_token(
+                                    token,
+                                    &endpoint,
+                                    jwks,
+                                    &quote,
+                                    pem.as_bytes(),
+                                    &manifest.mrenclave,
+                                );
+                                let ok = problems.is_empty();
+                                s1.detail.extend(problems);
+                                ok
+                            }
+                        },
+                    },
+                };
+                s1.ok = key_ok && mr_ok && jwt_ok;
+            }
+        }
+    }
+    report.steps.push(s1);
+
+    // 02 -- controller signature over the service result
+    let mut s2 = Step::new("02_controller_signature");
+    let result = cert.get("duet_service_result").filter(|v| v.is_object());
+    let signature = str_at(cert, &["duet_admin_signature"]).and_then(b64);
+    match (pem, result, signature) {
+        (Some(pem), Some(result), Some(signature)) => {
+            let message = canonical::python_dumps_sorted(result);
+            s2.ok = verify_pss(pem, message.as_bytes(), &signature);
+            if !s2.ok {
+                s2.detail.push("signature does not match".into());
+            }
+        }
+        _ => s2
+            .detail
+            .push("signature, service result or public key is missing".into()),
+    }
+    report.steps.push(s2);
+
+    // 03 -- the service that ran is the expected one
+    let mut s3 = Step::new("03_duet_service_info");
+    match result
+        .and_then(|r| r.get("service_info"))
+        .filter(|v| v.is_object())
+    {
+        None => s3.detail.push("service_info is missing".into()),
+        Some(info) => {
+            let want = &manifest.service_info;
+            let code_ok = info.get("service_code_hash").and_then(Value::as_str)
+                == Some(&want.service_code_hash);
+            let tools_ok = info.get("service_tools_hashes") == Some(&want.service_tools_hashes);
+            let deps_ok = info
+                .get("service_dependencies_hash")
+                .is_some_and(|d| want.service_dependencies_hash.values().any(|w| w == d));
+            for (ok, what) in [
+                (code_ok, "service_code_hash"),
+                (tools_ok, "service_tools_hashes"),
+                (deps_ok, "service_dependencies_hash"),
+            ] {
+                if !ok {
+                    s3.detail
+                        .push(format!("{what} does not match the manifest"));
+                }
+            }
+            s3.ok = code_ok && tools_ok && deps_ok;
+        }
+    }
+    report.steps.push(s3);
+
+    report
+}
+
+/// The sha256 (lowercase hex) the certificate gives for the output file
+/// `nar_name` (`<hash>-<name>.nar`), if it names that file.
+pub fn certified_nar_hash<'a>(cert: &'a Value, nar_name: &str) -> Option<&'a str> {
+    cert.get("duet_service_result")?
+        .get("service_result")?
+        .get("hashes")?
+        .get("outputs")?
+        .get(nar_name)?
+        .as_str()
+}
+
+/// Step 05: the NAR we serve is the one the certificate names.
+pub fn check_output(cert: &Value, nar_name: &str, nar_sha256: &[u8]) -> Step {
+    let mut s5 = Step::new("05_output_hashes");
+    let have = HEXLOWER.encode(nar_sha256);
+    match certified_nar_hash(cert, nar_name) {
+        None => s5
+            .detail
+            .push(format!("certificate has no output named {nar_name}")),
+        Some(want) if want.eq_ignore_ascii_case(&have) => s5.ok = true,
+        Some(want) => s5.detail.push(format!(
+            "{nar_name}: NAR sha256 {have} != certificate {want}"
+        )),
+    }
+    s5
+}
+
+/// Steps 01–05 at once, for a NAR whose sha256 is already known (the cache
+/// database's narHash is exactly that).
+pub fn verify_for_nar(
+    cert: &Value,
+    manifest: &Manifest,
+    azure: Azure<'_>,
+    nar_name: &str,
+    nar_sha256: &[u8],
+) -> Report {
+    let mut report = verify_certificate(cert, manifest, azure);
+    report.steps.push(check_output(cert, nar_name, nar_sha256));
+    report
+}
+
+/// RSA-PSS, SHA-256, MGF1-SHA-256, with the salt length CACTEE signs with:
+/// Python `padding.PSS.MAX_LENGTH` = emLen - hLen - 2
+/// (emLen = ceil((modBits - 1) / 8), hLen = 32).
+fn verify_pss(pem: &str, message: &[u8], signature: &[u8]) -> bool {
+    use rsa::traits::PublicKeyParts;
+    let Ok(key) = RsaPublicKey::from_public_key_pem(pem) else {
+        return false;
+    };
+    let em_len = (key.n().bits() - 1).div_ceil(8);
+    let Some(max_salt) = em_len.checked_sub(32 + 2) else {
+        return false;
+    };
+    let digest = Sha256::digest(message);
+    key.verify(Pss::new_with_salt::<Sha256>(max_salt), &digest, signature)
+        .is_ok()
+}
