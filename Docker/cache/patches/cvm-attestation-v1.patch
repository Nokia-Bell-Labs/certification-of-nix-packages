+/// On-disk attestation file, one per store path.
+/// Unknown fields (version, producer, derivation, timestamp) are ignored.
+#[derive(Debug, Deserialize)]
+struct CvmAttestationFile {
+    #[serde(rename = "type")]
+    attestation_type: String,
+    backend: String,
+    quote: String,
+    #[serde(rename = "outputHash")]
+    output_hash: String,
+    #[serde(default)]
+    inputs: Vec<String>,
+}
+
+/// Reads the attestation for a store path, if one was published.
+/// A missing or malformed file is not an error: the narinfo is then
+/// served without the Cvm* fields.
+fn read_attestation(dir: &Path, hash: &str) -> Option<CvmAttestation> {
+    let raw = std::fs::read_to_string(dir.join(format!("{hash}.json"))).ok()?;
+    let f: CvmAttestationFile = serde_json::from_str(&raw).ok()?;
+    let mut inputs = f.inputs;
+    inputs.sort();
+    Some(CvmAttestation {
+        attestation_type: f.attestation_type,
+        backend: f.backend,
+        quote: f.quote,
+        output_hash: f.output_hash,
+        input_hashes: inputs,
+    })
+}
