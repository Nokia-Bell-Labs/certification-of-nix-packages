@@ -0,0 +1,64 @@
+#pragma once
+///@file
+
+#include "nix/store/attestation-settings.hh"
+#include "nix/store/derivations.hh"
+#include "nix/store/path.hh"
+#include "nix/store/store-api.hh"
+
+#include <list>
+
+namespace nix {
+
+/** Leaves-first JSON+sig for @a drv inputs and their narinfo closure; no NAR download. */
+void verifyDirectInputAttestations(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & drvPath,
+    const BasicDerivation & drv,
+    const std::list<ref<Store>> & substituters = {},
+    StorePathSet * alreadyVerified = nullptr);
+
+/** Leaves-first JSON+sig for @a root's narinfo graph; skip paths already in the store. */
+void verifyPathClosureAttestations(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & root,
+    const std::list<ref<Store>> & substituters,
+    StorePathSet & alreadyVerified);
+
+/** Verify one path's JSON+sig after narinfo, before the NAR is written. */
+void verifyPathAttestation(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & path,
+    const std::string & narHashSri,
+    const std::list<ref<Store>> & substituters = {});
+
+/** Local SRI-named certificate path (`/` in the hash becomes `_`). */
+std::filesystem::path attestationCertPath(const AttestationSettings & settings, const std::string & narHashSri);
+
+/** Fetch the CACTEE certificate for @a path and verify it. Does not upload it. */
+void copyAttestationSidecar(Store & srcStore, Store & dstStore, const StorePath & path);
+
+/** Bind on-disk `{hashPart}` sidecars to @a path (e.g. `--import-nar`). */
+void bindAttestationSidecarFromDisk(Store & store, const StorePath & path, const Hash & narHash);
+
+/** Verify sidecar JSON+sig; does not write files. */
+void verifyIncomingAttestation(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & path,
+    const Hash & narHash,
+    std::string_view json,
+    std::string_view sig);
+
+/** Require an on-disk sidecar for @a path unless it is a bootstrap NAR hash. */
+void requireIncomingAttestationSidecar(
+    Store & store, const AttestationSettings & settings, const StorePath & path, const Hash & narHash);
+
+/** Save a fetched certificate under `attestation-store` for this client. */
+void installAttestationSidecar(
+    Store & store, const StorePath & path, const Hash & narHash, std::string_view json, std::string_view sig);
+
+} // namespace nix
