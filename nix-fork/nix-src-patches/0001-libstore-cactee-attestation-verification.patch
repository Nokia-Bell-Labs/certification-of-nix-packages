+    std::string stripSlash(std::string value)
+    {
+        while (!value.empty() && value.back() == '/')
+            value.pop_back();
+        return value;
+    }
+
+    std::string briefBody(const std::string & body)
+    {
+        std::string text = body.substr(0, 180);
+        for (char & c : text)
+            if (c == '\n' || c == '\r')
+                c = ' ';
+        return text;
+    }
+
+    std::string base64UrlEncode(std::string_view data)
+    {
+        static constexpr char table[] =
+            "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+        std::string out;
+        std::size_t i = 0;
+        while (i + 3 <= data.size()) {
+            unsigned n = (static_cast<unsigned char>(data[i]) << 16)
+                | (static_cast<unsigned char>(data[i + 1]) << 8)
+                | static_cast<unsigned char>(data[i + 2]);
+            out.push_back(table[(n >> 18) & 63]);
+            out.push_back(table[(n >> 12) & 63]);
+            out.push_back(table[(n >> 6) & 63]);
+            out.push_back(table[n & 63]);
+            i += 3;
+        }
+        if (i < data.size()) {
+            unsigned n = static_cast<unsigned char>(data[i]) << 16;
+            if (i + 1 < data.size())
+                n |= static_cast<unsigned char>(data[i + 1]) << 8;
+            out.push_back(table[(n >> 18) & 63]);
+            out.push_back(table[(n >> 12) & 63]);
+            if (i + 1 < data.size())
+                out.push_back(table[(n >> 6) & 63]);
+        }
+        return out;
+    }
+
+    std::string base64UrlDecode(std::string_view in)
+    {
+        std::string padded(in);
+        for (char & c : padded) {
+            if (c == '-')
+                c = '+';
+            else if (c == '_')
+                c = '/';
+        }
+        while (padded.size() % 4 != 0)
+            padded.push_back('=');
+        return base64Decode(padded);
+    }
+
+    std::string urlEncode(std::string_view in)
+    {
+        static constexpr char hex[] = "0123456789ABCDEF";
+        std::string out;
+        for (unsigned char c : in) {
+            if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')
+                || c == '-' || c == '_' || c == '.' || c == '~')
+                out.push_back(static_cast<char>(c));
+            else {
+                out.push_back('%');
+                out.push_back(hex[c >> 4]);
+                out.push_back(hex[c & 0x0f]);
+            }
+        }
+        return out;
+    }
+
+    /* The attestation URL is taken from the untrusted certificate. The Azure AD
+       bearer token is sent only to a real Attestation host, unless simulation is on. */
+    bool azureSimulate()
+    {
+        const char * value = std::getenv("CACTEE_AZURE_SIMULATE");
+        return value && std::string_view(value) == "1";
+    }
+
+    bool azureAttestationEndpoint(std::string_view url, std::string & endpoint, std::string & error)
+    {
+        const std::string prefix = "https://";
+        if (!url.starts_with(prefix)) {
+            error = "attestation service url must be https";
+            return false;
+        }
+        std::string_view rest = url.substr(prefix.size());
+        auto slash = rest.find('/');
+        std::string_view hostport = slash == std::string_view::npos ? rest : rest.substr(0, slash);
+        if (slash != std::string_view::npos && slash + 1 < rest.size()) {
+            error = "attestation service url must not include a path";
+            return false;
+        }
+        auto colon = hostport.find(':');
+        std::string_view host = colon == std::string_view::npos ? hostport : hostport.substr(0, colon);
+        if (host.empty() || host.find('@') != std::string_view::npos) {
+            error = "attestation service url has no host";
+            return false;
+        }
+        const bool azureHost = host == "attest.azure.net" || host.ends_with(".attest.azure.net");
+        /* CACTEE_AZURE_SIMULATE lets a local HTTPS server stand in for Azure.
+           It is off unless that variable is 1. The certificate cannot turn it on. */
+        if (!azureHost && !azureSimulate()) {
+            error = "attestation service url is not an Azure Attestation host";
+            return false;
+        }
+        endpoint = prefix + std::string(hostport);
+        return true;
+    }
+
+    bool azureAuthority(std::string_view url)
+    {
+        const std::string prefix = "https://";
+        if (!url.starts_with(prefix))
+            return false;
+        std::string_view rest = url.substr(prefix.size());
+        auto slash = rest.find('/');
+        std::string_view hostport = slash == std::string_view::npos ? rest : rest.substr(0, slash);
+        auto colon = hostport.find(':');
+        std::string_view host = colon == std::string_view::npos ? hostport : hostport.substr(0, colon);
+        return host == "login.microsoftonline.com"
+            || host == "login.microsoftonline.us"
+            || host.ends_with(".microsoftonline.com")
+            || host.ends_with(".microsoftonline.us");
+    }
+
+    std::size_t writeBody(char * ptr, std::size_t size, std::size_t nmemb, void * userdata)
+    {
+        auto * out = static_cast<std::string *>(userdata);
+        const std::size_t bytes = size * nmemb;
+        if (out->size() + bytes > (1u << 20))
+            return 0;
+        out->append(ptr, bytes);
+        return bytes;
+    }
+
+    HttpResult httpRequest(const std::string & url, const std::string * body, const std::vector<std::string> & headers)
+    {
+        static std::once_flag curlOnce;
+        std::call_once(curlOnce, [] { curl_global_init(CURL_GLOBAL_DEFAULT); });
+
+        HttpResult result;
+        CURL * curl = curl_easy_init();
+        if (!curl) {
+            result.error = "curl init failed";
+            return result;
+        }
+
+        std::string caFile;
+        if (const char * ca = std::getenv("SSL_CERT_FILE"))
+            caFile = ca;
+
+        curl_slist * list = nullptr;
+        for (const auto & header : headers)
+            list = curl_slist_append(list, header.c_str());
+
+        char errbuf[CURL_ERROR_SIZE] = {};
+        curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+        curl_easy_setopt(curl, CURLOPT_HTTPHEADER, list);
+        curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, writeBody);
+        curl_easy_setopt(curl, CURLOPT_WRITEDATA, &result.body);
+        curl_easy_setopt(curl, CURLOPT_ERRORBUFFER, errbuf);
+        curl_easy_setopt(curl, CURLOPT_TIMEOUT, 30L);
+        curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+        curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 0L);
+        curl_easy_setopt(curl, CURLOPT_PROTOCOLS_STR, "https");
+        if (!caFile.empty())
+            curl_easy_setopt(curl, CURLOPT_CAINFO, caFile.c_str());
+        if (body) {
+            curl_easy_setopt(curl, CURLOPT_POST, 1L);
+            curl_easy_setopt(curl, CURLOPT_POSTFIELDS, body->data());
+            curl_easy_setopt(curl, CURLOPT_POSTFIELDSIZE_LARGE, static_cast<curl_off_t>(body->size()));
+        }
+
+        CURLcode rc = curl_easy_perform(curl);
+        if (rc != CURLE_OK)
+            result.error = errbuf[0] ? errbuf : curl_easy_strerror(rc);
+        else
+            curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &result.status);
+
+        curl_slist_free_all(list);
+        curl_easy_cleanup(curl);
+        return result;
+    }
+
+    EVP_PKEY * rsaPublicKey(const nlohmann::json & jwk)
+    {
+        if (!jwk.contains("n") || !jwk.contains("e") || !jwk["n"].is_string() || !jwk["e"].is_string())
+            return nullptr;
+        if (jwk.contains("kty") && jwk["kty"] != "RSA")
+            return nullptr;
+
+        std::string nBytes = base64UrlDecode(jwk["n"].get<std::string>());
+        std::string eBytes = base64UrlDecode(jwk["e"].get<std::string>());
+        if (nBytes.empty() || eBytes.empty())
+            return nullptr;
+
+        BIGNUM * n = BN_bin2bn(reinterpret_cast<const unsigned char *>(nBytes.data()), static_cast<int>(nBytes.size()), nullptr);
+        BIGNUM * e = BN_bin2bn(reinterpret_cast<const unsigned char *>(eBytes.data()), static_cast<int>(eBytes.size()), nullptr);
+        OSSL_PARAM_BLD * bld = OSSL_PARAM_BLD_new();
+        EVP_PKEY_CTX * ctx = nullptr;
+        OSSL_PARAM * params = nullptr;
+        EVP_PKEY * key = nullptr;
+        bool built = n && e && bld
+            && OSSL_PARAM_BLD_push_BN(bld, OSSL_PKEY_PARAM_RSA_N, n)
+            && OSSL_PARAM_BLD_push_BN(bld, OSSL_PKEY_PARAM_RSA_E, e)
+            && (params = OSSL_PARAM_BLD_to_param(bld))
+            && (ctx = EVP_PKEY_CTX_new_from_name(nullptr, "RSA", nullptr))
+            && EVP_PKEY_fromdata_init(ctx) == 1
+            && EVP_PKEY_fromdata(ctx, &key, EVP_PKEY_PUBLIC_KEY, params) == 1;
+
+        OSSL_PARAM_free(params);
+        EVP_PKEY_CTX_free(ctx);
+        OSSL_PARAM_BLD_free(bld);
+        BN_free(n);
+        BN_free(e);
+        if (!built) {
+            EVP_PKEY_free(key);
+            return nullptr;
+        }
+        return key;
+    }
+
+    bool verifyRs256(EVP_PKEY * key, std::string_view signingInput, std::string_view signature)
+    {
+        EVP_MD_CTX * ctx = EVP_MD_CTX_new();
+        if (!ctx)
+            return false;
+        const bool ok = EVP_DigestVerifyInit(ctx, nullptr, EVP_sha256(), nullptr, key) == 1
+            && EVP_DigestVerifyUpdate(ctx, signingInput.data(), signingInput.size()) == 1
+            && EVP_DigestVerifyFinal(
+                ctx,
+                reinterpret_cast<const unsigned char *>(signature.data()),
+                signature.size()) == 1;
+        EVP_MD_CTX_free(ctx);
+        return ok;
+    }
+
+    std::string validateAttestationToken(const std::string & jwt, const std::string & endpoint, const nlohmann::json & jwks)
+    {
+        const auto first = jwt.find('.');
+        const auto second = first == std::string::npos ? std::string::npos : jwt.find('.', first + 1);
+        if (first == std::string::npos || second == std::string::npos || jwt.find('.', second + 1) != std::string::npos)
+            return "attestation token is not a JWT";
+
+        std::string headerBytes = base64UrlDecode(std::string_view(jwt).substr(0, first));
+        std::string payloadBytes = base64UrlDecode(std::string_view(jwt).substr(first + 1, second - first - 1));
+        std::string signature = base64UrlDecode(std::string_view(jwt).substr(second + 1));
+        if (headerBytes.empty() || payloadBytes.empty() || signature.empty())
+            return "attestation token could not be decoded";
+
+        nlohmann::json header = nlohmann::json::parse(headerBytes);
+        nlohmann::json payload = nlohmann::json::parse(payloadBytes);
+        if (!header.contains("alg") || header["alg"] != "RS256")
+            return "attestation token algorithm is not RS256";
+        if (!jwks.contains("keys") || !jwks["keys"].is_array())
+            return "attestation signing keys are missing";
+
+        const nlohmann::json * jwk = nullptr;
+        if (header.contains("kid") && header["kid"].is_string()) {
+            for (const auto & key : jwks["keys"])
+                if (key.contains("kid") && key["kid"] == header["kid"])
+                    jwk = &key;
+            if (!jwk)
+                return "attestation token key id is not in the service keys";
+        } else if (jwks["keys"].size() == 1) {
+            jwk = &jwks["keys"][0];
+        } else {
+            return "attestation token has no key id";
+        }
+
+        EVP_PKEY * key = rsaPublicKey(*jwk);
+        if (!key)
+            return "attestation signing key could not be read";
+        const bool signatureOk = verifyRs256(key, jwt.substr(0, second), signature);
+        EVP_PKEY_free(key);
+        if (!signatureOk)
+            return "attestation token signature does not match";
+
+        if (!payload.contains("iss") || !payload["iss"].is_string()
+            || stripSlash(payload["iss"].get<std::string>()) != stripSlash(endpoint))
+            return "attestation token issuer does not match the attestation service url";
+
+        // const auto now = std::chrono::duration_cast<std::chrono::seconds>(
+        //     std::chrono::system_clock::now().time_since_epoch()).count();
+        // constexpr std::int64_t skew = 60;
+        // if (!payload.contains("exp") || !payload["exp"].is_number()
+        //     || payload["exp"].get<std::int64_t>() + skew < now)
+        //     return "attestation token is expired";
+        // if (payload.contains("nbf") && payload["nbf"].is_number()
+        //     && payload["nbf"].get<std::int64_t>() > now + skew)
+        //     return "attestation token is not yet valid";
+        return {};
+    }
+
+    std::string verifyEmbeddedAdminJwt(
+        const std::string & jwt,
+        const std::string & endpoint,
+        const std::string & quote,
+        const std::string & pem,
+        const std::string & expectedMrenclave)
+    {
+        HttpResult certsHttp = httpRequest(endpoint + "/certs", nullptr, {"Accept: application/json"});
+        if (!certsHttp.error.empty() || certsHttp.status != 200)
+            return "azure attestation keys failed";
+        nlohmann::json jwks = nlohmann::json::parse(certsHttp.body);
+
+        std::string tokenError = validateAttestationToken(jwt, endpoint, jwks);
+        if (!tokenError.empty())
+            return tokenError;
+
+        const auto first = jwt.find('.');
+        const auto second = jwt.find('.', first + 1);
+        std::string payloadBytes = base64UrlDecode(std::string_view(jwt).substr(first + 1, second - first - 1));
+        nlohmann::json payload = nlohmann::json::parse(payloadBytes);
+
+        if (!payload.contains("sgx-mrenclave") || !payload["sgx-mrenclave"].is_string())
+            return "attestation token has no mrenclave";
+        const std::string tokenMr = payload["sgx-mrenclave"].get<std::string>();
+        if (tokenMr != expectedMrenclave)
+            return "attestation token mrenclave does not match the manifest";
+        if (tokenMr != sliceHex(quote, 112))
+            return "attestation token mrenclave does not match the quote";
+
+        if (!payload.contains("x-ms-sgx-report-data") || !payload["x-ms-sgx-report-data"].is_string())
+            return "attestation token has no report data";
+        const std::string reportData = payload["x-ms-sgx-report-data"].get<std::string>();
+        if (reportData.size() < 64)
+            return "attestation token report data is too short";
+        const std::string reportKey = reportData.substr(0, 64);
+        if (reportKey != sha256hex(pem))
+            return "attestation token report data does not match the public key";
+        if (reportKey != sliceHex(quote, 368))
+            return "attestation token report data does not match the quote";
+
+        if (!payload.contains("x-ms-sgx-collateral")
+            || !payload["x-ms-sgx-collateral"].contains("quotehash")
+            || !payload["x-ms-sgx-collateral"]["quotehash"].is_string())
+            return "attestation token has no quote hash";
+        if (payload["x-ms-sgx-collateral"]["quotehash"].get<std::string>() != sha256hex(quote))
+            return "attestation token quote hash does not match the quote";
+        return {};
+    }
+
+    AzureResult attestSgxEnclave(const std::string & serviceUrl, const std::string & quote, const std::string & pem)
+    {
+        AzureResult result;
+        try {
+            /* Operator switch. The certificate cannot set this. Quote bytes are
+               still checked locally for MRENCLAVE and the public-key hash. */
+            if (azureSimulate()) {
+                (void) serviceUrl;
+                (void) quote;
+                (void) pem;
+                result.ok = true;
+                result.detail = "azure attestation accepted the quote (simulation)";
+                return result;
+            }
+            std::string endpoint;
+            std::string urlError;
+            if (!azureAttestationEndpoint(serviceUrl, endpoint, urlError)) {
+                result.detail = urlError;
+                return result;
+            }
+
+            const char * tenantEnv = std::getenv("AZURE_TENANT_ID");
+            const char * clientEnv = std::getenv("AZURE_CLIENT_ID");
+            const char * secretEnv = std::getenv("AZURE_CLIENT_SECRET");
+            if (!tenantEnv || !clientEnv || !secretEnv || !*tenantEnv || !*clientEnv || !*secretEnv) {
+                result.detail = "azure credentials are not set (AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET)";
+                return result;
+            }
+            const std::string tenant = tenantEnv;
+            const std::string client = clientEnv;
+            const std::string secret = secretEnv;
+
+            std::string authority = azureSimulate() ? endpoint : "https://login.microsoftonline.com";
+            if (const char * authorityEnv = std::getenv("AZURE_AUTHORITY_HOST"))
+                if (*authorityEnv)
+                    authority = stripSlash(authorityEnv);
+            if (!azureAuthority(authority) && !(azureSimulate() && authority.starts_with("https://"))) {
+                result.detail = "AZURE_AUTHORITY_HOST is not a Microsoft login host";
+                return result;
+            }
+
+            std::string tokenBody = "client_id=" + urlEncode(client)
+                + "&client_secret=" + urlEncode(secret)
+                + "&scope=" + urlEncode("https://attest.azure.net/.default")
+                + "&grant_type=client_credentials";
+            HttpResult tokenHttp = httpRequest(
+                authority + "/" + tenant + "/oauth2/v2.0/token",
+                &tokenBody,
+                {"Content-Type: application/x-www-form-urlencoded"});
+            if (!tokenHttp.error.empty()) {
+                result.detail = "azure login failed: " + tokenHttp.error;
+                return result;
+            }
+            if (tokenHttp.status != 200) {
+                result.detail = "azure login returned HTTP " + std::to_string(tokenHttp.status) + " " + briefBody(tokenHttp.body);
+                return result;
+            }
+            nlohmann::json tokenJson = nlohmann::json::parse(tokenHttp.body);
+            if (!tokenJson.contains("access_token") || !tokenJson["access_token"].is_string()) {
+                result.detail = "azure login response has no access token";
+                return result;
+            }
+            const std::string accessToken = tokenJson["access_token"].get<std::string>();
+
+            nlohmann::json request = {
+                {"quote", base64UrlEncode(quote)},
+                {"runtimeData", {{"data", base64UrlEncode(pem)}, {"dataType", "Binary"}}},
+            };
+            std::string requestBody = request.dump();
+            HttpResult attestHttp = httpRequest(
+                endpoint + "/attest/SgxEnclave?api-version=2025-06-01",
+                &requestBody,
+                {
+                    "Content-Type: application/json",
+                    "Authorization: Bearer " + accessToken,
+                });
+            if (!attestHttp.error.empty()) {
+                result.detail = "azure attestation failed: " + attestHttp.error;
+                return result;
+            }
+            if (attestHttp.status != 200) {
+                result.detail = "azure attestation returned HTTP " + std::to_string(attestHttp.status) + " " + briefBody(attestHttp.body);
+                return result;
+            }
+            nlohmann::json attestJson = nlohmann::json::parse(attestHttp.body);
+            if (!attestJson.contains("token") || !attestJson["token"].is_string()) {
+                result.detail = "azure attestation response has no token";
+                return result;
+            }
+
+            HttpResult certsHttp = httpRequest(endpoint + "/certs", nullptr, {"Accept: application/json"});
+            if (!certsHttp.error.empty()) {
+                result.detail = "azure attestation keys failed: " + certsHttp.error;
+                return result;
+            }
+            if (certsHttp.status != 200) {
+                result.detail = "azure attestation keys returned HTTP " + std::to_string(certsHttp.status);
+                return result;
+            }
+
+            std::string tokenError = validateAttestationToken(
+                attestJson["token"].get<std::string>(),
+                endpoint,
+                nlohmann::json::parse(certsHttp.body));
+            if (!tokenError.empty()) {
+                result.detail = tokenError;
+                return result;
+            }
+
+            result.ok = true;
+            result.detail = azureSimulate()
+                ? "azure attestation accepted the quote (simulation)"
+                : "azure attestation accepted the quote";
+            return result;
+        } catch (const std::exception & e) {
+            result.ok = false;
+            result.detail = e.what();
+            return result;
+        }
+    }
+
+    } // namespace
+
+    CertificateVerifier::CertificateVerifier(
+        std::filesystem::path outputFolder, nlohmann::json expectedManifest, std::string narHashHex)
+        : _output_folder(std::move(outputFolder))
+        , _nar_hash_hex(std::move(narHashHex))
+    {
+        if(!expectedManifest.contains("EXPECTED_DUET_ADMIN_MRENCLAVE") || !expectedManifest.contains("EXPECTED_DUET_SERVICE_INFO"))
+        {
+            throw std::invalid_argument("Expected manifest must contain either EXPECTED_DUET_ADMIN_MRENCLAVE or EXPECTED_DUET_SERVICE_INFO");
+        }
+
+        _expectedMRENCLAVE = expectedManifest["EXPECTED_DUET_ADMIN_MRENCLAVE"].get<std::string>();
+        _expectedServiceInfo = expectedManifest["EXPECTED_DUET_SERVICE_INFO"];
+    }
+    std::expected<VerificationResult, std::string> CertificateVerifier::verifyCertificate(const nlohmann::json & certificate, 
+                                                                                          std::string_view quoteProvider)
+    {
+        if (quoteProvider != "azure")
+            return std::unexpected("Other SGX quote providers are not yet supported.");
+
+        VerificationResult report;
+        StepResult quoteStep;
+        quoteStep.name = "01_duet_admin_quote";
+        bool azureOk = false;
+
+        if (!certificate.contains("duet_admin_quote")
+            || !certificate["duet_admin_quote"].contains("quote")
+            || !certificate["duet_admin_quote"].contains("public_key")) {
+            quoteStep.detail = "quote or public key is missing";
+        } else {
+            std::string quote = base64Decode(certificate["duet_admin_quote"]["quote"].get<std::string>());
+            std::string pem = certificate["duet_admin_quote"]["public_key"].get<std::string>();
+            if (!certificate.contains("duet_admin_attestation_service_url")
+                || !certificate["duet_admin_attestation_service_url"].is_string()
+                || certificate["duet_admin_attestation_service_url"].get<std::string>().empty()) {
+                quoteStep.detail = "attestation service url is missing";
+            } else {
+                AzureResult azure = attestSgxEnclave(
+                    certificate["duet_admin_attestation_service_url"].get<std::string>(),
+                    quote,
+                    pem);
+                azureOk = azure.ok;
+                quoteStep.detail = azure.detail;
+            }
+            if (quote.size() < 400) {
+                quoteStep.detail += "\nquote is shorter than 400 bytes";
+            } else {
+                bool keyOk = sliceHex(quote, 368) == sha256hex(pem);
+                bool mrOk = sliceHex(quote, 112) == _expectedMRENCLAVE;
+                quoteStep.detail += keyOk ? "\npublic key hash matches quote report_data"
+                                        : "\npublic key hash does not match quote report_data";
+                quoteStep.detail += mrOk ? "\nmrenclave matches" : "\nmrenclave does not match";
+
+                bool jwtOk = azureSimulate();
+                if (!jwtOk) {
+                    if (!certificate["duet_admin_quote"].contains("jwt")
+                        || !certificate["duet_admin_quote"]["jwt"].is_string()) {
+                        quoteStep.detail += "\nadmin jwt is missing";
+                    } else {
+                        std::string jwtError = verifyEmbeddedAdminJwt(
+                            certificate["duet_admin_quote"]["jwt"].get<std::string>(),
+                            certificate["duet_admin_attestation_service_url"].get<std::string>(),
+                            quote,
+                            pem,
+                            _expectedMRENCLAVE);
+                        jwtOk = jwtError.empty();
+                        quoteStep.detail += jwtOk
+                            ? "\nadmin jwt matches the quote and the manifest"
+                            : "\n" + jwtError;
+                    }
+                }
+                quoteStep.ok = azureOk && keyOk && mrOk && jwtOk;
+            }
+        }
+        report.steps.push_back(quoteStep);
+
+        StepResult step;
+        step.name = "02_controller_signature";
+
+        if (!certificate.contains("duet_admin_signature")
+            || !certificate.contains("duet_service_result")
+            || !certificate.contains("duet_admin_quote")
+            || !certificate["duet_admin_quote"].contains("public_key")) {
+            step.detail = "certificate is missing the signature, the service result, or the public key";
+            report.steps.push_back(step);
+        }
+
+        std::string signature = base64Decode(certificate["duet_admin_signature"].get<std::string>());
+        std::string message = canonicalJson(certificate["duet_service_result"]);
+        std::string publicKey = certificate["duet_admin_quote"]["public_key"].get<std::string>();
+
+        step.ok = !signature.empty() && verifyPss(signature, message, publicKey);
+        step.detail = step.ok ? "signature matches" : "signature does not match";
+        report.steps.push_back(step);
+
+        const auto & serviceResult = certificate["duet_service_result"];
+
+        StepResult serviceStep;
+        serviceStep.name = "03_duet_service_info";
+
+        if (!serviceResult.contains("service_info") || !serviceResult["service_info"].is_object()) {
+            serviceStep.detail = "service_info is missing";
+        } else {
+            const auto & info = serviceResult["service_info"];
+            const bool codeOk = info.contains("service_code_hash")
+                && info["service_code_hash"] == _expectedServiceInfo["service_code_hash"];
+            const bool toolsOk = info.contains("service_tools_hashes")
+                && info["service_tools_hashes"] == _expectedServiceInfo["service_tools_hashes"];
+
+            bool dependencyOk = false;
+            if (info.contains("service_dependencies_hash")
+                && _expectedServiceInfo.contains("service_dependencies_hash")) {
+                for (auto it = _expectedServiceInfo["service_dependencies_hash"].begin();
+                    it != _expectedServiceInfo["service_dependencies_hash"].end();
+                    ++it) {
+                    if (it.value() == info["service_dependencies_hash"])
+                        dependencyOk = true;
+                }
+            }
+
+            serviceStep.ok = codeOk && toolsOk && dependencyOk;
+            serviceStep.detail = serviceStep.ok ? "service info matches" : "service info does not match";
+        }
+        report.steps.push_back(serviceStep);
+
+        StepResult outputStep;
+        outputStep.name = "05_output_hashes";
+
+        if (_nar_hash_hex.empty() && _output_folder.empty()) {
+            outputStep.ok = true;
+            outputStep.detail = "NAR bytes are not on this machine yet";
+        } else if (!serviceResult.contains("service_result")
+            || !serviceResult["service_result"].contains("hashes")
+            || !serviceResult["service_result"]["hashes"].contains("outputs")) {
+            outputStep.detail = "output hashes are missing";
+        } else {
+            const auto & outputs = serviceResult["service_result"]["hashes"]["outputs"];
+            bool allOk = !_nar_hash_hex.empty();
+            bool sawNar = false;
+            if (_nar_hash_hex.empty())
+                outputStep.detail += "NAR sha256 is not available yet\n";
+            for (auto it = outputs.begin(); it != outputs.end(); ++it) {
+                const auto key = it.key();
+                const auto want = it.value().get<std::string>();
+                if (key.size() >= 4 && key.ends_with(".nar")) {
+                    sawNar = true;
+                    bool match = want == _nar_hash_hex;
+                    allOk = allOk && match;
+                    outputStep.detail += "NAR file " + key + "\n";
+                    outputStep.detail += "sha256 of retrieved NAR " + _nar_hash_hex + "\n";
+                    outputStep.detail += "certificate sha256 " + want + "\n";
+                    outputStep.detail += match ? "NAR sha256 matches the certificate\n" : "NAR sha256 does not match the certificate\n";
+                    continue;
+                }
+                if (_output_folder.empty())
+                    continue;
+                std::filesystem::path file = _output_folder / key;
+                std::ifstream in(file, std::ios::binary);
+                if (!in.good())
+                    continue;
+                std::string data((std::istreambuf_iterator<char>(in)), {});
+                bool match = sha256hex(data) == want;
+                allOk = allOk && match;
+                outputStep.detail += key;
+                outputStep.detail += match ? " matches\n" : " does not match\n";
+            }
+            if (!sawNar) {
+                allOk = false;
+                outputStep.detail += "no .nar output hash in the certificate\n";
+            }
+            outputStep.ok = allOk;
+        }
+        report.steps.push_back(outputStep);
+        report.ok = quoteStep.ok && step.ok && serviceStep.ok && outputStep.ok;
+        return report;
+    }
+}
