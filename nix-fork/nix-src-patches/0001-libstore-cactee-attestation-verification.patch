index 0000000000000000000000000000000000000000..7682a9a811fd0fe7c108dd36d2f9cbd3d4026180
--- /dev/null
+++ b/src/certification-verification/smoke-test.cc
@@ -0,0 +1,61 @@
+#include "certificate-verifier.hh"
+
+#include <iostream>
+#include <stdexcept>
+
+int main()
+{
+    nlohmann::json manifest = {
+        {"EXPECTED_DUET_ADMIN_MRENCLAVE", "ab"},
+        {"EXPECTED_DUET_SERVICE_INFO",
+         {{"service_code_hash", "code"},
+          {"service_tools_hashes", {{"tool", "hash"}}},
+          {"service_dependencies_hash", {{"cpu", "dep"}}}}},
+    };
+
+    bool threw = false;
+    try {
+        certificate_verifier::CertificateVerifier(std::filesystem::path{}, nlohmann::json::object());
+    } catch (const std::invalid_argument &) {
+        threw = true;
+    }
+    if (!threw) {
+        std::cerr << "manifest without the two keys was accepted\n";
+        return 1;
+    }
+
+    certificate_verifier::CertificateVerifier verifier(std::filesystem::path{}, manifest);
+
+    auto rejected = verifier.verifyCertificate(nlohmann::json::object(), "other");
+    if (rejected)
+        return 1;
+
+    nlohmann::json certificate = {
+        {"duet_admin_quote", {{"quote", "YQ=="}, {"public_key", "not-a-key"}}},
+        {"duet_admin_signature", "YQ=="},
+        {"duet_service_result",
+         {{"service_info",
+           {{"service_code_hash", "nope"},
+            {"service_tools_hashes", nlohmann::json::object()},
+            {"service_dependencies_hash", "nope"}}}}},
+    };
+
+    auto report = verifier.verifyCertificate(certificate, "azure");
+    if (!report) {
+        std::cerr << report.error() << "\n";
+        return 1;
+    }
+    if (report->ok) {
+        std::cerr << "report was accepted\n";
+        return 1;
+    }
+    if (report->steps.size() != 4) {
+        std::cerr << "expected 4 steps, got " << report->steps.size() << "\n";
+        return 1;
+    }
+
+    std::cout << "smoke ok\n";
+    for (const auto & step : report->steps)
+        std::cout << step.name << (step.ok ? " ok" : " fail") << "\n" << step.detail << "\n";
+    return 0;
+}
diff --git a/src/certification-verification/smoke.sh b/src/certification-verification/smoke.sh
