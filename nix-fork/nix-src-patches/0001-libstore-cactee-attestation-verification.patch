@@ -0,0 +1,557 @@
+#include "nix/store/attestation.hh"
+
+#include "nix/store/binary-cache-store.hh"
+#include "nix/store/local-fs-store.hh"
+#include "nix/store/build-result.hh"
+#include "nix/store/globals.hh"
+#include "nix/util/file-system.hh"
+#include "nix/util/hash.hh"
+#include "nix/util/logging.hh"
+#include "nix/util/strings.hh"
+
+#include "../certification-verification/Include/certificate-verifier.hh"
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <optional>
+#include <stdexcept>
+#include <vector>
+
+namespace nix {
+
+static std::string sriFileStem(const std::string & narHashSri)
+{
+    std::string s = narHashSri;
+    std::replace(s.begin(), s.end(), '/', '_');
+    return s;
+}
+
+static std::optional<std::pair<std::string, std::string>>
+readLocalAttestationSidecar(Store & srcStore, const StorePath & path);
+
+static void verifyInputCertificate(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & inputPath,
+    const std::string & narHashSri,
+    const std::list<ref<Store>> & substituters);
+
+std::filesystem::path attestationCertPath(const AttestationSettings & settings, const std::string & narHashSri)
+{
+    return std::filesystem::path(settings.attestationStore.get()) / (sriFileStem(narHashSri) + ".json");
+}
+
+static bool isCacteeCertificate(const nlohmann::json & cert)
+{
+    return cert.contains("duet_admin_quote") || cert.contains("duet_service_result");
+}
+
+static std::string sha256HexOfNar(Store & store, const StorePath & path)
+{
+    HashSink sink(HashAlgorithm::SHA256);
+    store.narFromPath(path, sink);
+    return sink.finish().hash.to_string(HashFormat::Base16, false);
+}
+
+/* Certificate key is the store path with "/nix/store/" removed, plus ".nar". */
+static std::string narFileName(const StorePath & path)
+{
+    return std::string(path.hashPart()) + "-" + std::string(path.name()) + ".nar";
+}
+
+static void logNarHashCheck(
+    const StorePath & path,
+    const nlohmann::json & cert,
+    const std::string & narHashHex,
+    bool hashedBytes)
+{
+    auto narFile = narFileName(path);
+    auto stripped = narFile.substr(0, narFile.size() - 4);
+    notice("attestation: store path without /nix/store/: %s", stripped);
+    if (hashedBytes)
+        notice("attestation: sha256sum of retrieved NAR %s is %s", narFile, narHashHex);
+    else
+        notice(
+            "attestation: NAR %s is not retrieved yet; narinfo sha256 is %s",
+            narFile,
+            narHashHex);
+
+    std::string certHash;
+    try {
+        const auto & outputs = cert.at("duet_service_result").at("service_result").at("hashes").at("outputs");
+        if (outputs.contains(narFile) && outputs.at(narFile).is_string())
+            certHash = outputs.at(narFile).get<std::string>();
+    } catch (const nlohmann::json::exception &) {
+    }
+    if (certHash.empty())
+        notice("attestation: certificate has no sha256 for %s", narFile);
+    else
+        notice(
+            "attestation: certificate %s sha256 is %s (%s)",
+            narFile,
+            certHash,
+            certHash == narHashHex ? "match" : "mismatch");
+}
+
+static void verifyCacteeCertificate(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & path,
+    const nlohmann::json & cert,
+    const std::string & claimedNarHashHex)
+{
+    auto manifestPath = settings.attestationCacteeManifest.get();
+    if (manifestPath.empty())
+        throw Error(
+            "refusing '%s': CACTEE certificate requires attestation-cactee-manifest "
+            "(EXPECTED_DUET_ADMIN_MRENCLAVE and EXPECTED_DUET_SERVICE_INFO)",
+            store.printStorePath(path));
+
+    /* Code, inputs, and build args are not on the client. The output is
+       this NAR's store path, and only after the path is in the store. */
+    std::filesystem::path outputFolder;
+    std::string narHashHex = claimedNarHashHex;
+    if (store.isValidPath(path)) {
+        if (auto * local = dynamic_cast<LocalFSStore *>(&store))
+            outputFolder = local->toRealPath(path);
+        /* Path is already in the store, or the download just finished.
+           Hash the NAR bytes again and compare that digest. */
+        narHashHex = sha256HexOfNar(store, path);
+    }
+    logNarHashCheck(path, cert, narHashHex, store.isValidPath(path));
+
+    std::expected<certificate_verifier::VerificationResult, std::string> report;
+    try {
+        nlohmann::json manifest = nlohmann::json::parse(readFile(manifestPath));
+        certificate_verifier::CertificateVerifier verifier(outputFolder, std::move(manifest), narHashHex);
+        report = verifier.verifyCertificate(cert, "azure");
+    } catch (const std::exception & e) {
+        throw Error("CACTEE certificate for '%s': %s", store.printStorePath(path), e.what());
+    }
+    if (!report)
+        throw Error("CACTEE certificate for '%s': %s", store.printStorePath(path), report.error());
+
+    for (auto & step : report->steps) {
+        auto detail = step.detail;
+        for (char & c : detail)
+            if (c == '\n')
+                c = ' ';
+        notice(
+            "attestation: %s %s%s%s",
+            step.name,
+            step.ok ? "ok" : "fail",
+            detail.empty() ? "" : " — ",
+            detail.c_str());
+    }
+
+    if (report->ok)
+        return;
+
+    std::string details;
+    for (auto & step : report->steps) {
+        details += step.name;
+        details += step.ok ? " ok\n" : " fail\n";
+        if (!step.detail.empty())
+            details += step.detail + "\n";
+    }
+    throw Error(
+        "refusing '%s': CACTEE certificate verification failed\n%s",
+        store.printStorePath(path),
+        details);
+}
+
+static void tryFetchFileFromSubstituters(
+    const std::list<ref<Store>> & substituters, const std::vector<std::string> & names, const std::filesystem::path & dest)
+{
+    for (auto & sub : substituters) {
+        auto * cache = dynamic_cast<BinaryCacheStore *>(&*sub);
+        if (!cache)
+            continue;
+        for (auto & name : names) {
+            try {
+                auto data = cache->getFile(name);
+                if (!data)
+                    continue;
+                std::filesystem::create_directories(dest.parent_path());
+                writeFile(dest, *data);
+                notice(
+                    "attestation: fetched '%s' from substituter '%s' -> %s",
+                    name,
+                    cache->config.getHumanReadableURI(),
+                    dest.string());
+                return;
+            } catch (Error &) {
+                continue;
+            }
+        }
+    }
+}
+
+static void tryFetchCertFromSubstituters(
+    const std::list<ref<Store>> & substituters,
+    const StorePath & inputPath,
+    const std::string & narHashSri,
+    const std::filesystem::path & dest)
+{
+    auto hashPart = std::string(inputPath.hashPart());
+    auto stem = sriFileStem(narHashSri);
+    tryFetchFileFromSubstituters(
+        substituters,
+        {
+            hashPart + ".attestation.json",
+            stem + ".json",
+            stem + "_asset_certificate.json",
+        },
+        dest);
+}
+
+static std::optional<std::pair<std::string, std::string>> fetchSidecarFromBinaryCache(
+    BinaryCacheStore & cache, const StorePath & path, const std::string & narHashSri)
+{
+    auto hashPart = std::string(path.hashPart());
+    auto stem = sriFileStem(narHashSri);
+    std::optional<std::string> json;
+    for (auto & name : {
+             hashPart + ".attestation.json",
+             stem + ".json",
+             stem + "_asset_certificate.json",
+         }) {
+        json = cache.getFile(name);
+        if (json) {
+            notice(
+                "attestation: fetched '%s' from substituter '%s'",
+                name,
+                cache.config.getHumanReadableURI());
+            break;
+        }
+    }
+    if (!json)
+        return std::nullopt;
+    return std::make_pair(std::move(*json), std::string{});
+}
+
+static std::shared_ptr<const ValidPathInfo> pathInfoFromStoreOrSubstituters(
+    Store & store, const StorePath & inputPath, const std::list<ref<Store>> & substituters)
+{
+    if (store.isValidPath(inputPath))
+        return store.queryPathInfo(inputPath).get_ptr();
+
+    for (auto & sub : substituters) {
+        try {
+            return sub->queryPathInfo(inputPath).get_ptr();
+        } catch (InvalidPath &) {
+            continue;
+        } catch (Error &) {
+            continue;
+        }
+    }
+    return nullptr;
+}
+
+static void walkNarinfoClosureAttestations(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & path,
+    const std::list<ref<Store>> & substituters,
+    StorePathSet & visiting,
+    StorePathSet & done)
+{
+    if (done.count(path))
+        return;
+    if (store.isValidPath(path)) {
+        done.insert(path);
+        return;
+    }
+    if (visiting.count(path))
+        return;
+
+    auto info = pathInfoFromStoreOrSubstituters(store, path, substituters);
+    if (!info) {
+        /* Not in the store and not on a cache — will be built later. */
+        done.insert(path);
+        return;
+    }
+
+    visiting.insert(path);
+    for (auto & ref : info->references)
+        if (ref != path)
+            walkNarinfoClosureAttestations(store, settings, ref, substituters, visiting, done);
+    visiting.erase(path);
+
+    auto narHashSri = info->narHash.to_string(HashFormat::SRI, true);
+    verifyInputCertificate(store, settings, path, narHashSri, substituters);
+    done.insert(path);
+}
+
+void verifyPathClosureAttestations(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & root,
+    const std::list<ref<Store>> & substituters,
+    StorePathSet & alreadyVerified)
+{
+    /* The certifying container sets require-attestation = false. Certificate
+       checks run on the client, which has the cert volume and the manifest. */
+    if (!settings.requireAttestation.get())
+        return;
+
+    if (substituters.empty())
+        notice(
+            "attestation: no substituters set (this fork does not use cache.nixos.org); "
+            "set substituters to your Harmonia URL in nix.conf");
+    else {
+        for (auto & sub : substituters)
+            notice("attestation: substituter '%s'", sub->config.getHumanReadableURI());
+    }
+
+    auto before = alreadyVerified.size();
+    StorePathSet visiting;
+    walkNarinfoClosureAttestations(store, settings, root, substituters, visiting, alreadyVerified);
+    auto n = alreadyVerified.size() - before;
+    if (n > 0)
+        notice(
+            "attestation: preflight done — %d store path(s), leaves-first JSON certificates verified "
+            "before NAR download or build",
+            n);
+}
+
+static void verifyInputCertificate(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & inputPath,
+    const std::string & narHashSri,
+    const std::list<ref<Store>> & substituters)
+{
+    if (settings.attestationBootstrapInputs.get().count(narHashSri)) {
+        notice(
+            "attestation: skip JSON certificate for bootstrap '%s' (narHash %s)",
+            store.printStorePath(inputPath),
+            narHashSri);
+        return;
+    }
+
+    auto certPath = attestationCertPath(settings, narHashSri);
+    /* Harmonia keeps the published JSON as <store-hash>.json in this directory. */
+    auto sharedCert = std::filesystem::path("/var/lib/nix-certification")
+        / (std::string(inputPath.hashPart()) + ".json");
+    if (!std::filesystem::exists(certPath) && std::filesystem::exists(sharedCert)) {
+        std::filesystem::create_directories(certPath.parent_path());
+        std::filesystem::copy_file(
+            sharedCert, certPath, std::filesystem::copy_options::overwrite_existing);
+        notice(
+            "attestation: read certificate for '%s' from Harmonia directory %s",
+            store.printStorePath(inputPath),
+            sharedCert.string());
+    }
+    tryFetchCertFromSubstituters(substituters, inputPath, narHashSri, certPath);
+
+    if (!std::filesystem::exists(certPath))
+        throw BuildError(
+            BuildResult::Failure::InputRejected,
+            "input '%s' (NAR hash %s) has no attestation certificate at '%s' "
+            "(and none was found on substituters as %s.attestation.json)",
+            store.printStorePath(inputPath),
+            narHashSri,
+            certPath.string(),
+            std::string(inputPath.hashPart()));
+
+    auto certJson = nlohmann::json::parse(readFile(certPath));
+    if (!isCacteeCertificate(certJson))
+        throw BuildError(
+            BuildResult::Failure::InputRejected,
+            "certificate for '%s' is not a CACTEE asset certificate",
+            store.printStorePath(inputPath));
+    verifyCacteeCertificate(
+        store, settings, inputPath, certJson, Hash::parseSRI(narHashSri).to_string(HashFormat::Base16, false));
+    notice(
+        "attestation: JSON certificate verified for '%s' (narHash %s)",
+        store.printStorePath(inputPath),
+        narHashSri);
+}
+
+void verifyPathAttestation(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & path,
+    const std::string & narHashSri,
+    const std::list<ref<Store>> & substituters)
+{
+    if (!settings.requireAttestation.get())
+        return;
+    verifyInputCertificate(store, settings, path, narHashSri, substituters);
+}
+
+void verifyDirectInputAttestations(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & drvPath,
+    const BasicDerivation & drv,
+    const std::list<ref<Store>> & substituters,
+    StorePathSet * alreadyVerified)
+{
+    if (!settings.requireAttestation.get())
+        return;
+
+    debug("preflight attestation closure for '%s'", store.printStorePath(drvPath));
+
+    StorePathSet localDone;
+    StorePathSet & done = alreadyVerified ? *alreadyVerified : localDone;
+
+    for (auto & inputPath : drv.inputs)
+        verifyPathClosureAttestations(store, settings, inputPath, substituters, done);
+}
+
+void installAttestationSidecar(
+    Store & store, const StorePath & path, const Hash & narHash, std::string_view json, std::string_view sig)
+{
+    /* Client cache only. Do not write a Harmonia drop directory or a .sig. */
+    (void) store;
+    (void) path;
+    (void) sig;
+    auto narHashSri = narHash.to_string(HashFormat::SRI, true);
+    auto dest = attestationCertPath(settings.getAttestationSettings(), narHashSri);
+    std::filesystem::create_directories(dest.parent_path());
+    writeFile(dest, json);
+}
+
+void verifyIncomingAttestation(
+    Store & store,
+    const AttestationSettings & settings,
+    const StorePath & path,
+    const Hash & narHash,
+    std::string_view json,
+    std::string_view sig)
+{
+    (void) sig;
+    auto narHashSri = narHash.to_string(HashFormat::SRI, true);
+    if (settings.attestationBootstrapInputs.get().count(narHashSri))
+        return;
+
+    auto certJson = nlohmann::json::parse(std::string{json});
+    if (!isCacteeCertificate(certJson))
+        throw Error(
+            "certificate for '%s' is not a CACTEE asset certificate",
+            store.printStorePath(path));
+    verifyCacteeCertificate(
+        store, settings, path, certJson, narHash.to_string(HashFormat::Base16, false));
+}
+
+void requireIncomingAttestationSidecar(
+    Store & store, const AttestationSettings & settings, const StorePath & path, const Hash & narHash)
+{
+    auto narHashSri = narHash.to_string(HashFormat::SRI, true);
+    if (settings.attestationBootstrapInputs.get().count(narHashSri))
+        return;
+
+    auto sidecar = readLocalAttestationSidecar(store, path);
+    if (!sidecar)
+        throw Error(
+            "refusing to import '%s' (NAR hash %s): no {hashPart}.attestation.json "
+            "was received (or verified) before the NAR",
+            store.printStorePath(path),
+            narHashSri);
+
+    verifyIncomingAttestation(store, settings, path, narHash, sidecar->first, sidecar->second);
+}
+
+void copyAttestationSidecar(Store & srcStore, Store & dstStore, const StorePath & path)
+{
+    if (&srcStore == &dstStore)
+        return;
+
+    auto & att = settings.getAttestationSettings();
+    Hash narHash = srcStore.queryPathInfo(path)->narHash;
+    auto narHashSri = narHash.to_string(HashFormat::SRI, true);
+    bool bootstrap = att.attestationBootstrapInputs.get().count(narHashSri);
+    auto sidecar = std::optional<std::pair<std::string, std::string>>{};
+    /* HTTP: GET {hashPart}.attestation.json; do not reuse a shared NAR-hash SRI file. */
+    if (auto * cache = dynamic_cast<BinaryCacheStore *>(&srcStore))
+        sidecar = fetchSidecarFromBinaryCache(*cache, path, narHashSri);
+    if (!sidecar)
+        sidecar = readLocalAttestationSidecar(srcStore, path);
+    if (!sidecar) {
+        auto sharedCert = std::filesystem::path("/var/lib/nix-certification")
+            / (std::string(path.hashPart()) + ".json");
+        if (std::filesystem::exists(sharedCert)) {
+            notice(
+                "attestation: read certificate for '%s' from Harmonia directory %s",
+                srcStore.printStorePath(path),
+                sharedCert.string());
+            sidecar = std::make_pair(readFile(sharedCert), std::string{});
+        }
+    }
+
+    bool haveJson = sidecar && !sidecar->first.empty();
+
+    if (!haveJson) {
+        if (bootstrap || !att.requireAttestation.get())
+            return;
+        throw Error(
+            "refusing to copy '%s': no CACTEE certificate for this path on '%s'",
+            srcStore.printStorePath(path),
+            srcStore.config.getHumanReadableURI());
+    }
+
+    verifyIncomingAttestation(dstStore, att, path, narHash, sidecar->first, sidecar->second);
+    auto dest = attestationCertPath(att, narHashSri);
+    std::filesystem::create_directories(dest.parent_path());
+    writeFile(dest, sidecar->first);
+}
+
+static std::optional<std::pair<std::string, std::string>>
+readLocalAttestationSidecar(Store & srcStore, const StorePath & path)
+{
+    auto & attSettings = settings.getAttestationSettings();
+    auto hashPart = std::string(path.hashPart());
+    auto storeDir = std::filesystem::path(attSettings.attestationStore.get());
+
+    std::vector<std::filesystem::path> jsonCandidates;
+    jsonCandidates.push_back(storeDir / (hashPart + ".attestation.json"));
+
+    std::filesystem::path jsonPath;
+    for (auto & p : jsonCandidates) {
+        if (std::filesystem::exists(p)) {
+            jsonPath = p;
+            break;
+        }
+    }
+    if (jsonPath.empty())
+        return std::nullopt;
+
+    auto json = readFile(jsonPath);
+    auto jsonName = jsonPath.filename().string();
+    std::vector<std::filesystem::path> sigCandidates;
+    if (jsonName.ends_with(".attestation.json"))
+        sigCandidates.push_back(jsonPath.parent_path() / (hashPart + ".attestation.sig"));
+    sigCandidates.push_back(std::filesystem::path(jsonPath.string() + ".sig"));
+
+    std::string sig;
+    for (auto & p : sigCandidates) {
+        if (std::filesystem::exists(p)) {
+            sig = readFile(p);
+            break;
+        }
+    }
+    return std::make_pair(std::move(json), std::move(sig));
+}
+
+void bindAttestationSidecarFromDisk(Store & store, const StorePath & path, const Hash & narHash)
+{
+    auto sidecar = readLocalAttestationSidecar(store, path);
+    auto & att = settings.getAttestationSettings();
+    auto narHashSri = narHash.to_string(HashFormat::SRI, true);
+    if (!sidecar) {
+        if (att.requireAttestation.get() && !att.attestationBootstrapInputs.get().count(narHashSri))
+            throw Error(
+                "cannot bind attestation for '%s' (NAR hash %s): no CACTEE certificate "
+                "in attestation-store",
+                store.printStorePath(path),
+                narHashSri);
+        return;
+    }
+    verifyIncomingAttestation(store, att, path, narHash, sidecar->first, sidecar->second);
+    installAttestationSidecar(store, path, narHash, sidecar->first, sidecar->second);
+}
+
+} // namespace nix
