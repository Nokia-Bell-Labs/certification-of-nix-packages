--- /dev/null
+++ b/src/certification-verification/main.cc
@@ -0,0 +1,32 @@
+#include "Include/certificate-verifier.hh"
+
+#include <fstream>
+#include <iostream>
+
+int main(int argc, char ** argv)
+{
+    if (argc != 4) {
+        std::cerr << "usage: verify <certificate.json> <manifest.json> <output-folder>\n";
+        return 2;
+    }
+
+    std::ifstream certificateFile(argv[1]);
+    std::ifstream manifestFile(argv[2]);
+    nlohmann::json certificate = nlohmann::json::parse(certificateFile);
+    nlohmann::json manifest = nlohmann::json::parse(manifestFile);
+
+    certificate_verifier::CertificateVerifier verifier(argv[3], manifest);
+
+    auto report = verifier.verifyCertificate(certificate, "azure");
+    if (!report) {
+        std::cerr << report.error() << "\n";
+        return 2;
+    }
+
+    for (const auto & step : report->steps) {
+        std::cout << step.name << (step.ok ? " ok" : " fail") << "\n";
+        std::cout << step.detail << "\n";
+    }
+    std::cout << (report->ok ? "certificate ok\n" : "certificate not ok\n");
+    return report->ok ? 0 : 1;
+}
