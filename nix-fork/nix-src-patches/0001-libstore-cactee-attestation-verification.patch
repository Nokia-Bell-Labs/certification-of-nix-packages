+namespace certificate_verifier{
+    std::string sha256hex(std::string_view data)
+    {
+        unsigned char digest[EVP_MAX_MD_SIZE];
+        unsigned int digest_len = 0;
+
+        if(!EVP_Digest(data.data(), data.size(), digest, &digest_len, EVP_sha256(), nullptr)){
+            throw std::runtime_error("Failed to compute Digest");
+        }
+        std::string output(digest_len * 2, '\0');
+        std::string hex = "0123456789abcdef";
+        for (unsigned int i = 0; i < digest_len; ++i)
+        {
+            output[i * 2] = hex[digest[i] >> 4];
+            output[i * 2 + 1] = hex[digest[i] & 0x0f];
+
+        }
+        return output;
+    }
+    std::string sliceHex(const std::string & quote, std::size_t offset)
+    {
+        const char hex[] = "0123456789abcdef";
+        std::string out(64, '\0');
+        for (std::size_t i = 0; i < 32; ++i) {
+            unsigned char byte = static_cast<unsigned char>(quote[offset + i]);
+            out[i * 2] = hex[byte >> 4];
+            out[i * 2 + 1] = hex[byte & 0x0f];
+        }
+        return out;
+    }
+    // Canonical JSON serialization
+    std::string quoteJsonString(const std::string & text)
+    {
+        std::string out = "\"";
+        for (unsigned char c : text) {
+            if (c == '"')
+                out += "\\\"";
+            else if (c == '\\')
+                out += "\\\\";
+            else if (c == '\n')
+                out += "\\n";
+            else if (c == '\r')
+                out += "\\r";
+            else if (c == '\t')
+                out += "\\t";
+            else
+                out += static_cast<char>(c);
+        }
+        out += '"';
+        return out;
+    }
+    std::string canonicalJson(const nlohmann::json & value)
+    {
+        if (value.is_null())
+            return "null";
+        if (value.is_boolean())
+            return value.get<bool>() ? "true" : "false";
+        if (value.is_number())
+            return value.dump();
+        if (value.is_string())
+            return quoteJsonString(value.get<std::string>());
+        if (value.is_array()) {
+            std::string out = "[";
+            for (std::size_t i = 0; i < value.size(); ++i) {
+                if (i != 0)
+                    out += ", ";
+                out += canonicalJson(value[i]);
+            }
+            out += "]";
+            return out;
+        }
+        std::vector<std::string> keys;
+        for (auto it = value.begin(); it != value.end(); ++it)
+            keys.push_back(it.key());
+        std::sort(keys.begin(), keys.end());
+        std::string out = "{";
+        for (std::size_t i = 0; i < keys.size(); ++i) {
+            if (i != 0)
+                out += ", ";
+            out += quoteJsonString(keys[i]);
+            out += ": ";
+            out += canonicalJson(value[keys[i]]);
+        }
+        out += "}";
+        return out;
+    }
+    bool verifyPss(std::string_view signature, std::string_view message, std::string_view publicKeyPem)
+    {
+        BIO *bio = BIO_new_mem_buf(publicKeyPem.data(), static_cast<int>(publicKeyPem.size()));
+        if (!bio)
+            throw std::runtime_error("OpenSSL BIO failed");
+
+        EVP_PKEY *key = PEM_read_bio_PUBKEY(bio, nullptr, nullptr, nullptr);
+        BIO_free(bio);
+        if (!key)
+            return false;
+
+        EVP_MD_CTX *ctx = EVP_MD_CTX_new();
+        EVP_PKEY_CTX *keyCtx = nullptr;
+        if (!ctx) {
+            EVP_PKEY_free(key);
+            throw std::runtime_error("OpenSSL context failed");
+        }
+
+        const bool ok =
+            EVP_DigestVerifyInit(ctx, &keyCtx, EVP_sha256(), nullptr, key) == 1
+            && EVP_PKEY_CTX_set_rsa_padding(keyCtx, RSA_PKCS1_PSS_PADDING) == 1
+            && EVP_PKEY_CTX_set_rsa_mgf1_md(keyCtx, EVP_sha256()) == 1
+            && EVP_PKEY_CTX_set_rsa_pss_saltlen(keyCtx, RSA_PSS_SALTLEN_MAX) == 1
+            && EVP_DigestVerifyUpdate(ctx, message.data(), message.size()) == 1
+            && EVP_DigestVerifyFinal(
+                ctx,
+                reinterpret_cast<const unsigned char *>(signature.data()),
+                signature.size()) == 1;
+
+        EVP_MD_CTX_free(ctx);
+        EVP_PKEY_free(key);
+        return ok;
+    }
+    
+    std::string base64Decode(std::string_view in)
+    {
+        auto value = [](char c) -> int {
+            if (c >= 'A' && c <= 'Z') return c - 'A';
+            if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+            if (c >= '0' && c <= '9') return c - '0' + 52;
+            if (c == '+') return 62;
+            if (c == '/') return 63;
+            return -1;
+        };
+
+        std::string filtered;
+        for (char c : in)
+            if (c == '=' || value(c) >= 0)
+                filtered.push_back(c);
+        if (filtered.size() % 4 != 0)
+            return {};
+
+        std::string out;
+        for (std::size_t i = 0; i < filtered.size(); i += 4) {
+            int n0 = filtered[i] == '=' ? 0 : value(filtered[i]);
+            int n1 = filtered[i + 1] == '=' ? 0 : value(filtered[i + 1]);
+            int n2 = filtered[i + 2] == '=' ? 0 : value(filtered[i + 2]);
+            int n3 = filtered[i + 3] == '=' ? 0 : value(filtered[i + 3]);
+            out.push_back(static_cast<char>((n0 << 2) | (n1 >> 4)));
+            if (filtered[i + 2] != '=')
+                out.push_back(static_cast<char>(((n1 & 0x0f) << 4) | (n2 >> 2)));
+            if (filtered[i + 3] != '=')
+                out.push_back(static_cast<char>(((n2 & 0x03) << 6) | n3));
+        }
+        return out;
+    }
+
