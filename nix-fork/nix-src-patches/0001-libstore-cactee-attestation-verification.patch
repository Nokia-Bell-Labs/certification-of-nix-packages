+/* Import a single NAR at a known input-addressed store path and bind
+   its attestation sidecar so nix-copy-closure can send both. */
+static void opImportNar(Strings opFlags, Strings opArgs)
+{
+    std::optional<Hash> expectedHash;
+    std::optional<StorePath> deriver;
+    StorePathSet references;
+    std::optional<std::filesystem::path> attJson;
+    std::optional<std::filesystem::path> attSig;
+
+    for (auto i = opFlags.begin(); i != opFlags.end();) {
+        auto flag = *i++;
+        if (i == opFlags.end())
+            throw UsageError("'%s' requires an argument", flag);
+        auto value = *i++;
+        if (flag == "--nar-hash")
+            expectedHash = Hash::parseAnyPrefixed(value);
+        else if (flag == "--deriver")
+            deriver = store->parseStorePath(value);
+        else if (flag == "--references")
+            references.insert(store->parseStorePath(value));
+        else if (flag == "--attestation-json")
+            attJson = absPath(value);
+        else if (flag == "--attestation-sig")
+            attSig = absPath(value);
+        else
+            throw UsageError("unknown flag '%s'", flag);
+    }
+
+    if (opArgs.size() != 2)
+        throw UsageError("'--import-nar' requires a store path and a NAR file");
+
+    auto arg = opArgs.begin();
+    auto storePath = store->parseStorePath(*arg++);
+    auto narFile = absPath(*arg);
+
+    HashSink hashSink(HashAlgorithm::SHA256);
+    readFile(narFile, hashSink);
+    auto hashed = hashSink.finish();
+    if (expectedHash && hashed.hash != *expectedHash)
+        throw Error(
+            "NAR hash mismatch for '%s';\n  specified: %s\n  got:       %s",
+            store->printStorePath(storePath),
+            expectedHash->to_string(HashFormat::SRI, true),
+            hashed.hash.to_string(HashFormat::SRI, true));
+
+    auto & att = settings.getAttestationSettings();
+    if (attJson) {
+        auto json = readFile(*attJson);
+        std::string sig = attSig ? readFile(*attSig) : "";
+        verifyIncomingAttestation(*store, att, storePath, hashed.hash, json, sig);
+    } else
+        bindAttestationSidecarFromDisk(*store, storePath, hashed.hash);
+
+    if (!store->isValidPath(storePath)) {
+        UnkeyedValidPathInfo info(*store, hashed.hash);
+        info.narSize = hashed.numBytesDigested;
+        info.references = std::move(references);
+        info.deriver = std::move(deriver);
+        ValidPathInfo vpi(storePath, std::move(info));
+        AutoCloseFD fd = openFileReadonly(narFile);
+        FdSource source(fd.get());
+        store->addToStore(vpi, source, NoRepair, NoCheckSigs);
+    }
+
+    std::cout << fmt("%s\n", store->printStorePath(storePath)) << std::flush;
+}
