diff --git a/src/certification-verification/simulate-azure.py b/src/certification-verification/simulate-azure.py
new file mode 100755
index 0000000000000000000000000000000000000000..e06c24257bc1a886fa73646aa7aec89ba5898755
--- /dev/null
+++ b/src/certification-verification/simulate-azure.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""Local stand-in for Azure login, SGX attest, and the /certs JWKS.
+
+The verifier talks to it only when CACTEE_AZURE_SIMULATE=1.
+Certificates cannot enable that switch.
+"""
+
+import base64
+import hashlib
+import json
+import subprocess
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+ROOT = Path("/tmp/cactee-sim")
+HOST = "127.0.0.1"
+PORT = 8443
+ENDPOINT = f"https://{HOST}:{PORT}"
+KID = "sim"
+
+
+def b64url(data: bytes) -> str:
+    return base64.urlsafe_b64encode(data).rstrip(b"=").decode("ascii")
+
+
+def openssl(*args: str, input_bytes: bytes | None = None) -> bytes:
+    result = subprocess.run(
+        ["openssl", *args],
+        input=input_bytes,
+        check=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    return result.stdout
+
+
+def prepare() -> None:
+    ROOT.mkdir(parents=True, exist_ok=True)
+    key = ROOT / "key.pem"
+    cert = ROOT / "cert.pem"
+    if not key.exists() or not cert.exists():
+        openssl(
+            "req", "-x509", "-newkey", "rsa:2048",
+            "-keyout", str(key), "-out", str(cert),
+            "-days", "1", "-nodes",
+            "-subj", "/CN=127.0.0.1",
+            "-addext", "subjectAltName=IP:127.0.0.1",
+        )
+
+    modulus = openssl("rsa", "-in", str(key), "-noout", "-modulus").decode()
+    hex_n = modulus.strip().split("=", 1)[1]
+    n = b64url(bytes.fromhex(hex_n))
+    (ROOT / "jwks.json").write_text(json.dumps({
+        "keys": [{"kty": "RSA", "use": "sig", "alg": "RS256", "kid": KID, "n": n, "e": "AQAB"}]
+    }))
+
+    pem = "simulation-public-key\n"
+    mrenclave = "11" * 32
+    quote = bytearray(432)
+    quote[112:144] = bytes.fromhex(mrenclave)
+    quote[368:400] = hashlib.sha256(pem.encode()).digest()
+
+    out = ROOT / "out"
+    out.mkdir(exist_ok=True)
+    payload = b"hello\n"
+    (out / "hello").write_bytes(payload)
+
+    (ROOT / "manifest.json").write_text(json.dumps({
+        "EXPECTED_DUET_ADMIN_MRENCLAVE": mrenclave,
+        "EXPECTED_DUET_SERVICE_INFO": {
+            "service_code_hash": "code",
+            "service_tools_hashes": {"tool": "hash"},
+            "service_dependencies_hash": {"cpu": "dep"},
+        },
+    }, indent=2) + "\n")
+    (ROOT / "certificate.json").write_text(json.dumps({
+        "duet_admin_attestation_service_url": ENDPOINT,
+        "duet_admin_quote": {
+            "quote": base64.b64encode(quote).decode(),
+            "public_key": pem,
+        },
+        "duet_admin_signature": base64.b64encode(b"not-a-signature").decode(),
+        "duet_service_result": {
+            "service_info": {
+                "service_code_hash": "code",
+                "service_tools_hashes": {"tool": "hash"},
+                "service_dependencies_hash": "dep",
+            },
+            "service_result": {
+                "hashes": {"outputs": {"hello": hashlib.sha256(payload).hexdigest()}},
+            },
+        },
+    }, indent=2) + "\n")
+
+
+def sign_jwt() -> str:
+    header = b64url(json.dumps({"alg": "RS256", "kid": KID}, separators=(",", ":")).encode())
+    payload = b64url(json.dumps({
+        "iss": ENDPOINT,
+        "exp": int(time.time()) + 3600,
+    }, separators=(",", ":")).encode())
+    signing_input = f"{header}.{payload}".encode()
+    signature = openssl("dgst", "-sha256", "-sign", str(ROOT / "key.pem"), input_bytes=signing_input)
+    return f"{header}.{payload}.{b64url(signature)}"
+
+
+class Handler(BaseHTTPRequestHandler):
+    def do_POST(self) -> None:
+        length = int(self.headers.get("Content-Length", "0"))
+        self.rfile.read(length)
+        if self.path.endswith("/oauth2/v2.0/token"):
+            body = b'{"access_token":"sim-token","token_type":"Bearer"}'
+        elif self.path.split("?", 1)[0] == "/attest/SgxEnclave":
+            if not (self.headers.get("Authorization") or "").startswith("Bearer "):
+                self.send_response(401)
+                self.end_headers()
+                return
+            body = json.dumps({"token": sign_jwt()}).encode()
+        else:
+            self.send_response(404)
+            self.end_headers()
+            return
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def do_GET(self) -> None:
+        if self.path.split("?", 1)[0] != "/certs":
+            self.send_response(404)
+            self.end_headers()
+            return
+        body = (ROOT / "jwks.json").read_bytes()
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, fmt: str, *args) -> None:
+        print(f"{self.command} {self.path} -> {args[1] if len(args) > 1 else ''}")
+
+
+def main() -> None:
+    prepare()
+    print(f"simulated azure at {ENDPOINT}", flush=True)
+    print(f"trust this cert: {ROOT / 'cert.pem'}", flush=True)
+    print(f"certificate: {ROOT / 'certificate.json'}", flush=True)
+    server = ThreadingHTTPServer((HOST, PORT), Handler)
+    ctx = __import__("ssl").SSLContext(__import__("ssl").PROTOCOL_TLS_SERVER)
+    ctx.load_cert_chain(ROOT / "cert.pem", ROOT / "key.pem")
+    server.socket = ctx.wrap_socket(server.socket, server_side=True)
+    server.serve_forever()
+
+
+if __name__ == "__main__":
+    main()
