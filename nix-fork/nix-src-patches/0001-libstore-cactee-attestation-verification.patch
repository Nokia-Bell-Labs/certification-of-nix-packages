diff --git a/src/libstore/include/nix/store/attestation-settings.hh b/src/libstore/include/nix/store/attestation-settings.hh
new file mode 100644
index 0000000000000000000000000000000000000000..827983f0a827120590b0f0ec0fe5a13a9b97bac7
--- /dev/null
+++ b/src/libstore/include/nix/store/attestation-settings.hh
@@ -0,0 +1,72 @@
+#pragma once
+///@file
+
+#include "nix/util/configuration.hh"
+
+namespace nix {
+
+/**
+ * Client-side CACTEE certificate verification.
+ * Publishing certificates to a cache is not part of this fork.
+ */
+struct AttestationSettings : public virtual Config
+{
+private:
+    void anchor() override;
+
+public:
+    Setting<bool> requireAttestation{
+        this,
+        true,
+        "require-attestation",
+        R"(
+          This fork defaults to true. A substituter NAR is not written
+          to the local store until its CACTEE asset certificate has been
+          fetched and verified against `attestation-cactee-manifest`.
+          The same check runs for direct build inputs. NAR hashes listed
+          in `attestation-bootstrap-inputs` are exempt.
+
+          This option is only settable in the global `nix.conf`, or on
+          the command line by trusted users.
+        )"};
+
+    Setting<std::string> attestationStore{
+        this,
+        "/var/lib/nix-attestations",
+        "attestation-store",
+        R"(
+          Directory where this client keeps fetched CACTEE certificates.
+          Each file is named with the NAR hash SRI, `/` replaced by `_`,
+          plus `.json`. Nix reads `<store-hash>.attestation.json` from a
+          substituter and stores a copy here. It does not publish that
+          file to another cache.
+        )"};
+
+    Setting<StringSet> attestationBootstrapInputs{
+        this,
+        {},
+        "attestation-bootstrap-inputs",
+        R"(
+          Space-separated list of NAR hashes (SRI format) that are trusted
+          without an attestation certificate. Used for bootstrap inputs such
+          as `bootstrap-tools.tar.xz` and `busybox` that cannot be attested
+          because nothing was built before them.
+
+          Example:
+            attestation-bootstrap-inputs = sha256-abc... sha256-def...
+        )"};
+
+    Setting<std::string> attestationCacteeManifest{
+        this,
+        "",
+        "attestation-cactee-manifest",
+        R"(
+          Path to the CACTEE trust file. It holds
+          `EXPECTED_DUET_ADMIN_MRENCLAVE` and `EXPECTED_DUET_SERVICE_INFO`
+          for the duet admin, not for each package. Install it once on
+          the client, the same way as `trusted-public-keys`. Required
+          when a substituter sends a CACTEE asset certificate with a NAR.
+        )"};
+};
+
+} // namespace nix
diff --git a/src/libstore/include/nix/store/attestation.hh b/src/libstore/include/nix/store/attestation.hh
new file mode 100644
index 0000000000000000000000000000000000000000..53e402638ce4ccbec649146af800b23b06bceb92
--- /dev/null
