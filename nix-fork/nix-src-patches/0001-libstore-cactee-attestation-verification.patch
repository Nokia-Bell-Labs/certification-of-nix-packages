index 0000000000000000000000000000000000000000..96599f5f85e302af207255c019c0e9700f0812a0
--- /dev/null
+++ b/src/certification-verification/smoke.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+# Stock Nix 2.35 does not know attestation-* settings. Use the fork build.
+FORK=/home/harmoniatest/nix/outputs/out
+export PATH="$FORK/bin:$PATH"
+export LD_LIBRARY_PATH="$FORK/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+# bash -c keeps the nix shell environment. bash -lc would drop PKG_CONFIG_PATH.
+nix shell nixpkgs#gcc nixpkgs#pkg-config nixpkgs#openssl.dev nixpkgs#nlohmann_json nixpkgs#curl.dev --command \
+  bash -c 'g++ -std=c++23 -Isrc/certification-verification/Include $(pkg-config --cflags openssl nlohmann_json libcurl) src/certification-verification/certificate-verifier.cc src/certification-verification/smoke-test.cc -o /tmp/cactee-smoke $(pkg-config --libs openssl libcurl) && /tmp/cactee-smoke'
