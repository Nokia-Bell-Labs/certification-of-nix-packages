@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# Build helper — BuildKit, corporate CA, Nix fork path, log saving.
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+export DOCKER_BUILDKIT=1
+
+NIX_SRC="${NIX_SRC:-/mnt/c/nixDocs/freshNix/nix}"
+TARGET="${1:-nix-tee-base}"
+IMAGE="${2:-nix-tee-base}"
+
+mkdir -p build-logs
+LOGFILE="build-logs/${IMAGE}-$(date +%Y%m%d-%H%M%S).log"
+
+# Windows editors reintroduce CRLF constantly; a stray \r in a patch or script
+# only surfaces an hour into the build. Normalize up front.
+if command -v python3 >/dev/null 2>&1; then
+  python3 ./fix-eol.py
+fi
+
+CA_ARGS=()
+if [ -f certs/zscaler-root-ca.crt ]; then
+  CA_ARGS=(--build-arg "CORPORATE_CA_B64=$(base64 -w0 certs/zscaler-root-ca.crt)")
+fi
+
+if [ ! -f "${NIX_SRC}/flake.nix" ]; then
+  echo "ERROR: Nix fork not found at ${NIX_SRC}/flake.nix" >&2
+  echo "Set NIX_SRC to your fork path, e.g.:" >&2
+  echo "  NIX_SRC=/mnt/c/nixDocs/freshNix/nix ./build.sh" >&2
+  exit 1
+fi
+
+echo "==> Building target=${TARGET} image=${IMAGE} nixsrc=${NIX_SRC}"
+echo "==> Log file: ${LOGFILE}"
+
+# --progress=plain: full Nix output (no fancy UI that hides retries/504)
+docker build \
+  --progress=plain \
+  --build-context "nixsrc=${NIX_SRC}" \
+  "${CA_ARGS[@]}" \
+  --target "${TARGET}" \
+  -t "${IMAGE}" \
+  . 2>&1 | tee "${LOGFILE}"
+
+echo "==> Done. Log saved: ${LOGFILE}"
+
+# Extract in-image step logs if image exists
+if docker image inspect "${IMAGE}" >/dev/null 2>&1; then
+  STEP_LOG_DIR="build-logs/${IMAGE}-steps-$(date +%Y%m%d-%H%M%S)"
+  mkdir -p "${STEP_LOG_DIR}"
+  docker run --rm --entrypoint sh "${IMAGE}" -c \
+    'if [ -d /build/logs ]; then tar -c -C /build logs; fi' 2>/dev/null \
+    | tar -x -C "${STEP_LOG_DIR}" 2>/dev/null \
+    && echo "==> Step logs extracted: ${STEP_LOG_DIR}/logs/" \
+    || true
+fi
