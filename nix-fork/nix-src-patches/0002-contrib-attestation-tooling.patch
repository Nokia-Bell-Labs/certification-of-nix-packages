new file mode 100755
index 0000000000000000000000000000000000000000..45900ba5ec69e11eb06c34238ab475ce0cc46530
--- /dev/null
+++ b/contrib/attestation/nix-certifier
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""
+Post-build hook: create binding record v1 certificates for each output.
+
+Environment (set by Nix post-build-hook):
+  DRV_PATH   - derivation path
+  OUT_PATHS  - space-separated output store paths
+
+Configuration (environment):
+  ATTESTATION_STORE       - certificate directory (default: /var/lib/nix-attestations)
+  ATTESTATION_STUB_MODE   - if "1", use stub TDX quote (for dev without hardware)
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import os
+import subprocess
+import sys
+
+from binding import compute_binding, make_certificate, write_certificate
+
+
+def run(cmd: list[str]) -> str:
+    result = subprocess.run(cmd, check=True, capture_output=True, text=True)
+    return result.stdout.strip()
+
+
+def nar_hash_sri(store_path: str) -> str:
+    """Return NAR hash in SRI format for a store path."""
+    info = json.loads(run(["nix", "path-info", "--json", store_path]))[0]
+    return info["narHash"]
+
+
+def derivation_show(drv_path: str) -> dict:
+    """Return the parsed derivation JSON for one derivation path."""
+    raw = run([
+        "nix", "--extra-experimental-features", "nix-command",
+        "derivation", "show", drv_path,
+    ])
+    return json.loads(raw)[drv_path]
+
+
+def derivation_direct_input_paths(drv_path: str) -> list[str]:
+    """Return the direct input store paths of a derivation.
+
+    This must match what libstore iterates over in
+    verifyDirectInputAttestations, namely the derivation's own inputSrcs plus
+    the specific outputs it consumes from each input derivation. Taking every
+    output of each input derivation would add paths libstore never checks, and
+    the binding digest would then disagree.
+    """
+    data = derivation_show(drv_path)
+
+    paths: list[str] = list(data.get("inputSrcs", []))
+
+    for input_drv, spec in data.get("inputDrvs", {}).items():
+        wanted = spec.get("outputs", []) if isinstance(spec, dict) else list(spec)
+        input_outputs = derivation_show(input_drv).get("outputs", {})
+        for name in wanted:
+            path = input_outputs.get(name, {}).get("path")
+            if path:
+                paths.append(path)
+
+    # Deduplicate while keeping determinism; two output names can resolve to
+    # the same path, and libstore holds inputs in a set.
+    return list(dict.fromkeys(paths))
+
+
+def derivation_direct_inputs(drv_path: str) -> list[str]:
+    """Return sorted NAR hashes (SRI) of direct input store paths."""
+    paths = derivation_direct_input_paths(drv_path)
+    return sorted(nar_hash_sri(p) for p in paths if p)
+
+
+def output_path_to_name(drv_path: str, out_paths: list[str]) -> dict[str, str]:
+    """Map each built output store path to its derivation output name."""
+    raw = run(["nix-store", "-q", "--outputs", drv_path])
+    name_by_path: dict[str, str] = {}
+    for line in raw.splitlines():
+        parts = line.split(maxsplit=1)
+        if len(parts) == 2:
+            name_by_path[parts[1]] = parts[0]
+    return {out_path: name_by_path.get(out_path, "out") for out_path in out_paths}
+
+
+def stub_quote(binding: str) -> str:
+    """Dev stub: base64-encoded binding digest stands in for a TDX quote."""
+    return base64.b64encode(binding.encode("utf-8")).decode("ascii")
+
+
+def get_tdx_quote(binding: str) -> str:
+    """Obtain TDX quote with binding in report_data, or stub in dev mode."""
+    if os.environ.get("ATTESTATION_STUB_MODE", "0") == "1":
+        return stub_quote(binding)
+
+    quote_tool = os.environ.get("ATTESTATION_QUOTE_TOOL", "")
+    if not quote_tool:
+        print(
+            "WARNING: ATTESTATION_STUB_MODE not set and ATTESTATION_QUOTE_TOOL empty; "
+            "using stub quote",
+            file=sys.stderr,
+        )
+        return stub_quote(binding)
+
+    result = subprocess.run(
+        [quote_tool, binding],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    return result.stdout.strip()
+
+
+def main() -> int:
+    drv_path = os.environ.get("DRV_PATH", "")
+    out_paths = os.environ.get("OUT_PATHS", "").split()
+    store_dir = os.environ.get("ATTESTATION_STORE", "/var/lib/nix-attestations")
+
+    if not drv_path or not out_paths:
+        print("ERROR: DRV_PATH and OUT_PATHS must be set", file=sys.stderr)
+        return 1
+
+    input_hashes = derivation_direct_inputs(drv_path)
+    output_hashes: dict[str, str] = {}
+
+    for out_path, name in output_path_to_name(drv_path, out_paths).items():
+        output_hashes[name] = nar_hash_sri(out_path)
+
+    binding = compute_binding(drv_path, input_hashes, output_hashes)
+    quote = get_tdx_quote(binding)
+    cert = make_certificate(drv_path, input_hashes, output_hashes, quote)
+
+    written = []
+    for out_hash in output_hashes.values():
+        path = write_certificate(cert, store_dir, out_hash)
+        written.append(path)
+
+    print(f"attestation: wrote {len(written)} certificate(s) to {store_dir}")
+    for p in written:
+        print(f"  {p}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
