+#!/usr/bin/env bash
+# Build Nix fork via classic nix-build (substitute=false).
+set -euo pipefail
+
+cd /nix-src
+bash /build/restore-symlinks.sh /nix-src
+
+export NIX_GIT_SSL_CAINFO=/etc/nix/ca-bundle.crt
+
+test -d /nixpkgs || {
+  echo "ERROR: /nixpkgs missing" >&2
+  exit 1
+}
+
+bash /build/prefetch.sh fork
+
+echo "==> Building nix-cli (substitute=false, nixpkgs $(cat /nixpkgs/.version))"
+nix-build /build/nix-fork-classic.nix -A nix-cli \
+  --option substitute false \
+  --option ssl-cert-file /etc/nix/ca-bundle.crt \
+  --option max-jobs 4 \
+  -o /nix-src/nix-cli-result
+
+for bin in nix nix-store nix-build nix-instantiate; do
+  if [ -x "/nix-src/nix-cli-result/bin/${bin}" ]; then
+    cp "/nix-src/nix-cli-result/bin/${bin}" /nix/var/nix/profiles/default/bin/
+  fi
+done
+
+nix --version
diff --git a/contrib/attestation/package-builder/export-closure.sh b/contrib/attestation/package-builder/export-closure.sh
new file mode 100755
index 0000000000000000000000000000000000000000..ffd11038722c6c6b792fb9912810a6b7e9d06918
--- /dev/null
+++ b/contrib/attestation/package-builder/export-closure.sh
@@ -0,0 +1,412 @@
+#!/usr/bin/env bash
+# Export the jo derivation graph leaves-first (certificate order).
+# Example: bootstrap/FOD sources -> glibc -> gcc -> … -> jo.
+# Each node is its own NAR when possible; otherwise the raw file/dir is copied.
+set -euo pipefail
+
+OUT="${1:-/tmp/outputs}"
+RESULTS="${2:-/build/results}"
+
+mkdir -p "${OUT}/nars" "${OUT}/packages"
+# Drop leftover runtime-only exports from earlier runs.
+rm -rf "${OUT}/packages" "${OUT}/nars" "${OUT}/files"
+mkdir -p "${OUT}/nars" "${OUT}/packages" "${OUT}/files"
+
+if [ ! -d "${RESULTS}" ]; then
+  echo "ERROR: ${RESULTS} not found — Dockerfile must nix-build -o /build/results/<name>" >&2
+  exit 1
+fi
+
+ROOT_LINK="${RESULTS}/jo"
+if [ ! -e "${ROOT_LINK}" ]; then
+  ROOT_LINK="/result"
+fi
+if [ ! -e "${ROOT_LINK}" ]; then
+  echo "ERROR: root package jo not found under ${RESULTS}/jo or /result" >&2
+  exit 1
+fi
+ROOT=$(readlink -f "${ROOT_LINK}")
+ROOT_DRV=$(nix-store -q --deriver "${ROOT}" 2>/dev/null || true)
+if [ -z "${ROOT_DRV}" ] || [ "${ROOT_DRV}" = "unknown" ]; then
+  echo "ERROR: no deriver for root ${ROOT}" >&2
+  exit 1
+fi
+
+echo "==> root ${ROOT}"
+echo "==> drv  ${ROOT_DRV}"
+echo "==> walking full derivation graph (build-time + runtime inputs)"
+
+find_python3() {
+  if command -v python3 >/dev/null 2>&1; then
+    command -v python3
+    return 0
+  fi
+  local p
+  for p in /nix/store/*-python3-*/bin/python3; do
+    [ -x "$p" ] || continue
+    case "$p" in
+      *-debug*) continue ;;
+    esac
+    printf '%s\n' "$p"
+    return 0
+  done
+  return 1
+}
+
+PYTHON=$(find_python3) || {
+  echo "ERROR: python3 not on PATH and no /nix/store/*-python3-*/bin/python3" >&2
+  exit 1
+}
+
+GRAPH=$(mktemp)
+"${PYTHON}" - "${ROOT_DRV}" <<'PY' > "${GRAPH}"
+import json, os, subprocess, sys
+
+root_drv = sys.argv[1]
+flags = ["--extra-experimental-features", "nix-command"]
+store = root_drv.rsplit("/", 1)[0] if root_drv.startswith("/") else "/nix/store"
+
+
+def abs_store(path):
+    if not path:
+        return path
+    if str(path).startswith("/"):
+        return path
+    return f"{store}/{path}"
+
+
+def load_drvs(raw):
+    parsed = json.loads(raw)
+    if isinstance(parsed, dict) and "derivations" in parsed:
+        return parsed["derivations"]
+    return parsed
+
+
+def lookup(drvs, path):
+    base = path.rsplit("/", 1)[-1]
+    for key in (path, base, abs_store(path)):
+        if key in drvs:
+            return drvs[key]
+    for k, v in drvs.items():
+        if k.endswith(base):
+            return v
+    raise KeyError(path, list(drvs)[:8])
+
+
+def input_srcs(data):
+    if "inputSrcs" in data:
+        return list(data.get("inputSrcs") or [])
+    inputs = data.get("inputs") or {}
+    return list(inputs.get("srcs") or [])
+
+
+def input_drvs(data):
+    if "inputDrvs" in data:
+        return data.get("inputDrvs") or {}
+    inputs = data.get("inputs") or {}
+    return inputs.get("drvs") or {}
+
+
+def output_path(out):
+    if not isinstance(out, dict):
+        return None
+    p = out.get("path")
+    return abs_store(p) if p else None
+
+
+def output_paths(data):
+    outs = data.get("outputs") or {}
+    found = []
+    for _name, out in outs.items():
+        p = output_path(out)
+        if p:
+            found.append(p)
+    return found
+
+
+proc = subprocess.run(
+    ["nix", *flags, "derivation", "show", "-r", root_drv],
+    capture_output=True, text=True,
+)
+if proc.returncode != 0:
+    sys.stderr.write(proc.stderr or "")
+    proc.check_returncode()
+
+drvs = load_drvs(proc.stdout)
+sys.stderr.write(f"==> graph derivations: {len(drvs)}\n")
+
+# path -> (drv_abs or empty, list of direct input paths)
+rows = {}
+
+for drv_key, data in drvs.items():
+    drv_abs = abs_store(drv_key)
+    ins = []
+    for src in input_srcs(data):
+        ins.append(abs_store(src))
+    for idrv, spec in input_drvs(data).items():
+        names = spec.get("outputs", []) if isinstance(spec, dict) else list(spec)
+        try:
+            child = lookup(drvs, idrv)
+        except KeyError:
+            child = None
+        if child is None:
+            continue
+        child_outs = child.get("outputs") or {}
+        for name in names:
+            p = output_path(child_outs.get(name, {}))
+            if p:
+                ins.append(p)
+    seen = set()
+    ins_u = []
+    for p in ins:
+        if p and p not in seen:
+            seen.add(p)
+            ins_u.append(p)
+    for p in output_paths(data):
+        rows[p] = (drv_abs, ins_u)
+
+for drv_key, data in drvs.items():
+    for src in input_srcs(data):
+        s = abs_store(src)
+        if s.endswith(".drv"):
+            continue
+        if s not in rows:
+            rows[s] = ("", [])
+
+nodes = [p for p in rows if not p.endswith(".drv")]
+preds = {}
+for p in nodes:
+    preds[p] = [i for i in rows[p][1] if i in rows and i != p and not i.endswith(".drv")]
+
+import heapq
+indeg = {p: 0 for p in nodes}
+adj = {p: [] for p in nodes}
+for p in nodes:
+    for i in preds[p]:
+        adj[i].append(p)
+        indeg[p] += 1
+
+heap = [p for p in nodes if indeg[p] == 0]
+heapq.heapify(heap)
+order = []
+depth = {p: 0 for p in nodes}
+while heap:
+    n = heapq.heappop(heap)
+    order.append(n)
+    for d in adj[n]:
+        depth[d] = max(depth[d], depth[n] + 1)
+        indeg[d] -= 1
+        if indeg[d] == 0:
+            heapq.heappush(heap, d)
+seen_order = set(order)
+for p in sorted(nodes):
+    if p not in seen_order:
+        order.append(p)
+
+dmax = max(depth.values(), default=0)
+sys.stderr.write(
+    f"==> cert order: {len(order)} units, leaves first, max depth {dmax}\n"
+)
+
+for path in order:
+    drv, ins = rows[path]
+    print(f"{path}\t{drv}\t{','.join(ins)}\t{depth.get(path, 0)}")
+PY
+
+json_escape() {
+  local s=$1
+  s=${s//\\/\\\\}
+  s=${s//\"/\\\"}
+  printf '%s' "$s"
+}
+
+declare -A NAR_HASH
+
+nar_hash_sri() {
+  local p=$1
+  if [ -n "${NAR_HASH[$p]:-}" ]; then
+    printf '%s' "${NAR_HASH[$p]}"
+    return
+  fi
+  local h
+  if h=$(nix --extra-experimental-features nix-command hash path --sri "$p" 2>/dev/null); then
+    :
+  elif [ -f "$p" ]; then
+    h=$(nix --extra-experimental-features nix-command hash file --sri "$p")
+  else
+    h="unknown"
+  fi
+  NAR_HASH[$p]=$h
+  printf '%s' "$h"
+}
+
+pkg_name_from_path() {
+  local base
+  base=$(basename "$1")
+  printf '%s' "${base}"
+}
+
+export_one() {
+  local name=$1
+  local root=$2
+  local drv=$3
+  local ins_csv=$4
+  local depth=$5
+  local pkg="${OUT}/packages/${name}"
+  mkdir -p "${pkg}"
+
+  echo "${root}" > "${pkg}/store-path.txt"
+
+  local nar_hash nar_file nar_path nar_stem drv_json inputs_json kind
+  kind="nar"
+  nar_hash=$(nar_hash_sri "${root}")
+  nar_stem=$(printf '%s' "${nar_hash}" | tr '/' '_')
+  if [ "${nar_stem}" = "unknown" ]; then
+    nar_stem="${name}"
+  fi
+  nar_file="nars/${nar_stem}.nar"
+  nar_path="${OUT}/${nar_file}"
+
+  if [ ! -f "${nar_path}" ]; then
+    if nix-store --dump "${root}" > "${nar_path}" 2>/dev/null && [ -s "${nar_path}" ]; then
+      kind="nar"
+    else
+      rm -f "${nar_path}"
+      if [ -f "${root}" ]; then
+        kind="file"
+        nar_file="files/${name}"
+        cp -a "${root}" "${OUT}/${nar_file}"
+        nar_hash=$(nix --extra-experimental-features nix-command hash file --sri "${OUT}/${nar_file}")
+        NAR_HASH[$root]=$nar_hash
+      elif [ -e "${root}" ]; then
+        kind="tar"
+        nar_file="files/${name}.tar"
+        tar -C "$(dirname "${root}")" -cf "${OUT}/${nar_file}" "$(basename "${root}")"
+        nar_hash=$(nix --extra-experimental-features nix-command hash file --sri "${OUT}/${nar_file}")
+        NAR_HASH[$root]=$nar_hash
+      else
+        echo "    SKIP missing ${root}" >&2
+        rm -rf "${pkg}"
+        return 1
+      fi
+    fi
+  fi
+  if [ "${kind}" = "nar" ]; then
+    ln -sfn "../../${nar_file}" "${pkg}/output.nar"
+  else
+    ln -sfn "../../${nar_file}" "${pkg}/output.bin"
+  fi
+
+  if [ -z "${drv}" ]; then
+    drv_json="null"
+  else
+    drv_json="\"$(json_escape "${drv}")\""
+  fi
+
+  if [ -z "${ins_csv}" ]; then
+    inputs_json="[]"
+    hashes_json="[]"
+  else
+    local inp h
+    local -a inps=()
+    IFS=',' read -r -a inps <<< "${ins_csv}"
+    local -a lines=()
+    for inp in "${inps[@]}"; do
+      [ -n "${inp}" ] || continue
+      [ -e "${inp}" ] || continue
+      h=$(nar_hash_sri "${inp}")
+      lines+=("${inp}"$'\t'"${h}")
+    done
+    if [ "${#lines[@]}" -eq 0 ]; then
+      inputs_json="[]"
+      hashes_json="[]"
+    else
+      local sorted first=1
+      sorted=$(printf '%s\n' "${lines[@]}" | sort)
+      inputs_json="["
+      hashes_json="["
+      local sp
+      while IFS=$'\t' read -r sp h; do
+        [ -n "${sp}" ] || continue
+        [ "${first}" -eq 1 ] || { inputs_json+=","; hashes_json+=","; }
+        first=0
+        inputs_json+="{\"storePath\":\"$(json_escape "${sp}")\",\"narHash\":\"$(json_escape "${h}")\"}"
+        hashes_json+="\"$(json_escape "${h}")\""
+      done <<< "${sorted}"
+      inputs_json+="]"
+      hashes_json+="]"
+    fi
+  fi
+
+  {
+    echo '{'
+    echo '  "version": 1,'
+    printf '  "package": "%s",\n' "$(json_escape "${name}")"
+    printf '  "storePath": "%s",\n' "$(json_escape "${root}")"
+    printf '  "kind": "%s",\n' "$(json_escape "${kind}")"
+    printf '  "certDepth": %s,\n' "${depth:-0}"
+    printf '  "narHash": "%s",\n' "$(json_escape "${nar_hash}")"
+    printf '  "narFile": "%s",\n' "$(json_escape "${nar_file}")"
+    printf '  "drvPath": %s,\n' "${drv_json}"
+    printf '  "directInputs": %s,\n' "${inputs_json}"
+    printf '  "directInputNarHashes": %s\n' "${hashes_json}"
+    echo '}'
+  } > "${pkg}/manifest.json"
+
+  echo "    ${name} depth=${depth:-0} ${kind} -> ${nar_hash}"
+}
+
+INDEX=$(mktemp)
+count=0
+skip=0
+while IFS=$'\t' read -r path drv ins_csv depth; do
+  [ -n "${path}" ] || continue
+  name=$(pkg_name_from_path "${path}")
+  echo "==> package ${name}"
+  if export_one "${name}" "${path}" "${drv}" "${ins_csv}" "${depth:-0}"; then
+    printf '%s\n' "${name}" >> "${INDEX}"
+    count=$((count + 1))
+  else
+    skip=$((skip + 1))
+  fi
+done < "${GRAPH}"
+rm -f "${GRAPH}"
+
+if [ ! -s "${INDEX}" ]; then
+  echo "ERROR: no paths exported from ${ROOT_DRV}" >&2
+  exit 1
+fi
+
+echo "==> exported ${count} paths (${skip} missing on disk)"
+
+{
+  echo '{'
+  echo '  "version": 1,'
+  printf '  "root": "%s",\n' "$(json_escape "${ROOT}")"
+  printf '  "rootDrv": "%s",\n' "$(json_escape "${ROOT_DRV}")"
+  printf '  "certOrder": "leaves-first (bootstrap/FODs, then glibc, gcc, jo)",\n'
+  echo '  "packages": ['
+  first=1
+  while read -r name; do
+    [ "${first}" -eq 1 ] || echo ','
+    first=0
+    printf '    "%s"' "$(json_escape "${name}")"
+  done < "${INDEX}"
+  echo ''
+  echo '  ]'
+  echo '}'
+} > "${OUT}/index.json"
+
+rm -f "${INDEX}"
+
+if [ -x "${RESULTS}/jo/bin/jo" ]; then
+  "${RESULTS}/jo/bin/jo" -p name=jo version=1.7 > "${OUT}/demo.json"
+elif [ -x /result/bin/jo ]; then
+  /result/bin/jo -p name=jo version=1.7 > "${OUT}/demo.json"
+fi
+
+cp -r /build/logs "${OUT}/build-logs" 2>/dev/null || true
+
+echo "packages: $(ls -1 "${OUT}/packages" | wc -l)"
+echo "NAR files: $(ls -1 "${OUT}/nars"/*.nar 2>/dev/null | wc -l)"
+echo "index: ${OUT}/index.json"
diff --git a/contrib/attestation/package-builder/fix-eol.py b/contrib/attestation/package-builder/fix-eol.py
new file mode 100755
index 0000000000000000000000000000000000000000..2d13a23e031ceeb3257fce02bbc546576e504fb5
--- /dev/null
+++ b/contrib/attestation/package-builder/fix-eol.py
@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+"""Force LF line endings on every file the Linux build touches.
+
+The project is edited from Windows, so shell scripts, Nix expressions and
+patches routinely pick up CRLF. Inside the container that shows up as
+"/usr/bin/env: 'bash\\r': No such file or directory" or as patches that refuse
+to apply, which is a slow and confusing way to discover a line-ending problem.
+Run this after editing on Windows.
+"""
+import pathlib
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parent
+
+PATTERNS = ["*.sh", "*.nix", "*.conf", "Dockerfile", "vendor/**/*.patch",
+            "vendor/**/config.guess", "vendor/**/config.sub",
+            "fork-nixpkgs/*.nix"]
+
+changed = []
+for pattern in PATTERNS:
+    for path in sorted(ROOT.glob(pattern)):
+        if not path.is_file():
+            continue
+        raw = path.read_bytes()
+        fixed = raw.replace(b"\r\n", b"\n").replace(b"\r", b"\n")
+        if fixed != raw:
+            path.write_bytes(fixed)
+            changed.append(path.relative_to(ROOT).as_posix())
+
+if changed:
+    print("Normalized to LF:")
+    for name in changed:
+        print("  " + name)
+else:
+    print("All files already LF.")
+
+sys.exit(0)
diff --git a/contrib/attestation/package-builder/fork-build-overlay.nix b/contrib/attestation/package-builder/fork-build-overlay.nix
new file mode 100644
index 0000000000000000000000000000000000000000..d221100372f5bd459dfc3f22a3d321f9d540b413
--- /dev/null
+++ b/contrib/attestation/package-builder/fork-build-overlay.nix
@@ -0,0 +1,57 @@
+# Proxy-only overlays. Package versions come from nixpkgs 26.05 (fork flake pin).
+final: prev:
+let
+  inherit (final) lib;
+in
+{
+  # Dead or proxy-blocked patch URLs (launchpad, busybox bug tracker).
+  busybox = prev.busybox.overrideAttrs (old: {
+    patches = lib.filter (
+      patch:
+      !(lib.isAttrs patch && patch ? name && lib.hasPrefix "CVE-2026-26157" patch.name)
+    ) (
+      lib.map (
+        patch:
+        if lib.isAttrs patch && patch ? name && patch.name == "CVE-2022-48174.patch" then
+          /build/vendor/busybox-patches/CVE-2022-48174.patch
+        else if lib.isAttrs patch && patch ? name && patch.name == "CVE-2023-42366.patch" then
+          /build/vendor/busybox-patches/CVE-2023-42366.patch
+        else if lib.isAttrs patch && patch ? name && patch.name == "CVE-2023-42363.patch" then
+          /build/vendor/busybox-patches/CVE-2023-42363.patch
+        else if lib.isAttrs patch && patch ? name && patch.name == "CVE-2023-42364_CVE-2023-42365.patch" then
+          /build/vendor/busybox-patches/CVE-2023-42364_CVE-2023-42365.patch
+        else if lib.isAttrs patch && patch ? name && patch.name == "CVE-2023-39810.patch" then
+          /build/vendor/busybox-patches/CVE-2023-39810.patch
+        else
+          patch
+      ) old.patches
+    );
+    postPatch = ''
+      bash /build/vendor/busybox-patches/apply-cve-2026.sh
+    '' + (old.postPatch or "");
+  });
+
+  unzip = prev.unzip.overrideAttrs (old: {
+    patches = lib.map (patch:
+      if lib.isAttrs patch && patch ? name && patch.name == "CVE-2021-4217.patch" then
+        /build/vendor/unzip-patches/CVE-2021-4217.patch
+      else
+        patch
+    ) old.patches;
+  });
+
+  # Keep 26.05's curl version (meets libstore >= 8.17). Only force HTTP/3 off:
+  # the fork's dependencies.nix sets http3Support, and ngtcp2 git clones fail
+  # through the corporate proxy. HTTP/3 is off by default in Nix anyway.
+  curl =
+    let
+      mk =
+        args:
+        (prev.curl.override (args // { http3Support = false; }))
+        // {
+          override = mkFrom args;
+        };
+      mkFrom = base: args: mk (base // args);
+    in
+    mk { };
+}
diff --git a/contrib/attestation/package-builder/fork-nixpkgs/default.nix b/contrib/attestation/package-builder/fork-nixpkgs/default.nix
