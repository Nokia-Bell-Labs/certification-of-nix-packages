diff --git a/contrib/attestation/package-builder/nokia-runner/Dockerfile b/contrib/attestation/package-builder/nokia-runner/Dockerfile
new file mode 100644
index 0000000000000000000000000000000000000000..4de0a1999f654f67268041250da7a93b0e19f225
--- /dev/null
+++ b/contrib/attestation/package-builder/nokia-runner/Dockerfile
@@ -0,0 +1,57 @@
+# Nokia cert runner: one nix-build per runtime package (own cert later), then jo.
+#
+# test_docker.py tars nokia-runner/ and uses the classic Docker API
+# (no BuildKit). Do not add RUN --mount=type=cache here — that syntax
+# fails on the cert runner. The compile-time Nix store cache lives only
+# on nix-tee-base (./build.sh).
+# Stage: ./stage-nokia-runner.sh
+#
+# glibc's .nix and this Dockerfile are the pattern: template + ordered loop.
+# Later packages reuse earlier store paths as inputs (verification graph).
+# Export writes one manifest per package — deps are not folded into jo's cert.
+
+FROM nix-tee-base
+
+ARG http_proxy=
+ARG https_proxy=
+
+WORKDIR /build
+
+COPY jo.nix nixpkgs-with-overlay.nix gnu-mirror-overlay.nix /build/
+COPY packages /build/packages
+COPY vendor /build/vendor
+
+RUN set -eux; \
+    for f in /build/jo.nix /build/nixpkgs-with-overlay.nix /build/gnu-mirror-overlay.nix \
+             /build/packages/*.nix /build/packages/build-order.txt; do \
+      [ -f "$f" ] || continue; \
+      tr -d '\r' < "$f" > "$f.lf"; mv "$f.lf" "$f"; \
+    done
+
+RUN set -eux; \
+    mkdir -p /build/results; \
+    while read -r attr; do \
+      [ -n "$attr" ] || continue; \
+      safe="$(echo "$attr" | tr '.' '-')"; \
+      f="/build/packages/${safe}.nix"; \
+      [ -f "$f" ] || { echo "missing $f" >&2; exit 1; }; \
+      echo "==> runtime package $attr"; \
+      nix-build "$f" -o "/build/results/${safe}" \
+        --option substitute false \
+        --option ssl-cert-file /etc/nix/ca-bundle.crt; \
+    done < /build/packages/build-order.txt
+
+RUN set -eux; \
+    echo "==> jo"; \
+    nix-build /build/jo.nix -o /build/results/jo \
+      --option substitute false \
+      --option ssl-cert-file /etc/nix/ca-bundle.crt; \
+    ln -sfn /build/results/jo /result
+
+# After nix-build so export-script edits do not rebuild packages.
+COPY export-closure.sh /build/export-closure.sh
+RUN tr -d '\r' < /build/export-closure.sh > /build/export-closure.sh.lf \
+    && mv /build/export-closure.sh.lf /build/export-closure.sh \
+    && chmod +x /build/export-closure.sh
+
+CMD ["/build/export-closure.sh", "/tmp/outputs", "/build/results"]
