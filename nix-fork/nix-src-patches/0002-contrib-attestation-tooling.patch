diff --git a/contrib/attestation/package-builder/Dockerfile b/contrib/attestation/package-builder/Dockerfile
new file mode 100644
index 0000000000000000000000000000000000000000..ad56a8398ee7e6d31b021eaab73aa59e92dbbb38
--- /dev/null
+++ b/contrib/attestation/package-builder/Dockerfile
@@ -0,0 +1,102 @@
+# syntax=docker/dockerfile:1.4
+# Stage 1: compile Nix fork (substitute=false). Stage 2: build jo + export NARs.
+#
+#   DOCKER_BUILDKIT=1 ./build.sh
+#
+# Evaluator must be new enough for nixpkgs 26.05 (env vs derivation attrs).
+FROM nixos/nix:2.31.2 AS nix-tee-prep
+
+ARG CORPORATE_CA_B64=
+ARG NIXPKGS_TARBALL=https://github.com/NixOS/nixpkgs/archive/nixos-26.05.tar.gz
+
+COPY setup-ca-bundle.sh /build/setup-ca-bundle.sh
+COPY certs/ /build/certs/
+RUN set -eux; \
+    tr -d '\r' < /build/setup-ca-bundle.sh > /build/setup-ca-bundle.sh.lf; \
+    mv /build/setup-ca-bundle.sh.lf /build/setup-ca-bundle.sh; \
+    chmod +x /build/setup-ca-bundle.sh; \
+    CORPORATE_CA_B64="${CORPORATE_CA_B64}" bash /build/setup-ca-bundle.sh
+
+ENV SSL_CERT_FILE=/etc/nix/ca-bundle.crt \
+    NIX_SSL_CERT_FILE=/etc/nix/ca-bundle.crt \
+    GIT_SSL_CAINFO=/etc/nix/ca-bundle.crt \
+    NIX_GIT_SSL_CAINFO=/etc/nix/ca-bundle.crt
+
+RUN mkdir -p /etc/nix && printf '%s\n' \
+    '--http1.1' '--retry 8' '--retry-all-errors' '--connect-timeout 60' \
+    > /etc/nix/.curlrc
+ENV CURL_HOME=/etc/nix
+
+WORKDIR /build
+COPY fork-nixpkgs/default.nix /build/fork-nixpkgs/default.nix
+COPY nix-docker.conf prefetch.sh compile-nix-fork.sh sync-nix-cache.sh restore-symlinks.sh nix-fork-classic.nix \
+     fork-build-overlay.nix gnu-mirror-overlay.nix export-closure.sh /build/
+COPY vendor/ /build/vendor/
+RUN set -eux; \
+    for f in /build/nix-docker.conf /build/prefetch.sh /build/compile-nix-fork.sh \
+             /build/sync-nix-cache.sh /build/restore-symlinks.sh /build/nix-fork-classic.nix \
+             /build/fork-build-overlay.nix \
+             /build/fork-nixpkgs/default.nix /build/gnu-mirror-overlay.nix \
+             /build/export-closure.sh \
+             /build/vendor/gnu-config/config.guess /build/vendor/gnu-config/config.sub; do \
+      [ -f "$f" ] || continue; \
+      tr -d '\r' < "$f" > "$f.lf"; mv "$f.lf" "$f"; \
+    done; \
+    for f in /build/vendor/busybox-patches/*.patch /build/vendor/busybox-patches/*.sh \
+             /build/vendor/unzip-patches/*.patch; do \
+      [ -f "$f" ] || continue; \
+      tr -d '\r' < "$f" > "$f.lf"; mv "$f.lf" "$f"; \
+    done; \
+    chmod +x /build/vendor/busybox-patches/apply-cve-2026.sh; \
+    chmod +x /build/export-closure.sh /build/prefetch.sh /build/compile-nix-fork.sh \
+             /build/sync-nix-cache.sh /build/restore-symlinks.sh /build/setup-ca-bundle.sh; \
+    cp /build/nix-docker.conf /etc/nix/nix.conf
+
+RUN --mount=type=cache,target=/var/cache/nixpkgs-dl \
+    set -eux; \
+    key="$(printf '%s' "${NIXPKGS_TARBALL}" | sha256sum | cut -c1-32)"; \
+    tarball="/var/cache/nixpkgs-dl/nixpkgs-${key}.tar.gz"; \
+    if [ ! -f "${tarball}" ]; then \
+      curl -fsSL --cacert /etc/nix/ca-bundle.crt -o "${tarball}" "${NIXPKGS_TARBALL}"; \
+    fi; \
+    mkdir -p /nixpkgs; \
+    tar -xzf "${tarball}" -C /nixpkgs --strip-components=1; \
+    echo "nixpkgs $(cat /nixpkgs/.version) from ${NIXPKGS_TARBALL}"
+
+ENV NIX_PATH=nixpkgs=/nixpkgs
+
+COPY --from=nixsrc . /nix-src/
+WORKDIR /nix-src
+RUN bash /build/restore-symlinks.sh /nix-src
+
+FROM nix-tee-prep AS nix-tee-base
+
+# Cache mounts survive a failed RUN; the image layer does not. Do not mount over
+# /nix — the store must be copied into this layer on success so nokia-runner
+# (test_docker.py, classic builder, FROM nix-tee-base) still has a real store.
+RUN --mount=type=cache,id=nix-tee-store,sharing=locked,target=/mnt/nix-tee-cache/store \
+    --mount=type=cache,id=nix-tee-var,sharing=locked,target=/mnt/nix-tee-cache/var \
+    bash -euxo pipefail -c '\
+    bash /build/sync-nix-cache.sh restore; \
+    trap "bash /build/sync-nix-cache.sh save" EXIT; \
+    bash /build/compile-nix-fork.sh \
+      2>&1 | tee /build/logs/06-nix-fork-compile.log'
+
+FROM nix-tee-base AS package-builder
+
+# jo.nix uses ./vendor/jo-src (already COPY'd in nix-tee-prep). Do not
+# re-fetch from GitHub: archive tarball hashes drift and fail prefetch.
+COPY jo.nix nixpkgs-with-overlay.nix /build/
+RUN set -eux; \
+    for f in /build/jo.nix /build/nixpkgs-with-overlay.nix; do \
+      tr -d '\r' < "$f" > "$f.lf"; mv "$f.lf" "$f"; \
+    done; \
+    test -f /build/vendor/jo-src/jo.c
+
+RUN bash -euxo pipefail -c '\
+    nix-build /build/jo.nix -o /result \
+      --option substitute false \
+      --option ssl-cert-file /etc/nix/ca-bundle.crt \
+      2>&1 | tee /build/logs/10-jo-build.log'
+
+CMD ["/build/export-closure.sh", "/tmp/outputs", "/result"]
