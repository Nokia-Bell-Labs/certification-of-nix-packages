diff --git a/contrib/attestation/sign-attestation-certs.py b/contrib/attestation/sign-attestation-certs.py
new file mode 100755
index 0000000000000000000000000000000000000000..cf47543ca6416ffebc7a3fb2d5bba17dcc0d7f35
--- /dev/null
+++ b/contrib/attestation/sign-attestation-certs.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""Sign CACTEE/Nix attestation JSON with a Nix binary-cache secret key.
+
+The JSON on disk is not a trust root. Nix verifies
+  <hashPart>.attestation.sig
+using the same Ed25519 keys as .narinfo (trusted-public-keys).
+
+Fingerprint (UTF-8):
+  attestation:1;<storePath>;<narHash-SRI>;<sha256-SRI of cert bytes>
+
+Usage:
+  nix-store --generate-binary-cache-key harmonia-1 ./cache.secret ./cache.pub
+  python3 sign-attestation-certs.py --secret-key ./cache.secret \\
+      ~/dev_test_docker/test_temp/tmp/outputs
+
+Writes certificates/harmonia/<hashPart>.attestation.json and .sig
+Serve those two files next to Harmonia (proxy). Put cache.pub in
+trusted-public-keys on clients.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+
+
+def sri_sha256(data: bytes) -> str:
+    digest = hashlib.sha256(data).digest()
+    return "sha256-" + base64.b64encode(digest).decode("ascii")
+
+
+def fingerprint(store_path: str, nar_hash: str, cert_bytes: bytes) -> str:
+    return f"attestation:1;{store_path};{nar_hash};{sri_sha256(cert_bytes)}"
+
+
+def load_secret_key(path: Path) -> tuple[str, Ed25519PrivateKey]:
+    line = path.read_text(encoding="utf-8").strip().splitlines()[0]
+    name, b64 = line.split(":", 1)
+    raw = base64.b64decode(b64)
+    if len(raw) < 32:
+        raise SystemExit(f"ERROR: secret key too short: {path}")
+    # libsodium secret key is 64 bytes (seed || pubkey); Ed25519 seed is 32.
+    return name, Ed25519PrivateKey.from_private_bytes(raw[:32])
+
+
+def sign_line(key_name: str, key: Ed25519PrivateKey, data: bytes) -> str:
+    sig = key.sign(data)
+    return key_name + ":" + base64.b64encode(sig).decode("ascii")
+
+
+def hash_part(store_path: str) -> str:
+    base = Path(store_path).name
+    return base.split("-", 1)[0]
+
+
+def main() -> int:
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("exports", type=Path, help="export root with index.json + packages/ + certificates/")
+    p.add_argument("--secret-key", type=Path, required=True, help="nix binary-cache secret key")
+    args = p.parse_args()
+    exports = args.exports.resolve()
+    index = json.loads((exports / "index.json").read_text(encoding="utf-8"))
+    names = index.get("packages") or []
+    key_name, key = load_secret_key(args.secret_key)
+    out = exports / "certificates" / "harmonia"
+    out.mkdir(parents=True, exist_ok=True)
+
+    written = 0
+    for name in names:
+        man_path = exports / "packages" / name / "manifest.json"
+        cert_src = exports / "certificates" / f"{name}_asset_certificate.json"
+        if not man_path.is_file() or not cert_src.is_file():
+            print(f"SKIP {name}", file=sys.stderr)
+            continue
+        man = json.loads(man_path.read_text(encoding="utf-8"))
+        store_path = man.get("storePath") or ""
+        nar_hash = man.get("narHash") or ""
+        if not store_path or not nar_hash:
+            print(f"SKIP incomplete manifest {name}", file=sys.stderr)
+            continue
+        cert_bytes = cert_src.read_bytes()
+        fp = fingerprint(store_path, nar_hash, cert_bytes)
+        hp = hash_part(store_path)
+        json_path = out / f"{hp}.attestation.json"
+        sig_path = out / f"{hp}.attestation.sig"
+        json_path.write_bytes(cert_bytes)
+        sig_path.write_text(sign_line(key_name, key, fp.encode("utf-8")) + "\n", encoding="utf-8")
+        written += 1
+        print(f"  {hp}.attestation.json + .sig")
+
+    print(f"wrote {written} signed cert pair(s) under {out}")
+    print("Serve *.attestation.json and *.attestation.sig on the cache URL.")
+    print(f"Client trusted-public-keys must include the matching public key ({key_name}).")
+    return 0 if written else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
