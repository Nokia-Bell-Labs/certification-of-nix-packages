+)
diff --git a/contrib/attestation/package-builder/gen-package-nix.sh b/contrib/attestation/package-builder/gen-package-nix.sh
new file mode 100755
index 0000000000000000000000000000000000000000..d088c6aa2f8497daaa87129631bf0c48b46fc8fd
--- /dev/null
+++ b/contrib/attestation/package-builder/gen-package-nix.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# Emit one .nix per package name (`--from-list runtime-attrs.txt` or listed attrs).
+set -euo pipefail
+
+NIXPKGS_EXPR="${NIXPKGS_EXPR:-/build/nixpkgs-with-overlay.nix}"
+
+emit() {
+  local outdir=$1 attr=$2
+  local safe="${attr//\./-}"
+  local out="${outdir}/${safe}.nix"
+
+  cat > "${out}" <<EOF
+# ${attr} — generated by gen-package-nix.sh, do not edit by hand.
+{ pkgs ? import ${NIXPKGS_EXPR} }:
+
+pkgs.${attr}
+EOF
+  echo "    ${out}"
+}
+
+attrs_from_list() {
+  local file=$1
+  grep -v '^[[:space:]]*#' "$file" | grep -v '^[[:space:]]*$' | tr -d '\r'
+}
+
+if [ "${1:-}" = "--from-list" ]; then
+  LIST="${2:?list file required}"
+  OUTDIR="${3:?outdir required}"
+  mkdir -p "${OUTDIR}"
+  mapfile -t ATTRS < <(attrs_from_list "${LIST}")
+  [ "${#ATTRS[@]}" -gt 0 ] || { echo "ERROR: no attributes in ${LIST}" >&2; exit 1; }
+  echo "==> Generating ${#ATTRS[@]} package file(s) from ${LIST}"
+  for attr in "${ATTRS[@]}"; do
+    emit "${OUTDIR}" "${attr}"
+  done
+  printf '%s\n' "${ATTRS[@]}" > "${OUTDIR}/build-order.txt"
+  echo "==> Build order: ${OUTDIR}/build-order.txt"
+  exit 0
+fi
+
+OUTDIR="${1:?outdir required}"
+shift
+[ "$#" -gt 0 ] || { echo "ERROR: at least one nixpkgs attribute required" >&2; exit 1; }
+
+mkdir -p "${OUTDIR}"
+echo "==> Generating $# package file(s) in ${OUTDIR}"
+for attr in "$@"; do
+  emit "${OUTDIR}" "${attr}"
+done
+printf '%s\n' "$@" > "${OUTDIR}/build-order.txt"
+echo "==> Build order: ${OUTDIR}/build-order.txt"
diff --git a/contrib/attestation/package-builder/gnu-mirror-overlay.nix b/contrib/attestation/package-builder/gnu-mirror-overlay.nix
new file mode 100644
index 0000000000000000000000000000000000000000..6dce902068495eaf873f6f0d6e54c1d2c70e7627
--- /dev/null
+++ b/contrib/attestation/package-builder/gnu-mirror-overlay.nix
@@ -0,0 +1,146 @@
+# Override gnu-config: Savannah *cgit* is broken; use vendored files in vendor/gnu-config/.
+# GNU master (ftp.gnu.org) RST / truncated HTTP 200 through the proxy. Prefer kernel.org
+# (and gcc mirrors) first; hash still enforces the same source bytes.
+final: prev:
+let
+  inherit (prev) lib;
+  guess = ./vendor/gnu-config/config.guess;
+  sub = ./vendor/gnu-config/config.sub;
+
+  stripKnown =
+    url:
+    let
+      steps = [
+        "https://ftpmirror.gnu.org/gnu/"
+        "http://ftpmirror.gnu.org/gnu/"
+        "https://ftpmirror.gnu.org/"
+        "http://ftpmirror.gnu.org/"
+        "https://ftp.gnu.org/gnu/"
+        "https://ftp.gnu.org/pub/gnu/"
+        "http://ftp.gnu.org/gnu/"
+        "https://mirrors.kernel.org/gnu/"
+        "https://ftp.nluug.nl/pub/gnu/"
+      ];
+      go =
+        u: prefixes:
+        if prefixes == [ ] then
+          u
+        else
+          let p = lib.head prefixes; in
+          if lib.hasPrefix p u then lib.removePrefix p u else go u (lib.tail prefixes);
+    in
+    go url steps;
+
+  isGnuSource =
+    url:
+    lib.hasPrefix "https://ftpmirror.gnu.org/" url
+    || lib.hasPrefix "http://ftpmirror.gnu.org/" url
+    || lib.hasPrefix "https://ftp.gnu.org/gnu/" url
+    || lib.hasPrefix "https://ftp.gnu.org/pub/gnu/" url
+    || lib.hasPrefix "http://ftp.gnu.org/gnu/" url
+    || lib.hasPrefix "https://mirrors.kernel.org/gnu/" url;
+
+  gnuAlts =
+    url:
+    let
+      p = stripKnown url;
+      gccRel =
+        if lib.hasPrefix "gcc/" p then
+          let rest = lib.removePrefix "gcc/" p; in [
+            "https://mirrors.kernel.org/gnu/gcc/${rest}"
+            "https://bigsearcher.com/mirrors/gcc/releases/${rest}"
+            "https://mirror.koddos.net/gcc/releases/${rest}"
+          ]
+        else
+          [ ];
+    in
+    gccRel
+    ++ [
+      "https://mirrors.kernel.org/gnu/${p}"
+      "https://ftp.nluug.nl/pub/gnu/${p}"
+      "https://ftp.gnu.org/gnu/${p}"
+      "https://ftp.gnu.org/pub/gnu/${p}"
+    ];
+
+  gnuRewrite = url: if isGnuSource url then "https://mirrors.kernel.org/gnu/${stripKnown url}" else url;
+
+  savannahPath =
+    url:
+    lib.removePrefix "https://download.savannah.gnu.org/releases/" (
+      lib.removePrefix "http://download.savannah.gnu.org/releases/" (
+        lib.removePrefix "https://download.savannah.nongnu.org/releases/" (
+          lib.removePrefix "http://download.savannah.nongnu.org/releases/" url
+        )
+      )
+    );
+
+  isSavannah =
+    url:
+    lib.hasPrefix "https://download.savannah.gnu.org/releases/" url
+    || lib.hasPrefix "http://download.savannah.gnu.org/releases/" url
+    || lib.hasPrefix "https://download.savannah.nongnu.org/releases/" url
+    || lib.hasPrefix "http://download.savannah.nongnu.org/releases/" url;
+
+  savannahAlts =
+    url:
+    let p = savannahPath url; in [
+      "https://mirror.csclub.uwaterloo.ca/nongnu/${p}"
+      "https://ftp.igh.cnrs.fr/pub/nongnu/${p}"
+      "https://mirror.netcologne.de/savannah/${p}"
+      "https://download.savannah.gnu.org/releases/${p}"
+    ];
+
+  savannahRewrite =
+    url: if isSavannah url then "https://mirror.csclub.uwaterloo.ca/nongnu/${savannahPath url}" else url;
+
+  rewriteURL = url: savannahRewrite (gnuRewrite url);
+
+  withGnuMirrors =
+    args:
+    if !(builtins.isAttrs args) then
+      args
+    else
+      let
+        orig = args.urls or (lib.optional ((args.url or "") != "") args.url);
+        extra = lib.concatMap (
+          u:
+          (if isGnuSource u then gnuAlts u else [ ])
+          ++ (if isSavannah u then savannahAlts u else [ ])
+        ) orig;
+      in
+      if extra == [ ] then
+        args
+      else
+        (builtins.removeAttrs args [ "url" ])
+        // {
+          urls = lib.unique (extra ++ orig);
+        };
+
+  fetchurl' = prev.fetchurl.override { rewriteURL = rewriteURL; };
+in
+{
+  fetchurl = args: fetchurl' (withGnuMirrors args);
+
+  gnu-config = prev.gnu-config.overrideAttrs (_: {
+    unpackPhase = ''
+      runHook preUnpack
+      cp ${guess} ./config.guess
+      cp ${sub} ./config.sub
+      chmod +w ./config.sub ./config.guess
+      runHook postUnpack
+    '';
+  });
+
+  gnutar = prev.gnutar.overrideAttrs (old: {
+    env = (old.env or { }) // {
+      FORCE_UNSAFE_CONFIGURE = "1";
+    };
+  });
+
+  coreutils = prev.coreutils.overrideAttrs (old: {
+    env = (old.env or { }) // {
+      FORCE_UNSAFE_CONFIGURE = "1";
+    };
+    doCheck = false;
+  });
+}
diff --git a/contrib/attestation/package-builder/jo.nix b/contrib/attestation/package-builder/jo.nix
new file mode 100644
index 0000000000000000000000000000000000000000..c59b86088e25c5238941e00e29cd1bd28f558313
--- /dev/null
+++ b/contrib/attestation/package-builder/jo.nix
@@ -0,0 +1,31 @@
+# jo 1.7 from vendor/jo-src; import overlay nixpkgs, not <nixpkgs>.
+{ pkgs ? import /build/nixpkgs-with-overlay.nix }:
+
+pkgs.stdenv.mkDerivation rec {
+  pname = "jo";
+  version = "1.7";
+
+  src = ./vendor/jo-src;
+
+  # pkg-config supplies pkg.m4 for PKG_PROG_PKG_CONFIG in configure.ac.
+  nativeBuildInputs = [
+    pkgs.autoreconfHook
+    pkgs.pkg-config
+  ];
+
+  buildInputs = [ pkgs.bash-completion ];
+
+  installPhase = ''
+    runHook preInstall
+    mkdir -p $out/bin
+    install -m 0755 jo $out/bin/jo
+    runHook postInstall
+  '';
+
+  meta = with pkgs.lib; {
+    description = "Small utility to create JSON objects from the shell";
+    homepage = "https://github.com/jpmens/jo";
+    license = licenses.gpl3Only;
+    platforms = platforms.unix;
+  };
+}
diff --git a/contrib/attestation/package-builder/nix-docker.conf b/contrib/attestation/package-builder/nix-docker.conf
new file mode 100644
index 0000000000000000000000000000000000000000..c003d43e3029eae03309d2b6764b1f46ec4fa96e
--- /dev/null
+++ b/contrib/attestation/package-builder/nix-docker.conf
@@ -0,0 +1,26 @@
+# Attestation-enabled Nix configuration for TEE builds.
+sandbox = false
+filter-syscalls = false
+experimental-features = nix-command flakes
+# Must stay set: nixos/nix ships nixbld1..32. Empty here makes builders run as
+# root, and configure scripts in coreutils/tar refuse to run as root.
+build-users-group = nixbld
+# Hard requirement: no binary cache substitution (TEE attestation policy).
+substitute = false
+max-jobs = 4
+cores = 0
+ssl-cert-file = /etc/nix/ca-bundle.crt
+# Source mirror for tarballs when ftpmirror.gnu.org 502/504s (NOT cache.nixos.org).
+# gnu-config Savannah cgit is overridden by gnu-mirror-overlay.nix (vendored files).
+hashed-mirrors = https://tarballs.nixos.org
+download-attempts = 50
+connect-timeout = 60
+stalled-download-timeout = 600
+
+# TEE attestation (requires attestation-enabled Nix fork)
+# Uncomment after installing the fork and attestation tools:
+# require-attestation = true
+# attestation-store = /var/lib/nix-attestations
+# attestation-verifier = /usr/local/bin/nix-attestation-verify
+# post-build-hook = /usr/local/bin/nix-certifier
+# attestation-bootstrap-inputs = sha256-... sha256-...
diff --git a/contrib/attestation/package-builder/nix-fork-classic.nix b/contrib/attestation/package-builder/nix-fork-classic.nix
new file mode 100644
index 0000000000000000000000000000000000000000..591da5d76ed5b28c9ca58d57f1b8fb33c690c536
--- /dev/null
+++ b/contrib/attestation/package-builder/nix-fork-classic.nix
@@ -0,0 +1,121 @@
+# Build the Nix fork without flakes — nixpkgs 26.05 (same line as flake.nix).
+{ system ? builtins.currentSystem }:
+
+let
+  nixSrc = /nix-src;
+  officialRelease = false;
+  inputs = { };
+
+  pkgsBase = import /build/fork-nixpkgs { inherit system; };
+  inherit (pkgsBase) lib;
+
+  src = builtins.path {
+    path = nixSrc;
+    name = "nix";
+  };
+
+  packageSetsFor =
+    args@{
+      pkgs,
+      getStdenv ? pkgs: pkgs.stdenv,
+    }:
+    let
+      nixComponentsSplices = lib.mapCrossIndex (
+        pkgs': (packageSetsFor (args // { pkgs = pkgs'; })).nixComponents
+      ) (lib.renameCrossIndexFrom "pkgs" pkgs);
+
+      nixDependenciesSplices = lib.mapCrossIndex (
+        pkgs': (packageSetsFor (args // { pkgs = pkgs'; })).nixDependencies
+      ) (lib.renameCrossIndexFrom "pkgs" pkgs);
+
+      nixComponents =
+        lib.makeScopeWithSplicing'
+          {
+            inherit (pkgs) splicePackages;
+            inherit (nixDependencies) newScope;
+          }
+          {
+            otherSplices = lib.renameCrossIndexTo "self" nixComponentsSplices;
+            f = import "${nixSrc}/packaging/components.nix" {
+              inherit (pkgs) lib;
+              inherit officialRelease pkgs src;
+              maintainers = [ ];
+            };
+          };
+
+      nixDependencies =
+        lib.makeScopeWithSplicing'
+          {
+            inherit (pkgs) splicePackages;
+            inherit (pkgs) newScope;
+          }
+          {
+            otherSplices = lib.renameCrossIndexTo "self" nixDependenciesSplices;
+            f = import "${nixSrc}/packaging/dependencies.nix" {
+              inherit inputs pkgs;
+              stdenv = getStdenv pkgs;
+            };
+          };
+
+      fixup = attrs: if !(pkgs ? nix) then { } else attrs;
+    in
+    fixup {
+      inherit nixComponents nixDependencies;
+    };
+
+  overlayFor =
+    getStdenv: final: prev:
+    let
+      packageSets = packageSetsFor {
+        inherit getStdenv;
+        pkgs = final;
+      };
+    in
+    {
+      nixComponents2 = packageSets.nixComponents;
+      nixDependencies2 = packageSets.nixDependencies;
+      nix = packageSets.nixComponents.nix-cli;
+    };
+
+  pkgs = import /build/fork-nixpkgs {
+    inherit system;
+    overlays = [ (overlayFor (p: p.stdenv)) ];
+  };
+
+  nixComponents = pkgs.nixComponents2.overrideScope (
+    _: prev:
+    {
+      withUnityBuild = false;
+      nix-store = prev.nix-store.override {
+        withAWS = false;
+        sandboxShell = "${pkgs.busybox-sandbox-shell}/bin/busybox";
+      };
+    }
+  );
+
+  devFlakeStub = {
+    getSystem =
+      _:
+      {
+        pre-commit.settings = {
+          rawConfig = { repos = [ ]; };
+          package = pkgs.writeShellScriptBin "pre-commit" "exit 0";
+          installationScript = "true";
+        };
+      };
+  };
+
+  shell = (import "${nixSrc}/packaging/dev-shell.nix" {
+    inherit (pkgs) lib;
+    devFlake = devFlakeStub;
+  }) {
+    inherit pkgs;
+    inherit nixComponents;
+  };
+
+in
+{
+  inherit pkgs nixComponents shell;
+  nix-cli = nixComponents.nix-cli;
+  default = nixComponents.nix-cli;
+}
