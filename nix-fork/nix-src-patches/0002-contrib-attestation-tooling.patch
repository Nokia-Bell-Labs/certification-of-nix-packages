+#!/usr/bin/env python3
+"""Shared binding record v1 computation for Nix TEE attestation."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Dict, List
+
+
+def compute_binding(drv: str, inputs: List[str], outputs: Dict[str, str]) -> str:
+    """Compute the binding digest (SRI sha256) for a binding record v1."""
+    sorted_inputs = sorted(inputs)
+    sorted_outputs = sorted(f"{k}={v}" for k, v in outputs.items())
+    payload = (
+        "version=1\n"
+        f"drv={drv}\n"
+        f"inputs={','.join(sorted_inputs)}\n"
+        f"outputs={','.join(sorted_outputs)}\n"
+    )
+    digest = hashlib.sha256(payload.encode("utf-8")).digest()
+    return "sha256-" + _b64encode(digest)
+
+
+def _b64encode(data: bytes) -> str:
+    """Base64 with padding, matching Nix's SRI output.
+
+    Nix's Hash::to_string(HashFormat::SRI) keeps the '=' padding, so stripping
+    it here would make every certificate's binding digest disagree with the
+    digest libstore recomputes in validateCertificateStructure.
+    """
+    import base64
+
+    return base64.b64encode(data).decode("ascii")
+
+
+def make_certificate(
+    drv: str,
+    inputs: List[str],
+    outputs: Dict[str, str],
+    quote_b64: str,
+    attestation_type: str = "tdx",
+) -> dict:
+    """Build a complete binding record v1 certificate."""
+    sorted_inputs = sorted(inputs)
+    binding = compute_binding(drv, sorted_inputs, outputs)
+    return {
+        "version": 1,
+        "drv": drv,
+        "outputs": outputs,
+        "inputs": sorted_inputs,
+        "binding": binding,
+        "attestation": {"type": attestation_type, "quote": quote_b64},
+    }
+
+
+def validate_certificate(cert: dict, expected_output_hash: str) -> None:
+    """Structural validation of a binding record v1 certificate."""
+    if cert.get("version") != 1:
+        raise ValueError("invalid or missing version")
+    if "binding" not in cert:
+        raise ValueError("missing binding")
+    if not isinstance(cert.get("inputs"), list):
+        raise ValueError("missing inputs array")
+    if not isinstance(cert.get("outputs"), dict):
+        raise ValueError("missing outputs object")
+    if not isinstance(cert.get("attestation"), dict):
+        raise ValueError("missing attestation object")
+
+    expected_binding = compute_binding(
+        cert["drv"],
+        cert["inputs"],
+        cert["outputs"],
+    )
+    if cert["binding"] != expected_binding:
+        raise ValueError(
+            f"binding mismatch: expected {expected_binding}, got {cert['binding']}"
+        )
+
+    if expected_output_hash not in cert["outputs"].values():
+        raise ValueError(
+            f"output hash {expected_output_hash} not found in certificate outputs"
+        )
+
+
+def write_certificate(cert: dict, store_dir: str, output_hash: str) -> str:
+    """Write certificate to attestation store, return path."""
+    import os
+
+    os.makedirs(store_dir, exist_ok=True)
+    path = os.path.join(store_dir, f"{output_hash}.json")
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(cert, f, indent=2, sort_keys=True)
+        f.write("\n")
+    return path
diff --git a/contrib/attestation/fix-wsl-symlinks.py b/contrib/attestation/fix-wsl-symlinks.py
new file mode 100755
index 0000000000000000000000000000000000000000..7e855b8d7ae8da4eb673021ac855e54de9b4684c
--- /dev/null
+++ b/contrib/attestation/fix-wsl-symlinks.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+import os
+import sys
+
+repo = sys.argv[1] if len(sys.argv) > 1 else "."
+SKIP = {".git", "build", "outputs", "result"}
+n = 0
+for root, dirs, files in os.walk(repo):
+    dirs[:] = [d for d in dirs if d not in SKIP]
+    for name in files:
+        path = os.path.join(root, name)
+        try:
+            if os.path.islink(path) or os.path.getsize(path) > 256:
+                continue
+            text = open(path, "rb").read().decode("utf-8").strip().replace("\\", "/")
+        except OSError:
+            continue
+        except UnicodeDecodeError:
+            continue
+        if not text.startswith("../") or "\n" in text:
+            continue
+        dest = os.path.normpath(os.path.join(os.path.dirname(path), text))
+        if not os.path.exists(dest):
+            continue
+        os.remove(path)
+        os.symlink(text, path)
+        print("symlink", os.path.relpath(path, repo), "->", text)
+        n += 1
+print("fixed", n, "symlinks")
diff --git a/contrib/attestation/ingest-nars-to-store.py b/contrib/attestation/ingest-nars-to-store.py
new file mode 100755
index 0000000000000000000000000000000000000000..87c0afa3881ad39dd12146085565eff1a496c929
--- /dev/null
+++ b/contrib/attestation/ingest-nars-to-store.py
@@ -0,0 +1,174 @@
+#!/usr/bin/env python3
+"""Register every NAR in an export tree into the local Nix store and bind cert+sig.
+
+Package-agnostic: walks index.json `packages` (leaves-first). The export
+`root` (jo, hello, gcc, …) is only used if you pass --copy-to.
+
+  python3 ingest-nars-to-store.py --outputs /path/to/outputs \\
+      --nix-store /path/to/fork/nix-store \\
+      --copy-to ssh://user@harmonia-host
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+
+def nix_env(nix_store: str) -> dict[str, str]:
+    """Prefix-install has no RPATH; libs live in <prefix>/lib."""
+    env = os.environ.copy()
+    lib = str(Path(nix_store).resolve().parent.parent / "lib")
+    prev = env.get("LD_LIBRARY_PATH", "")
+    env["LD_LIBRARY_PATH"] = lib if not prev else lib + ":" + prev
+    return env
+
+
+def valid_store_path(p: str) -> bool:
+    return isinstance(p, str) and p.startswith("/nix/store/") and len(Path(p).name) > 32
+
+
+def load_pub_key(path: Path) -> str:
+    return path.expanduser().read_text(encoding="utf-8").strip().splitlines()[0]
+
+
+def nix_store_prefix(args: argparse.Namespace, cache_pub: str) -> list[str]:
+    home = Path.home()
+    store_dir = args.attestation_store or str(home / "nix-attestations")
+    harmonia_dir = args.attestation_harmonia_dir or str(home / "harmonia-attest")
+    Path(store_dir).mkdir(parents=True, exist_ok=True)
+    Path(harmonia_dir).mkdir(parents=True, exist_ok=True)
+    cmd = [args.nix_store]
+    if cache_pub:
+        cmd += ["--option", "extra-trusted-public-keys", cache_pub]
+    cmd += [
+        "--option",
+        "attestation-store",
+        store_dir,
+        "--option",
+        "attestation-harmonia-dir",
+        harmonia_dir,
+    ]
+    return cmd
+
+
+def main() -> int:
+    p = argparse.ArgumentParser(
+        description="Import all attested NARs from an export dir, then optionally copy-closure the export root."
+    )
+    p.add_argument(
+        "--outputs",
+        type=Path,
+        required=True,
+        help="Export root with index.json, packages/, nars/, certificates/harmonia/",
+    )
+    p.add_argument(
+        "--nix-store",
+        default=os.environ.get("NIX_STORE", "nix-store"),
+        help="Forked nix-store with --import-nar",
+    )
+    p.add_argument(
+        "--root",
+        default="",
+        help="Store path to copy-closure (default: index.json \"root\")",
+    )
+    p.add_argument(
+        "--copy-to",
+        default="",
+        help="nix-copy-closure destination, e.g. ssh://user@host",
+    )
+    p.add_argument("--dry-run", action="store_true")
+    p.add_argument(
+        "--cache-pub",
+        type=Path,
+        default=Path(__file__).resolve().parent / "cache.pub",
+        help="Ed25519 public key that signed certificates/harmonia/*.sig",
+    )
+    p.add_argument("--attestation-store", default="")
+    p.add_argument("--attestation-harmonia-dir", default="")
+    args = p.parse_args()
+    outputs = args.outputs.expanduser().resolve()
+    index_path = outputs / "index.json"
+    if not index_path.is_file():
+        print(f"no index.json at {index_path}", file=sys.stderr)
+        return 1
+    index = json.loads(index_path.read_text(encoding="utf-8"))
+    cache_pub = ""
+    if args.cache_pub.is_file():
+        cache_pub = load_pub_key(args.cache_pub)
+        print(f"using extra-trusted-public-keys {cache_pub}", flush=True)
+    else:
+        print(
+            f"warning: no cache.pub at {args.cache_pub}; "
+            "signature check needs extra-trusted-public-keys",
+            file=sys.stderr,
+        )
+    prefix = nix_store_prefix(args, cache_pub)
+    certs = outputs / "certificates" / "harmonia"
+    names = index.get("packages") or []
+    n = 0
+    skipped = 0
+    for pkg in names:
+        man_path = outputs / "packages" / pkg / "manifest.json"
+        if not man_path.is_file():
+            skipped += 1
+            continue
+        man = json.loads(man_path.read_text(encoding="utf-8"))
+        if man.get("kind") != "nar":
+            skipped += 1
+            continue
+        store_path = man["storePath"]
+        hp = Path(store_path).name[:32]
+        json_p = certs / f"{hp}.attestation.json"
+        sig_p = certs / f"{hp}.attestation.sig"
+        nar = outputs / man["narFile"]
+        if not nar.is_file() or not json_p.is_file() or not sig_p.is_file():
+            print(f"skip (missing nar or sidecar): {pkg}", file=sys.stderr)
+            skipped += 1
+            continue
+        cmd = prefix + [
+            "--import-nar",
+            store_path,
+            str(nar),
+            "--nar-hash",
+            man["narHash"],
+            "--attestation-json",
+            str(json_p),
+            "--attestation-sig",
+            str(sig_p),
+        ]
+        drv = man.get("drvPath")
+        if valid_store_path(drv or ""):
+            cmd += ["--deriver", drv]
+        for dep in man.get("directInputs") or []:
+            sp = dep.get("storePath") if isinstance(dep, dict) else None
+            if valid_store_path(sp or ""):
+                cmd += ["--references", sp]
+        print("+", " ".join(cmd), flush=True)
+        if not args.dry_run:
+            subprocess.run(cmd, check=True, env=nix_env(args.nix_store))
+        n += 1
+
+    root = args.root or index.get("root") or ""
+    print(f"imported {n} paths ({skipped} skipped); export root: {root or '(none)'}")
+    if not args.copy_to:
+        if root:
+            print(f"  nix-copy-closure --to ssh://USER@HOST {root}")
+        return 0
+    if not root:
+        print("--copy-to needs index.json \"root\" or --root", file=sys.stderr)
+        return 1
+    copy_bin = str(Path(args.nix_store).resolve().parent / "nix-copy-closure")
+    copy = [copy_bin, "--to", args.copy_to, root]
+    print("+", " ".join(copy), flush=True)
+    if not args.dry_run:
+        subprocess.run(copy, check=True, env=nix_env(args.nix_store))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/contrib/attestation/nix-attestation-backfill b/contrib/attestation/nix-attestation-backfill
new file mode 100755
index 0000000000000000000000000000000000000000..87782e17480020f7c71cb0efe1628e9ef7aba564
--- /dev/null
+++ b/contrib/attestation/nix-attestation-backfill
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+"""
+Mint certificates for an already-built closure, so require-attestation can be
+switched on without rejecting everything.
+
+Certificates are normally produced by the post-build-hook as each derivation is
+built. A store populated before attestation was enabled therefore has none, and
+because verifyDirectInputAttestations demands a certificate for every direct
+input, the first enforced build fails on inputs that are perfectly fine. This
+walks an existing closure and writes the certificates that the hook would have
+written.
+
+Paths with no deriver (added with nix-store --add-fixed, e.g. bootstrap-tools
+and busybox) cannot be certified, because there is no derivation to bind to.
+Those are reported as bootstrap NAR hashes for attestation-bootstrap-inputs.
+
+Usage:
+  nix-attestation-backfill /path/to/result [more paths...]
+  ATTESTATION_STORE=/var/lib/nix-attestations \
+  ATTESTATION_STUB_MODE=1 nix-attestation-backfill /result
+"""
+
+from __future__ import annotations
+
+import base64
+import collections
+import json
+import os
+import subprocess
+import sys
+
+from binding import compute_binding, make_certificate, write_certificate
+
+NIX_FLAGS = ["--extra-experimental-features", "nix-command"]
+
+
+def run(cmd: list[str]) -> str:
+    result = subprocess.run(cmd, check=True, capture_output=True, text=True)
+    return result.stdout.strip()
+
+
+def try_run(cmd: list[str]) -> str | None:
+    try:
+        return run(cmd)
+    except subprocess.CalledProcessError:
+        return None
+
+
+def nar_hash_sri(store_path: str) -> str:
+    info = json.loads(run(["nix", *NIX_FLAGS, "path-info", "--json", store_path]))
+    if isinstance(info, dict):
+        return info[store_path]["narHash"]
+    return info[0]["narHash"]
+
+
+def derivation_show(drv_path: str) -> dict:
+    raw = run(["nix", *NIX_FLAGS, "derivation", "show", drv_path])
+    return json.loads(raw)[drv_path]
+
+
+def direct_input_paths(drv_path: str) -> list[str]:
+    """Same set libstore checks: inputSrcs plus the consumed input outputs."""
+    data = derivation_show(drv_path)
+    paths: list[str] = list(data.get("inputSrcs", []))
+
+    for input_drv, spec in data.get("inputDrvs", {}).items():
+        wanted = spec.get("outputs", []) if isinstance(spec, dict) else list(spec)
+        input_outputs = derivation_show(input_drv).get("outputs", {})
+        for name in wanted:
+            path = input_outputs.get(name, {}).get("path")
+            if path:
+                paths.append(path)
+
+    return list(dict.fromkeys(paths))
+
+
+def stub_quote(binding: str) -> str:
+    return base64.b64encode(binding.encode("utf-8")).decode("ascii")
+
+
+def get_quote(binding: str) -> str:
+    if os.environ.get("ATTESTATION_STUB_MODE", "0") == "1":
+        return stub_quote(binding)
+    quote_tool = os.environ.get("ATTESTATION_QUOTE_TOOL", "")
+    if not quote_tool:
+        return stub_quote(binding)
+    return run([quote_tool, binding])
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) < 2:
+        print(__doc__, file=sys.stderr)
+        return 2
+
+    store_dir = os.environ.get("ATTESTATION_STORE", "/var/lib/nix-attestations")
+    targets = argv[1:]
+
+    print(f"==> Collecting closure of {len(targets)} target(s)")
+    closure: list[str] = []
+    for target in targets:
+        closure.extend(run(["nix-store", "-q", "--requisites", target]).splitlines())
+    closure = list(dict.fromkeys(p for p in closure if p and not p.endswith(".drv")))
+    print(f"    {len(closure)} store paths")
+
+    # Group outputs by deriver: one certificate covers all outputs of a
+    # derivation, exactly as the post-build hook produces it.
+    by_deriver: dict[str, list[str]] = collections.defaultdict(list)
+    orphans: list[str] = []
+
+    for path in closure:
+        deriver = try_run(["nix-store", "-q", "--deriver", path])
+        if not deriver or deriver == "unknown-deriver" or not os.path.exists(deriver):
+            orphans.append(path)
+        else:
+            by_deriver[deriver].append(path)
+
+    print(f"==> {len(by_deriver)} derivations to certify, {len(orphans)} without a deriver")
+
+    written = 0
+    failed = 0
+    for drv_path, out_paths in sorted(by_deriver.items()):
+        try:
+            outputs_meta = derivation_show(drv_path).get("outputs", {})
+            name_by_path = {
+                meta.get("path"): name
+                for name, meta in outputs_meta.items()
+                if meta.get("path")
+            }
+
+            output_hashes = {
+                name_by_path.get(p, "out"): nar_hash_sri(p) for p in out_paths
+            }
+            input_hashes = sorted(nar_hash_sri(p) for p in direct_input_paths(drv_path))
+
+            binding = compute_binding(drv_path, input_hashes, output_hashes)
+            cert = make_certificate(
+                drv_path, input_hashes, output_hashes, get_quote(binding)
+            )
+
+            for out_hash in output_hashes.values():
+                write_certificate(cert, store_dir, out_hash)
+                written += 1
+        except Exception as exc:  # noqa: BLE001 - report and continue
+            failed += 1
+            print(f"    FAILED {drv_path}: {exc}", file=sys.stderr)
+
+    print("")
+    print("================ BACKFILL SUMMARY ================")
+    print(f"  Certificates written : {written}")
+    print(f"  Derivations failed   : {failed}")
+    print(f"  Store                : {store_dir}")
+    print("==================================================")
+
+    if orphans:
+        hashes = sorted(nar_hash_sri(p) for p in orphans)
+        print("")
+        print("Paths with no deriver cannot be certified. Add these to nix.conf:")
+        print("")
+        print("attestation-bootstrap-inputs = " + " ".join(hashes))
+        print("")
+        for path in sorted(orphans):
+            print(f"  # {path}")
+
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/contrib/attestation/nix-attestation-verify b/contrib/attestation/nix-attestation-verify
new file mode 100755
index 0000000000000000000000000000000000000000..78c99dcda71e02aec10ceb9a5a57c557c77a07be
--- /dev/null
+++ b/contrib/attestation/nix-attestation-verify
@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""
+External attestation verifier for Nix require-attestation.
+
+Usage:
+  nix-attestation-verify <certificate.json>
+
+Exit 0 if valid, non-zero otherwise.
+
+Accepts binding record v1, or a CACTEE asset_certificate.json that embeds
+nix_binding. In stub/POC mode (ATTESTATION_STUB_MODE=1 or attestation.type
+poc-cactee/stub), quote cryptography is not required.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import os
+import sys
+
+from binding import validate_certificate
+
+
+def unwrap(cert: dict) -> dict:
+    if cert.get("version") == 1 and "binding" in cert:
+        return cert
+    nested = (
+        cert.get("duet_service_result", {})
+        .get("service_result", {})
+        .get("nix_binding")
+    )
+    if isinstance(nested, dict):
+        return nested
+    raise ValueError(
+        "certificate is neither binding record v1 nor CACTEE with nix_binding"
+    )
+
+
+def output_hash_from_filename(basename: str, binding: dict) -> str:
+    stem = basename[:-5]
+    restored = stem.replace("_", "/")
+    values = list(binding.get("outputs", {}).values())
+    if restored in values:
+        return restored
+    if stem in values:
+        return stem
+    for v in values:
+        if isinstance(v, str) and v.replace("/", "_") == stem:
+            return v
+    if values:
+        return values[0]
+    raise ValueError("certificate has no outputs to verify against")
+
+
+def verify_quote(binding: dict) -> None:
+    att = binding.get("attestation", {})
+    kind = att.get("type")
+    if kind in ("poc-cactee", "stub"):
+        return
+    if os.environ.get("ATTESTATION_STUB_MODE", "0") == "1" and kind == "tdx":
+        quote_b64 = att.get("quote", "")
+        padded = quote_b64 + "=" * (-len(quote_b64) % 4)
+        try:
+            decoded = base64.b64decode(padded, validate=True).decode("utf-8")
+        except Exception:
+            decoded = ""
+        if decoded != binding["binding"]:
+            raise ValueError("stub quote does not match binding digest")
+        return
+    if kind != "tdx":
+        raise ValueError(f"unsupported attestation type: {kind}")
+
+    quote_b64 = att.get("quote", "")
+    if not quote_b64:
+        raise ValueError("empty quote")
+
+    verify_tool = os.environ.get("ATTESTATION_VERIFY_TOOL", "")
+    if not verify_tool:
+        raise ValueError(
+            "no ATTESTATION_VERIFY_TOOL set and ATTESTATION_STUB_MODE is not 1, "
+            "so the TDX quote cannot be verified; set ATTESTATION_VERIFY_TOOL, "
+            "or set ATTESTATION_STUB_MODE=1 for development"
+        )
+
+    import subprocess
+
+    result = subprocess.run(
+        [verify_tool, quote_b64, binding["binding"]],
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0:
+        raise ValueError(f"TDX quote verification failed: {result.stderr}")
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        print(f"usage: {sys.argv[0]} <certificate.json>", file=sys.stderr)
+        return 2
+
+    cert_path = sys.argv[1]
+    with open(cert_path, encoding="utf-8") as f:
+        cert = json.load(f)
+
+    basename = os.path.basename(cert_path)
+    if not basename.endswith(".json"):
+        print("ERROR: certificate filename must end in .json", file=sys.stderr)
+        return 1
+
+    try:
+        binding = unwrap(cert)
+        expected_hash = output_hash_from_filename(basename, binding)
+        validate_certificate(binding, expected_hash)
+        verify_quote(binding)
+    except (ValueError, KeyError) as e:
+        print(f"ERROR: {e}", file=sys.stderr)
+        return 1
+
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
