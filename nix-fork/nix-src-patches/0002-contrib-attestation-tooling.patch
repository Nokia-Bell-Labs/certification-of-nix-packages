diff --git a/contrib/attestation/package-builder/sync-nix-cache.sh b/contrib/attestation/package-builder/sync-nix-cache.sh
new file mode 100755
index 0000000000000000000000000000000000000000..43c6f55cb45d12f4a45c45dc31c4093a3412faba
--- /dev/null
+++ b/contrib/attestation/package-builder/sync-nix-cache.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# Copy /nix into or out of a BuildKit cache mount.
+#
+# Cache mounts persist when a RUN fails; image layers do not. We never mount
+# over /nix itself: that would hide the nixos/nix install, and a successful
+# compile would leave nix-tee-base without a store (nokia-runner / test_docker.py
+# use the classic builder and FROM nix-tee-base).
+set -euo pipefail
+
+STORE_CACHE="${NIX_TEE_STORE_CACHE:-/mnt/nix-tee-cache/store}"
+VAR_CACHE="${NIX_TEE_VAR_CACHE:-/mnt/nix-tee-cache/var}"
+
+copy_tree() {
+  local src="$1" dest="$2"
+  mkdir -p "${dest}"
+  if command -v rsync >/dev/null 2>&1; then
+    rsync -aH "${src}/" "${dest}/"
+  else
+    tar -C "${src}" -cf - . | tar -C "${dest}" -xf -
+  fi
+}
+
+cmd="${1:-}"
+case "${cmd}" in
+  restore)
+    if [ ! -f "${VAR_CACHE}/nix/db/db.sqlite" ]; then
+      echo "==> Nix BuildKit cache empty — using image /nix"
+      exit 0
+    fi
+    echo "==> Restoring /nix/store from BuildKit cache"
+    copy_tree "${STORE_CACHE}" /nix/store
+    echo "==> Restoring /nix/var from BuildKit cache"
+    copy_tree "${VAR_CACHE}" /nix/var
+    echo "==> Nix cache restore done"
+    ;;
+  save)
+    echo "==> Saving /nix/store to BuildKit cache"
+    copy_tree /nix/store "${STORE_CACHE}"
+    echo "==> Saving /nix/var to BuildKit cache"
+    copy_tree /nix/var "${VAR_CACHE}"
+    echo "==> Nix cache save done"
+    ;;
+  *)
+    echo "usage: $0 restore|save" >&2
+    exit 1
+    ;;
+esac
