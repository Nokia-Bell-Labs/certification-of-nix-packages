diff --git a/contrib/attestation/package-builder/prefetch.sh b/contrib/attestation/package-builder/prefetch.sh
new file mode 100755
index 0000000000000000000000000000000000000000..838080bf10a7a00f5179342f747e88c6c5f01d4e
--- /dev/null
+++ b/contrib/attestation/package-builder/prefetch.sh
@@ -0,0 +1,461 @@
+#!/usr/bin/env bash
+# All prefetch logic in one place (nixos/nix Docker image, nixpkgs 26.05).
+#
+# Usage:
+#   prefetch.sh fork            — bootstrap seeds + busybox tarball (nix-tee-base compile)
+#   prefetch.sh jo              — jo source into vendor/ (package-builder stage)
+#   prefetch.sh vendor-busybox  — download busybox tarball on host into vendor/
+set -euo pipefail
+
+: "${SSL_CERT_FILE:=/etc/nix/ca-bundle.crt}"
+: "${NIXPKGS:=/nixpkgs}"
+
+NIX_OPTS=(--option substitute false --option ssl-cert-file "${SSL_CERT_FILE}")
+
+# Bootstrap files: hashes follow the unpacked /nixpkgs stdenv (26.05). If they
+# drift, prefetch warns and the real build fetches them itself.
+BOOTSTRAP_TOOLS_URL="http://tarballs.nixos.org/stdenv/x86_64-unknown-linux-gnu/82b583ba2ba2e5706b35dbe23f31362e62be2a9d/bootstrap-tools.tar.xz"
+BOOTSTRAP_TOOLS_HASH="sha256-YQlr088HPoVWBU2jpPhpIMyOyoEDZYDw1y60SGGbUM0="
+BOOTSTRAP_BUSYBOX_URL="http://tarballs.nixos.org/stdenv/x86_64-unknown-linux-gnu/82b583ba2ba2e5706b35dbe23f31362e62be2a9d/busybox"
+BOOTSTRAP_BUSYBOX_HASH="sha256-QrTEnQTBM1Y/qV9odq8irZkQSD9uOMbs2Q5NgCvKCNQ="
+
+BUSYBOX_TARBALL_HASH="sha256-uMwkyVdNgJ5yecO+NJeVxdXOtv3xnKcJ+AzeUOR94xQ="
+BUSYBOX_VENDOR="/build/vendor/busybox-1.36.1.tar.bz2"
+
+# 26.05 stdenv source-bootstrap (tinycc-musl). repo.or.cz cgit snapshots are not
+# stable FODs — tarballs.nixos.org does not mirror this file.
+TINYCC_REV="cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341"
+TINYCC_URL="https://repo.or.cz/tinycc.git/snapshot/${TINYCC_REV}.tar.gz"
+# Must match fetchurl `name` (basename) so --add-fixed hits the FOD path.
+TINYCC_VENDOR="/build/vendor/tinycc-${TINYCC_REV}.tar.gz"
+TINYCC_FILE_URL="file://${TINYCC_VENDOR}"
+# Literal in musl.nix/mes.nix (Nix interpolates ${rev}).
+TINYCC_NIX_URL='https://repo.or.cz/tinycc.git/snapshot/${rev}.tar.gz'
+TINYCC_HASH_PINNED="sha256-MRuqq3TKcfIahtUWdhAcYhqDiGPkAjS8UTMsDE+/jGU="
+
+JO_VERSION=1.7
+# GitHub auto-generated archives are not a stable FOD; pin updated 2026-09-10
+# from the bytes curl actually got (was sha256-uJUbe593k7ENfbKCFhmm4Io0CPB109LF9EH8Qw0BFiY=).
+JO_HASH="sha256-FYKEcsy5xGTIAJmoWaJUoVHg9JtmA3A5ipeJDqUkMPk="
+JO_URL="https://github.com/jpmens/jo/archive/${JO_VERSION}.tar.gz"
+JO_OUT=/build/vendor/jo-src
+
+sri_to_base64() {
+  printf '%s' "${1#sha256-}"
+}
+
+nix_fetchurl() {
+  local hash="$1"
+  local url="$2"
+  local b64
+  b64=$(sri_to_base64 "${hash}")
+  nix-build '<nix/fetchurl.nix>' \
+    --argstr url "${url}" \
+    --argstr sha256 "${b64}" \
+    --no-out-link \
+    "${NIX_OPTS[@]}"
+}
+
+# Executable bootstrap busybox — curl+chmod cannot match FOD hash; use builtin fetchurl.
+nix_fetch_executable() {
+  local hash="$1"
+  local url="$2"
+  nix-instantiate --eval --raw -E "
+    builtins.fetchurl {
+      url = \"${url}\";
+      hash = \"${hash}\";
+      executable = true;
+    }
+  "
+}
+
+mirror_http_https() {
+  printf '%s\n' "$1"
+  case "$1" in
+    http://*) printf '%s\n' "https://${1#http://}" ;;
+    https://*) printf '%s\n' "http://${1#https://}" ;;
+  esac
+}
+
+try_urls_fetchurl() {
+  local hash="$1"
+  local name="$2"
+  shift 2
+  local urls=("$@")
+  local url path
+
+  echo "==> Prefetch: ${name}" >&2
+  for url in "${urls[@]}"; do
+    echo "    fetchurl: ${url}" >&2
+    if path=$(nix_fetchurl "${hash}" "${url}" 2>/dev/null); then
+      echo "    ok -> ${path}" >&2
+      printf '%s' "${path}"
+      return 0
+    fi
+  done
+  return 1
+}
+
+append_bootstrap_hashes() {
+  local tools_path="$1"
+  local busybox_path="$2"
+  local conf=/etc/nix/nix.conf
+  local line has=0
+  local tools_hash busybox_hash
+
+  tools_hash=$(nix hash path --sri "${tools_path}")
+  busybox_hash=$(nix hash path --sri "${busybox_path}")
+
+  echo "==> Bootstrap attestation hashes:"
+  echo "  tools:   ${tools_hash}"
+  echo "  busybox: ${busybox_hash}"
+
+  if [ -f "${conf}" ]; then
+    while IFS= read -r line || [ -n "${line}" ]; do
+      case "${line}" in attestation-bootstrap-inputs*) has=1; break ;; esac
+    done < "${conf}"
+  fi
+  if [ "${has}" -eq 0 ]; then
+    echo "attestation-bootstrap-inputs = ${tools_hash} ${busybox_hash}" >> "${conf}"
+  fi
+}
+
+# nixos/nix image has no sed/grep; rewrite in bash.
+replace_string_in_file() {
+  local src="$1" old="$2" new="$3"
+  local out line found=0
+  out=$(mktemp)
+  while IFS= read -r line || [ -n "${line}" ]; do
+    if [[ "${line}" == *"${old}"* ]]; then
+      found=1
+      line="${line//"${old}"/"${new}"}"
+    fi
+    printf '%s\n' "${line}"
+  done < "${src}" > "${out}"
+  if [ "${found}" -eq 0 ]; then
+    rm -f "${out}"
+    return 1
+  fi
+  cat "${out}" > "${src}"
+  rm -f "${out}"
+}
+
+# Bootstrap ungz + untar: simple gzip + ustar, top dir tinycc-<7-char rev>.
+# repo.or.cz "snapshot.tar.gz" is often HTML or uncompressed tar, not gzip.
+pack_tinycc_for_ungz() {
+  local dest="$1"
+  local work top want tarpath
+  want="tinycc-${TINYCC_REV:0:7}"
+  work=$(mktemp -d)
+  mkdir -p "${work}/in" "${work}/out"
+
+  if gzip -t "${dest}" 2>/dev/null; then
+    gzip -dc "${dest}" | tar -C "${work}/in" -xf -
+  elif tar -tf "${dest}" >/dev/null 2>&1; then
+    echo "    note: download was tar, not gzip (cgit/HTML-or-raw-tar)"
+    tar -C "${work}/in" -xf "${dest}"
+  else
+    echo "ERROR: TinyCC download is not gzip or tar (likely HTML). First bytes:" >&2
+    head -c 240 "${dest}" >&2 || true
+    echo >&2
+    rm -rf "${work}"
+    exit 1
+  fi
+
+  top=$(cd "${work}/in" && printf '%s' *)
+  if [ ! -d "${work}/in/${top}" ]; then
+    echo "ERROR: TinyCC archive has no top directory (${top})" >&2
+    rm -rf "${work}"
+    exit 1
+  fi
+  mv "${work}/in/${top}" "${work}/out/${want}"
+
+  tarpath="${work}/tinycc.tar"
+  if tar --format=ustar -C "${work}/out" -cf "${tarpath}" "${want}" 2>/dev/null; then
+    :
+  else
+    tar -C "${work}/out" -cf "${tarpath}" "${want}"
+  fi
+  gzip -n -1 -c "${tarpath}" > "${dest}"
+  rm -rf "${work}"
+}
+
+download_tinycc() {
+  local dest="$1" url sz
+  for url in \
+    "https://codeload.github.com/TinyCC/tinycc/tar.gz/${TINYCC_REV}" \
+    "https://github.com/TinyCC/tinycc/archive/${TINYCC_REV}.tar.gz" \
+    "${TINYCC_URL}"; do
+    echo "    fetch ${url}"
+    if curl -fsSL --retry 8 --retry-all-errors --cacert "${SSL_CERT_FILE}" \
+        -o "${dest}" "${url}"; then
+      sz=$(wc -c < "${dest}")
+      if [ "${sz}" -gt 50000 ]; then
+        echo "    bytes ${sz}"
+        return 0
+      fi
+      echo "    too small (${sz}), skip" >&2
+    fi
+  done
+  return 1
+}
+
+pin_tinycc_snapshot() {
+  local actual f
+  echo "==> Prefetch: tinycc ${TINYCC_REV} (GitHub/cgit → ustar+gzip for ungz)"
+  mkdir -p /build/vendor
+  if ! download_tinycc "${TINYCC_VENDOR}"; then
+    echo "ERROR: tinycc download failed" >&2
+    exit 1
+  fi
+  pack_tinycc_for_ungz "${TINYCC_VENDOR}"
+  actual=$(nix hash file --sri "${TINYCC_VENDOR}")
+  echo "    sri ${actual}"
+  echo "    vendor ${TINYCC_VENDOR}"
+  for f in \
+    "${NIXPKGS}/pkgs/os-specific/linux/minimal-bootstrap/tinycc/musl.nix" \
+    "${NIXPKGS}/pkgs/os-specific/linux/minimal-bootstrap/tinycc/mes.nix"; do
+    if [ ! -f "${f}" ]; then
+      echo "ERROR: missing ${f}" >&2
+      exit 1
+    fi
+    if ! replace_string_in_file "${f}" "${TINYCC_NIX_URL}" "${TINYCC_FILE_URL}"; then
+      echo "ERROR: failed to rewrite tinycc url in ${f}" >&2
+      exit 1
+    fi
+    if ! replace_string_in_file "${f}" "${TINYCC_HASH_PINNED}" "${actual}"; then
+      echo "ERROR: failed to pin tinycc hash in ${f}" >&2
+      exit 1
+    fi
+  done
+  nix-store --add-fixed sha256 "${TINYCC_VENDOR}" >/dev/null
+  echo "    ok (ustar + simple gzip for ungz/untar)"
+}
+
+# stdenv bootstrap hardcodes ftpmirror; overlay may not apply there.
+# Do not pin to ftp.gnu.org (RST / truncated 200 through the proxy) — use kernel.org.
+pin_gnu_ftpmirror() {
+  local f n=0
+  echo "==> Pinning GNU sources off ftpmirror.gnu.org -> mirrors.kernel.org/gnu/"
+  shopt -s globstar nullglob
+  for f in \
+    "${NIXPKGS}/pkgs/build-support/fetchurl/mirrors.nix" \
+    "${NIXPKGS}/pkgs/os-specific/linux/minimal-bootstrap/"**/*.nix \
+    "${NIXPKGS}/pkgs/stdenv/"**/*.nix; do
+    [ -f "${f}" ] || continue
+    if replace_string_in_file "${f}" "https://ftpmirror.gnu.org/" "https://mirrors.kernel.org/gnu/"; then
+      n=$((n + 1))
+    fi
+    if replace_string_in_file "${f}" "http://ftpmirror.gnu.org/" "https://mirrors.kernel.org/gnu/"; then
+      n=$((n + 1))
+    fi
+    if replace_string_in_file "${f}" "https://ftp.gnu.org/gnu/" "https://mirrors.kernel.org/gnu/"; then
+      n=$((n + 1))
+    fi
+  done
+  echo "    rewrote ${n} file hits (ok if some files had no GNU URL)"
+}
+
+pin_savannah() {
+  local f n=0
+  echo "==> Pinning Savannah sources -> mirror.csclub.uwaterloo.ca (nyacc etc.)"
+  shopt -s globstar nullglob
+  for f in \
+    "${NIXPKGS}/pkgs/build-support/fetchurl/mirrors.nix" \
+    "${NIXPKGS}/pkgs/os-specific/linux/minimal-bootstrap/"**/*.nix; do
+    [ -f "${f}" ] || continue
+    if replace_string_in_file "${f}" "https://download.savannah.gnu.org/releases/" "https://mirror.csclub.uwaterloo.ca/nongnu/"; then
+      n=$((n + 1))
+    fi
+    if replace_string_in_file "${f}" "https://download.savannah.nongnu.org/releases/" "https://mirror.csclub.uwaterloo.ca/nongnu/"; then
+      n=$((n + 1))
+    fi
+  done
+  echo "    rewrote ${n} savannah URL hits"
+}
+
+# 26.05 source stdenv needs this recursive FOD in the store. It is *source* (git
+# tree), not a Hydra binary. The .drv has no real builder — only a help text.
+pin_stage0_posix() {
+  local dest="/build/vendor/stage0-posix-1.9.1-source"
+  local expected="sha256-UNoyb2teqH26VM7YoOcazyqZ0AlDae045aWc31ZHFdw="
+  local actual srcnix d
+  echo "==> Prefetch: stage0-posix 1.9.1 sources (recursive FOD)"
+  rm -rf "${dest}"
+  git clone --depth 1 --recurse-submodules --shallow-submodules \
+    --branch Release_1.9.1 \
+    https://github.com/oriansj/stage0-posix.git "${dest}"
+  shopt -s globstar nullglob
+  for d in "${dest}/.git" "${dest}"/**/.git; do
+    rm -rf "${d}"
+  done
+  actual=$(nix hash path --sri "${dest}")
+  echo "    sri ${actual}"
+  nix-store --add-fixed --recursive sha256 "${dest}" >/dev/null
+  if [ "${actual}" != "${expected}" ]; then
+    srcnix="${NIXPKGS}/pkgs/os-specific/linux/minimal-bootstrap/stage0-posix/bootstrap-sources.nix"
+    echo "==> Pinning stage0 FOD hash (git tree vs nixpkgs packing)"
+    if ! replace_string_in_file "${srcnix}" "${expected}" "${actual}"; then
+      echo "ERROR: failed to pin stage0 hash in ${srcnix}" >&2
+      exit 1
+    fi
+  fi
+  echo "    ok (in store as ${dest##*/})"
+}
+
+prefetch_fork() {
+  local tools_urls=() busybox_urls=() u path actual
+  local tools_path busybox_path
+
+  echo "==> Prefetch for Nix fork compile (substitute=false)"
+
+  for p in \
+    /build/vendor/busybox-patches/CVE-2022-48174.patch \
+    /build/vendor/busybox-patches/CVE-2023-42366.patch \
+    /build/vendor/busybox-patches/CVE-2023-42363.patch \
+    /build/vendor/busybox-patches/CVE-2023-42364_CVE-2023-42365.patch \
+    /build/vendor/busybox-patches/CVE-2023-39810.patch \
+    /build/vendor/busybox-patches/CVE-2026-26157_CVE-2026-26158.patch \
+    /build/vendor/busybox-patches/CVE-2026-26157_CVE-2026-26158-2.patch \
+    /build/vendor/busybox-patches/apply-cve-2026.sh \
+    /build/vendor/busybox-patches/unsafe_prefix-cve-2026.c \
+    /build/vendor/unzip-patches/CVE-2021-4217.patch; do
+    if [ ! -f "${p}" ]; then
+      echo "ERROR: missing vendored patch ${p}" >&2
+      exit 1
+    fi
+  done
+  echo "==> Vendored dead-URL busybox patches present"
+
+  echo "==> Prefetch: nixpkgs busybox patches (alpine/github mirrors)"
+  try_urls_fetchurl "sha256-yviw1GV+t9tbHbY7YNxEqPi7xEreiXVqbeRyf8c6Awo=" "busybox-p0001" \
+    "https://raw.githubusercontent.com/alpinelinux/aports/ed92963eb55bbc8d938097b9ccb3e221a94653f4/main/busybox/0001-libbb-sockaddr2str-ensure-only-printable-characters-.patch" \
+    >/dev/null || true
+  try_urls_fetchurl "sha256-vl1wPbsHtXY9naajjnTicQ7Uj3N+EQ8pRNnrdsiow+w=" "busybox-p0002" \
+    "https://raw.githubusercontent.com/alpinelinux/aports/ed92963eb55bbc8d938097b9ccb3e221a94653f4/main/busybox/0002-nslookup-sanitize-all-printed-strings-with-printable.patch" \
+    >/dev/null || true
+
+  while IFS= read -r u; do tools_urls+=("${u}"); done < <(mirror_http_https "${BOOTSTRAP_TOOLS_URL}")
+  if tools_path=$(try_urls_fetchurl "${BOOTSTRAP_TOOLS_HASH}" "bootstrap-tools" "${tools_urls[@]}"); then
+    :
+  else
+    echo "WARNING: bootstrap-tools prefetch failed" >&2
+    tools_path=""
+  fi
+
+  echo "==> Prefetch: bootstrap-busybox (executable)"
+  busybox_path=""
+  busybox_urls=()
+  while IFS= read -r u; do busybox_urls+=("${u}"); done < <(mirror_http_https "${BOOTSTRAP_BUSYBOX_URL}")
+  for u in "${busybox_urls[@]}"; do
+    echo "    builtins.fetchurl: ${u}"
+    if busybox_path=$(nix_fetch_executable "${BOOTSTRAP_BUSYBOX_HASH}" "${u}" 2>/dev/null); then
+      echo "    ok -> ${busybox_path}"
+      break
+    fi
+  done
+  if [ -z "${busybox_path:-}" ]; then
+    echo "WARNING: bootstrap busybox prefetch failed (non-fatal for fork compile)" >&2
+  fi
+
+  if [ -n "${tools_path:-}" ] && [ -n "${busybox_path:-}" ]; then
+    append_bootstrap_hashes "${tools_path}" "${busybox_path}"
+  fi
+
+  if [ -f "${BUSYBOX_VENDOR}" ]; then
+    echo "==> Prefetch: busybox tarball (vendor)"
+    actual=$(nix hash file --sri "${BUSYBOX_VENDOR}")
+    if [ "${actual}" != "${BUSYBOX_TARBALL_HASH}" ]; then
+      echo "ERROR: vendored busybox hash mismatch" >&2
+      exit 1
+    fi
+    path=$(nix-store --add-fixed sha256 "${BUSYBOX_VENDOR}")
+    echo "    ok -> ${path}"
+  else
+    try_urls_fetchurl "${BUSYBOX_TARBALL_HASH}" "busybox-1.36.1.tar.bz2" \
+      "https://busybox.net/downloads/busybox-1.36.1.tar.bz2" \
+      "https://www.busybox.net/downloads/busybox-1.36.1.tar.bz2" \
+      "https://deb.debian.org/debian/pool/main/b/busybox/busybox_1.36.1.orig.tar.bz2" \
+      >/dev/null || exit 1
+  fi
+
+  pin_tinycc_snapshot
+  pin_gnu_ftpmirror
+  pin_savannah
+  pin_stage0_posix
+
+  echo "==> Prefetch: zstd (github archive — HTTP/2 flake through Zscaler)"
+  try_urls_fetchurl "sha256-qcd92hQqVBjMT3hyntjcgk29o9wGQsg5Hg7HE5C0UNc=" "zstd-1.5.6" \
+    "https://github.com/facebook/zstd/archive/v1.5.6.tar.gz" \
+    "https://codeload.github.com/facebook/zstd/tar.gz/v1.5.6" \
+    >/dev/null || echo "WARNING: zstd-1.5.6 prefetch failed" >&2
+  try_urls_fetchurl "sha256-tNFWIT9ydfozB8dWcmTMuZLCQmQudTFJIkSr0aG7S44=" "zstd-1.5.7" \
+    "https://github.com/facebook/zstd/archive/v1.5.7.tar.gz" \
+    "https://codeload.github.com/facebook/zstd/tar.gz/v1.5.7" \
+    >/dev/null || echo "WARNING: zstd-1.5.7 prefetch failed" >&2
+
+  echo "==> Fork prefetch done"
+}
+
+prefetch_jo() {
+  local tmp actual dest
+  dest="${JO_OUT}"
+  if [ ! -d /build/vendor ]; then
+    dest="$(cd "$(dirname "$0")" && pwd)/vendor/jo-src"
+  fi
+  if [ -f "${dest}/jo.c" ]; then
+    echo "==> Using vendored jo source at ${dest} (skip GitHub)"
+    return 0
+  fi
+  echo "==> Prefetching jo ${JO_VERSION} source"
+  tmp=$(mktemp)
+  curl -fsSL --cacert "${SSL_CERT_FILE}" -o "${tmp}" "${JO_URL}"
+  actual=$(nix hash file --sri "${tmp}")
+  if [ "${actual}" != "${JO_HASH}" ]; then
+    echo "ERROR: jo hash mismatch" >&2
+    echo "  expected: ${JO_HASH}" >&2
+    echo "  got:      ${actual}" >&2
+    exit 1
+  fi
+  rm -rf "${dest}"
+  mkdir -p "$(dirname "${dest}")"
+  tar -xzf "${tmp}" -C "$(dirname "${dest}")"
+  mv "$(dirname "${dest}")/jo-${JO_VERSION}" "${dest}"
+  rm -f "${tmp}"
+  echo "==> jo source ready at ${dest}"
+}
+
+prefetch_vendor_busybox() {
+  local root out actual
+  root="$(cd "$(dirname "$0")" && pwd)"
+  out="${root}/vendor/busybox-1.36.1.tar.bz2"
+  mkdir -p "${root}/vendor"
+
+  for url in \
+    "https://busybox.net/downloads/busybox-1.36.1.tar.bz2" \
+    "https://deb.debian.org/debian/pool/main/b/busybox/busybox_1.36.1.orig.tar.bz2"; do
+    echo "==> Trying ${url}"
+    if curl -fsSL --retry 5 -o "${out}" "${url}"; then
+      if command -v nix >/dev/null 2>&1; then
+        actual=$(nix hash file --sri "${out}")
+        [ "${actual}" = "${BUSYBOX_TARBALL_HASH}" ] && { echo "==> OK: ${out}"; return 0; }
+        echo "    hash mismatch, next mirror..." >&2
+      else
+        echo "==> Downloaded ${out} (verify with nix hash file --sri)"
+        return 0
+      fi
+    fi
+  done
+  echo "ERROR: could not download busybox-1.36.1.tar.bz2" >&2
+  exit 1
+}
+
+case "${1:-fork}" in
+  fork) prefetch_fork ;;
+  jo) prefetch_jo ;;
+  vendor-busybox) prefetch_vendor_busybox ;;
+  *)
+    echo "Usage: $0 {fork|jo|vendor-busybox}" >&2
+    exit 1
+    ;;
+esac
diff --git a/contrib/attestation/package-builder/restore-symlinks.sh b/contrib/attestation/package-builder/restore-symlinks.sh
new file mode 100755
index 0000000000000000000000000000000000000000..3d00eb1813e169c139505b03ed60c606fd5fbdca
--- /dev/null
+++ b/contrib/attestation/package-builder/restore-symlinks.sh
@@ -0,0 +1,47 @@
+#!/bin/sh
+# Recreate the symlinks that the Windows checkout flattened into text files.
+#
+# git on Windows without core.symlinks stores a symlink as a regular file whose
+# entire content is the link target. The fork is copied in from /mnt/c, so every
+# such link arrives broken:
+#
+#   src/libutil/.version                 -> "../../.version"      (14 bytes)
+#   src/libutil/nix-meson-build-support  -> "../../nix-meson-build-support"
+#
+# The first made Meson read the literal path as the project version:
+#   meson.build:1:0: ERROR: Version file must contain exactly one line of text.
+# The second hides the build helpers every subproject's meson.build reads.
+#
+# This runs inside the container rather than on the host because the directory
+# links cannot be copied over sensibly — src/nix/doc points at the whole manual
+# and src/nix-functional-tests at the whole test tree — and Linux has no
+# restriction on creating symlinks.
+set -eu
+
+ROOT="${1:-/nix-src}"
+
+echo "==> Restoring symlinks flattened by the Windows checkout"
+
+# A placeholder is tiny, holds a relative path, and has no newline at all.
+# Anything whose target does not resolve is left alone.
+find "$ROOT" -type f -size -1024c ! -path "*/.git/*" -print | while IFS= read -r f; do
+  [ "$(wc -l < "$f")" -eq 0 ] || continue
+  # Do not use `grep $'\0'` — GNU grep treats a NUL pattern as "match
+  # every file", which skipped the entire restore and left Meson without
+  # nix-meson-build-support. Binary placeholders are already excluded by
+  # the size + `../*` checks; a stray `cat: * : No such file` warning is
+  # harmless.
+
+  target=$(cat "$f")
+  case "$target" in
+    ../*) ;;
+    *) continue ;;
+  esac
+
+  [ -e "$(dirname "$f")/$target" ] || continue
+
+  ln -sfn "$target" "$f"
+  echo "    ${f#"$ROOT"/} -> $target"
+done
+
+echo "==> Symlink restore done"
diff --git a/contrib/attestation/package-builder/setup-ca-bundle.sh b/contrib/attestation/package-builder/setup-ca-bundle.sh
new file mode 100755
index 0000000000000000000000000000000000000000..e21bad70b33908166c82b447c86b025f9e9a7fbc
--- /dev/null
+++ b/contrib/attestation/package-builder/setup-ca-bundle.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+# Build /etc/nix/ca-bundle.crt for TLS (Git, curl, Nix downloads).
+# Not TEE / Harmonia attestation — those are {hashPart}.attestation.json.
+#
+# Inputs:
+#   CORPORATE_CA_B64  optional base64 of one extra CA (build.sh / Zscaler)
+#   CERTS_DIR         extra .crt files (default /build/certs)
+#   CA_BUNDLE         output path (default /etc/nix/ca-bundle.crt)
+#   SKIP_GITHUB_PROBE set to 1 to skip the GitHub HEAD check
+set -euo pipefail
+
+CERTS_DIR="${CERTS_DIR:-/build/certs}"
+CA_BUNDLE="${CA_BUNDLE:-/etc/nix/ca-bundle.crt}"
+BASE="${NIX_CA_BASE:-/nix/var/nix/profiles/default/etc/ssl/certs/ca-bundle.crt}"
+
+mkdir -p "$(dirname "$CA_BUNDLE")" /build/logs
+
+if [ ! -f "$BASE" ]; then
+  echo "ERROR: Nix CA bundle not found at $BASE" >&2
+  exit 1
+fi
+
+cat "$BASE" > "$CA_BUNDLE"
+
+if [ -n "${CORPORATE_CA_B64:-}" ]; then
+  echo "${CORPORATE_CA_B64}" | base64 -d >> "$CA_BUNDLE"
+fi
+
+if [ -d "$CERTS_DIR" ]; then
+  for f in "$CERTS_DIR"/*; do
+    [ -f "$f" ] || continue
+    case "$(basename "$f")" in README*|.gitkeep) continue ;; esac
+    cat "$f" >> "$CA_BUNDLE"
+  done
+fi
+
+export SSL_CERT_FILE="$CA_BUNDLE" \
+  NIX_SSL_CERT_FILE="$CA_BUNDLE" \
+  GIT_SSL_CAINFO="$CA_BUNDLE" \
+  NIX_GIT_SSL_CAINFO="$CA_BUNDLE"
+
+git config --global http.sslCAInfo "$CA_BUNDLE"
+
+if [ "${SKIP_GITHUB_PROBE:-0}" != "1" ]; then
+  curl -fsSI --cacert "$CA_BUNDLE" https://github.com >/dev/null
+fi
+
+echo "==> CA bundle $CA_BUNDLE ($(wc -c < "$CA_BUNDLE") bytes)"
