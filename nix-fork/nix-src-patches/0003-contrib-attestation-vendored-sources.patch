+#!/usr/bin/env bash
+# Apply CVE-2026-26157 / CVE-2026-26158 on BusyBox after CVE-2023-39810.
+set -euo pipefail
+
+replace_line() {
+  local file="$1" old="$2" new="$3"
+  grep -Fq "$old" "$file" || return 0
+  local old_esc new_esc
+  old_esc=$(printf '%s' "$old" | sed 's/[.[\*^$\/]/\\&/g')
+  new_esc=$(printf '%s' "$new" | sed 's/[&/]/\\&/g')
+  sed -i "s/$old_esc/$new_esc/" "$file"
+}
+
+replace_line archival/libarchive/data_extract_all.c \
+  'dst_name = (char *)strip_unsafe_prefix(dst_name);' \
+  'dst_name = (char *)skip_unsafe_prefix(dst_name);'
+sed -i 's/Strip leading "\/" and up to last "\/..\/" path component/Skip leading "\/" and past last ".." path component/' \
+  archival/libarchive/data_extract_all.c || true
+
+if grep -Fq 'overlapping_strcpy(file_header->name, strip_unsafe_prefix(file_header->name));' \
+     archival/libarchive/get_header_tar.c; then
+  tmp="${TMPDIR:-.}/get_header_tar.c.cve2026"
+  awk '
+    /overlapping_strcpy\(file_header->name, strip_unsafe_prefix\(file_header->name\)\);/ {
+      print "\tstrip_unsafe_prefix(file_header->name);"
+      print "\tif (file_header->link_target && !S_ISLNK(file_header->mode)) {"
+      print "\t\tstrip_unsafe_prefix(file_header->link_target);"
+      print "\t}"
+      skip_todo = 1
+      next
+    }
+    skip_todo && /link_target/ { skip_todo = 0; next }
+    { print }
+  ' archival/libarchive/get_header_tar.c > "$tmp"
+  mv "$tmp" archival/libarchive/get_header_tar.c
+fi
+
+cp /build/vendor/busybox-patches/unsafe_prefix-cve-2026.c archival/libarchive/unsafe_prefix.c
+
+replace_line archival/tar.c \
+  'header_name = strip_unsafe_prefix(fileName);' \
+  'header_name = skip_unsafe_prefix(fileName);'
+
+replace_line archival/unzip.c \
+  'overlapping_strcpy(dst_fn, strip_unsafe_prefix(dst_fn));' \
+  'strip_unsafe_prefix(dst_fn);'
+
+if grep -Fq 'const char *strip_unsafe_prefix(const char *str) FAST_FUNC;' include/bb_archive.h; then
+  sed -i '/const char \*strip_unsafe_prefix(const char \*str) FAST_FUNC;/c\
+const char *skip_unsafe_prefix(const char *str) FAST_FUNC;\
+void strip_unsafe_prefix(char *str) FAST_FUNC;' include/bb_archive.h
+fi
+
+echo "==> CVE-2026-26157/26158 applied without unified diffs"
diff --git a/contrib/attestation/package-builder/vendor/busybox-patches/unsafe_prefix-cve-2026.c b/contrib/attestation/package-builder/vendor/busybox-patches/unsafe_prefix-cve-2026.c
new file mode 100644
index 0000000000000000000000000000000000000000..2b3d41c2bf1ed68994578c4419be878dd89ff21e
--- /dev/null
+++ b/contrib/attestation/package-builder/vendor/busybox-patches/unsafe_prefix-cve-2026.c
@@ -0,0 +1,57 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * Licensed under GPLv2 or later, see file LICENSE in this source tree.
+ */
+#include "libbb.h"
+#include "bb_archive.h"
+
+const char* FAST_FUNC skip_unsafe_prefix(const char *str)
+{
+	const char *cp = str;
+
+	while (1) {
+		const char *cp2;
+
+		if (*cp == '/') {
+			cp++;
+			continue;
+		}
+		/* Open-coded "../" prefix (CVE-2023-39810) plus 1.37 is_prefixed_with. */
+		if (cp[0] == '.' && cp[1] == '.' && cp[2] == '/') {
+			cp += 3;
+			continue;
+		}
+		if (is_prefixed_with(cp, "/../" + 1)) {
+			cp += 3;
+			continue;
+		}
+		cp2 = cp;
+ find_dotdot:
+		cp2 = strstr(cp2, "/..");
+		if (!cp2)
+			break; /* No (more) malicious components */
+
+		cp2 += 3;
+		if (*cp2 != '/') {
+			if (*cp2 == '\0') {
+				/* Trailing "/..": malicious */
+				return cp2;
+			}
+			goto find_dotdot;
+		}
+		cp = cp2 + 1;
+	}
+	if (cp != str) {
+		static smallint warned = 0;
+		if (!warned) {
+			warned = 1;
+			bb_error_msg("archive with leading slash and/or '..' component(s) in filenames will extract with truncated names");
+		}
+	}
+	return cp;
+}
+
+void FAST_FUNC strip_unsafe_prefix(char *str)
+{
+	overlapping_strcpy(str, skip_unsafe_prefix(str));
+}
diff --git a/contrib/attestation/package-builder/vendor/gen-busybox-extra-patches.py b/contrib/attestation/package-builder/vendor/gen-busybox-extra-patches.py
new file mode 100755
index 0000000000000000000000000000000000000000..0a2ff6bad1e7aa666c319a532b97a75216ca1c01
--- /dev/null
+++ b/contrib/attestation/package-builder/vendor/gen-busybox-extra-patches.py
@@ -0,0 +1,135 @@
+#!/usr/bin/env python3
+"""Generate busybox 1.36.1 patches for CVE-2023-42363 and verify alpine 42364 patch."""
+from pathlib import Path
+import subprocess
+import sys
+import urllib.request
+
+ROOT = Path(__file__).resolve().parent.parent
+TARBALL = ROOT / "vendor/busybox-1.36.1.tar.bz2"
+PATCH_DIR = ROOT / "vendor/busybox-patches"
+WORKDIR = Path("/tmp/bb-extra-patches")
+BASE = WORKDIR / "busybox-1.36.1"
+PATCHED = WORKDIR / "patched"
+
+ALPINE_42364_URL = (
+    "https://raw.githubusercontent.com/alpinelinux/aports/"
+    "8a4bf5971168bf48201c05afda7bee0fbb188e13/main/busybox/"
+    "CVE-2023-42364-CVE-2023-42365.patch"
+)
+
+
+def diff_paths(rel: str, out: Path) -> None:
+    proc = subprocess.run(
+        ["diff", "-u", str(BASE / rel), str(PATCHED / rel)],
+        capture_output=True,
+        text=True,
+    )
+    if proc.returncode not in (0, 1):
+        sys.exit(f"diff failed for {rel}")
+    lines = proc.stdout.splitlines(keepends=True)
+    if len(lines) >= 2:
+        lines[0] = f"--- a/{rel}\n"
+        lines[1] = f"+++ b/{rel}\n"
+    header = (
+        "From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001\n"
+        "Subject: [PATCH] CVE-2023-42363 for busybox-1.36.1\n\n"
+    )
+    out.write_text(header + "".join(lines))
+
+
+def apply_42363(text: str) -> str:
+    old1 = (
+        "\t\t\tif (opinfo & OF_STR1) {\n"
+        "\t\t\t\tL.s = getvar_s(L.v);\n"
+        "\t\t\t\tdebug_printf_eval(\"L.s:'%s'\\n\", L.s);\n"
+        "\t\t\t}\n"
+        "\t\t\tif (opinfo & OF_NUM1) {"
+    )
+    new1 = "\t\t\tif (opinfo & OF_NUM1) {"
+    if old1 not in text:
+        sys.exit("CVE-2023-42363: OF_STR1 block not found")
+    text = text.replace(old1, new1, 1)
+
+    old2 = (
+        "\t\t/* NB: Must get string/numeric values of L (done above)\n"
+        "\t\t * _before_ evaluate()'ing R.v: if both L and R are $NNNs,\n"
+        "\t\t * and right one is large, then L.v points to Fields[NNN1],\n"
+        "\t\t * second evaluate() reallocates and moves (!) Fields[],\n"
+        "\t\t * R.v points to Fields[NNN2] but L.v now points to freed mem!\n"
+        "\t\t * (Seen trying to evaluate \"$444 $44444\")\n"
+        "\t\t */"
+    )
+    new2 = (
+        "\t\t/* NB: if both L and R are $NNNs, and right one is large,\n"
+        "\t\t * then at this point L.v may point into Fields[]; evaluate()\n"
+        "\t\t * below may realloc. Get L.s only after R is evaluated.\n"
+        "\t\t * (Seen trying to evaluate \"$444 $44444\")\n"
+        "\t\t */"
+    )
+    if old2 not in text:
+        sys.exit("CVE-2023-42363: comment block not found")
+    text = text.replace(old2, new2, 1)
+
+    old3 = (
+        "\t\t\tif (opinfo & OF_STR2) {\n"
+        "\t\t\t\tR.s = getvar_s(R.v);\n"
+        "\t\t\t\tdebug_printf_eval(\"R.s:'%s'\\n\", R.s);\n"
+        "\t\t\t}\n"
+        "\t\t}\n"
+        "\n"
+        "\t\tdebug_printf_eval(\"switch(0x%x)\\n\", XC(opinfo & OPCLSMASK));"
+    )
+    new3 = (
+        "\t\t\tif (opinfo & OF_STR2) {\n"
+        "\t\t\t\tR.s = getvar_s(R.v);\n"
+        "\t\t\t\tdebug_printf_eval(\"R.s:'%s'\\n\", R.s);\n"
+        "\t\t\t}\n"
+        "\t\t}\n"
+        "\t\t/* Get L.s _after_ R.v is evaluated (CVE-2023-42363). */\n"
+        "\t\tif (opinfo & OF_RES1) {\n"
+        "\t\t\tif (opinfo & OF_STR1) {\n"
+        "\t\t\t\tL.s = getvar_s(L.v);\n"
+        "\t\t\t\tdebug_printf_eval(\"L.s:'%s'\\n\", L.s);\n"
+        "\t\t\t}\n"
+        "\t\t}\n"
+        "\n"
+        "\t\tdebug_printf_eval(\"switch(0x%x)\\n\", XC(opinfo & OPCLSMASK));"
+    )
+    if old3 not in text:
+        sys.exit("CVE-2023-42363: OF_RES2 tail not found")
+    return text.replace(old3, new3, 1)
+
+
+def verify_patch(patch: Path) -> None:
+    verify = WORKDIR / "verify"
+    subprocess.run(["rm", "-rf", str(verify)], check=True)
+    subprocess.run(["cp", "-a", str(BASE), str(verify)], check=True)
+    subprocess.run(["patch", "-p1", "-d", str(verify), "-i", str(patch)], check=True)
+
+
+def main() -> None:
+    if not TARBALL.is_file():
+        sys.exit(f"missing {TARBALL} — run ./prefetch.sh vendor-busybox")
+
+    subprocess.run(["rm", "-rf", str(WORKDIR)], check=True)
+    WORKDIR.mkdir(parents=True)
+    subprocess.run(["tar", "xf", str(TARBALL), "-C", str(WORKDIR)], check=True)
+
+    subprocess.run(["cp", "-a", str(BASE), str(PATCHED)], check=True)
+    awk = PATCHED / "editors/awk.c"
+    awk.write_text(apply_42363(awk.read_text()))
+
+    out42363 = PATCH_DIR / "CVE-2023-42363.patch"
+    diff_paths("editors/awk.c", out42363)
+    verify_patch(out42363)
+
+    out42364 = PATCH_DIR / "CVE-2023-42364_CVE-2023-42365.patch"
+    urllib.request.urlretrieve(ALPINE_42364_URL, out42364)
+    verify_patch(out42364)
+
+    print("OK:", out42363, out42364)
+
+
+if __name__ == "__main__":
+    main()
